@page
@model portaBLe.Pages.UnweightedScoresGraphModel
@{
    ViewData["Title"] = "Unweighted Scores Graph";
}

<h2>@ViewData["Title"]</h2>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>From Date (Y / M / D)</label>
                                <div class="d-flex gap-2">
                                    <input id="minYear" type="number" class="form-control" placeholder="Year" value="@Model.MinYear" style="width:100px;" />
                                    <input id="minMonth" type="number" class="form-control" placeholder="Month" value="@Model.MinMonth" style="width:70px;" />
                                    <input id="minDay" type="number" class="form-control" placeholder="Day" value="@Model.MinDay" style="width:70px;" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="maxPlayerRank">Max Player Rank</label>
                                <input id="maxPlayerRank" type="number" class="form-control" autocomplete="off" value="@Model.MaxPlayerRank" placeholder="0 = unfiltered" />
                                <small class="form-text text-muted">0 = unfiltered</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="minRankedPlayCount">Min Ranked Play Count</label>
                                <input id="minRankedPlayCount" type="number" class="form-control" autocomplete="off" value="@Model.MinRankedPlayCount" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="playerId">Player ID (optional)</label>
                                <input id="playerId" type="text" class="form-control" value="@Model.PlayerId" placeholder="Enter player ID" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="compareDb">Compare with</label>
                                <select id="compareDb" class="form-control">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.CompareDb))">None</option>
                                    @foreach (var other in Model.AvailableDatabases.Where(d => d.FileName != Model.SelectedDatabase))
                                    {
                                        <option value="@other.FileName" selected="@(Model.CompareDb == other.FileName)">@other.Name</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Same filters on another database</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Speed modifiers to include</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input id="modNone" type="checkbox" class="form-check-input" checked="@Model.ModNone" />
                                        <label class="form-check-label" for="modNone">No speed modifier</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input id="modSS" type="checkbox" class="form-check-input" checked="@Model.ModSS" />
                                        <label class="form-check-label" for="modSS">SS</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input id="modFS" type="checkbox" class="form-check-input" checked="@Model.ModFS" />
                                        <label class="form-check-label" for="modFS">FS</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input id="modSFS" type="checkbox" class="form-check-input" checked="@Model.ModSFS" />
                                        <label class="form-check-label" for="modSFS">SFS</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="ySelect">Y-axis</label>
                                <select id="ySelect" class="form-control">
                                    <option value="pp">Unweighted PP</option>
                                    <option value="acc">Score Accuracy</option>
                                    <option value="accPP">Unweighted Acc PP</option>
                                    <option value="passPP">Unweighted Pass PP</option>
                                    <option value="techPP">Unweighted Tech PP</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="xSelect">X-axis</label>
                                <select id="xSelect" class="form-control">
                                    <option value="x">Stars</option>
                                    <option value="passRating">Pass Rating</option>
                                    <option value="techRating">Tech Rating</option>
                                    <option value="accRating">Acc Rating</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="rollingPercent">Rolling average window (% of scores)</label>
                                <input id="rollingPercent" type="number" class="form-control" min="0.05" max="100" step="any" autocomplete="off" value="@((Model.RollingPercent > 0 ? Model.RollingPercent : 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <div class="d-flex align-items-center">
                                    <button id="applyFilters" class="btn btn-primary">Apply Filters</button>
                                    <div id="spinner" class="spinner-border spinner-border-sm ms-2" role="status" style="display:none;"></div>
                                    <small id="status" class="text-muted ms-2"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Balance Metric</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span id="magicLabel" class="mr-2">Rolling average value (0 = perfectly linear):</span>
                        <strong id="magicValue" class="text-primary" style="font-size: 1.2em;">-</strong>
                    </div>
                    <div id="compareMagicRow" style="display:none;">
                        <div class="d-flex align-items-center">
                            <span id="compareMagicLabel" class="mr-2"></span>
                            <strong id="compareMagicValue" style="font-size: 1.2em; color: #e67e22;">-</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Unweighted Scores Scatter Plot</h5>
                    <small class="text-muted">Score distribution with rolling average overlay</small>
                </div>
                <div class="card-body">
                    <div id="myPlot" style="width:100%;height:500px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="diffCard" class="row mt-3" style="display:none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 id="diffTitle" class="mb-0">Difference</h5>
                    <small class="text-muted">The comparison database's rolling average against this one's, at the same x</small>
                </div>
                <div class="card-body">
                    <div id="diffPlot" style="width:100%;height:300px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.plot.ly/plotly-2.29.1.min.js"></script>
    <script>
        // Data: { count, dots: { field: [...] }, bins: { xField: { count, at, yField: [...] } } } (Services/ScoresGraphData)
        let data = null;
        // The "Compare with" database's data (same filters), null when none is picked
        let compareData = null;
        const DB_NAMES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableDatabases.ToDictionary(d => d.FileName, d => d.Name)));
        const MAIN_DB = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedDatabase));
        const WEIGHTED = false;
        const LABEL = WEIGHTED ? 'Weighted' : 'Unweighted';

        function getAxisLabel(field) {
            switch (field) {
                case 'x': return 'Stars';
                case 'pp': return LABEL + ' PP';
                case 'acc': return 'Score Accuracy';
                case 'accPP': return LABEL + ' Acc PP';
                case 'passPP': return LABEL + ' Pass PP';
                case 'techPP': return LABEL + ' Tech PP';
                case 'accRating': return 'Acc Rating';
                case 'passRating': return 'Pass Rating';
                case 'techRating': return 'Tech Rating';
                default: return field;
            }
        }

        function readPercent() {
            const v = parseFloat(document.getElementById('rollingPercent').value);
            return isFinite(v) && v > 0 ? Math.min(v, 100) : 1;
        }

        // Rolling average over every filtered score: the server sends the scores sorted by the x axis in equal-count bins
        // (each with its count, mean x and mean y), so a window of P% of the scores is P% of the bins, summed with running totals
        function computeRollingAverage(bins, yField, percent, maxPoints = 200) {
            if (!bins || !bins.at || bins.at.length === 0) return { xs: [], ys: [] };
            const n = bins.at.length, counts = bins.count, means = bins[yField];
            const half = Math.max(0, Math.floor(percent / 100 * n / 2));
            const c = new Float64Array(n + 1), s = new Float64Array(n + 1);
            for (let i = 0; i < n; i++) {
                c[i + 1] = c[i] + counts[i];
                s[i + 1] = s[i] + counts[i] * means[i];
            }
            const xsFull = new Array(n), ysFull = new Array(n);
            for (let i = 0; i < n; i++) {
                const lo = Math.max(0, i - half), hi = Math.min(n - 1, i + half);
                const count = c[hi + 1] - c[lo];
                xsFull[i] = bins.at[i];
                ysFull[i] = count > 0 ? (s[hi + 1] - s[lo]) / count : null;
            }

            // At most maxPoints points on the line
            if (n <= maxPoints) return { xs: xsFull, ys: ysFull };
            const step = Math.ceil(n / maxPoints);
            const xs = [], ys = [];
            for (let i = 0; i < n; i += step) { xs.push(xsFull[i]); ys.push(ysFull[i]); }
            if (xs[xs.length - 1] !== xsFull[n - 1]) { xs.push(xsFull[n - 1]); ys.push(ysFull[n - 1]); }
            return { xs, ys };
        }

        function linearRegression(xs, ys) {
            const n = xs.length;
            let sx = 0, sy = 0, sxx = 0, sxy = 0;
            let valid = 0;
            for (let i = 0; i < n; i++) {
                const x = xs[i], y = ys[i];
                if (y == null || isNaN(y)) continue;
                sx += x; sy += y; sxx += x * x; sxy += x * y; valid++;
            }
            if (valid === 0) return { m: 0, b: 0 };
            const denom = valid * sxx - sx * sx;
            const m = denom === 0 ? 0 : (valid * sxy - sx * sy) / denom;
            const b = (sy - m * sx) / valid;
            return { m, b };
        }

        function computeMagicValue(xs, ys) {
            // RMSE normalized by y-range; 0 = perfectly linear
            const n = xs.length;
            let maxY = -Infinity, minY = Infinity;
            for (let i = 0; i < n; i++) {
                const y = ys[i]; if (y == null || isNaN(y)) continue; if (y > maxY) maxY = y; if (y < minY) minY = y;
            }
            if (!isFinite(maxY) || !isFinite(minY) || maxY === minY) return 0;
            const lr = linearRegression(xs, ys);
            let sumSq = 0, count = 0;
            for (let i = 0; i < n; i++) {
                const x = xs[i], y = ys[i]; if (y == null || isNaN(y)) continue;
                const pred = lr.m * x + lr.b;
                const diff = y - pred;
                sumSq += diff * diff; count++;
            }
            if (count === 0) return 0;
            return Math.sqrt(sumSq / count) / (maxY - minY);
        }

        // Linear interpolation of a rolling average (xs ascending) at x; null outside its range
        function interpolate(ra, x) {
            const xs = ra.xs, n = xs.length;
            if (n === 0 || x < xs[0] || x > xs[n - 1]) return null;
            let lo = 0, hi = n - 1;
            while (hi - lo > 1) {
                const mid = (lo + hi) >> 1;
                if (xs[mid] <= x) lo = mid; else hi = mid;
            }
            const y0 = ra.ys[lo], y1 = ra.ys[hi];
            if (y0 == null || y1 == null) return null;
            return xs[hi] === xs[lo] ? y0 : y0 + (y1 - y0) * (x - xs[lo]) / (xs[hi] - xs[lo]);
        }

        // The comparison database's rolling average against the main one's, at the main one's x: in % for pp, in
        // accuracy points for acc
        function renderDiff(ra, cra, xField, yField, mainName, compareName) {
            const card = document.getElementById('diffCard');
            if (!cra) {
                card.style.display = 'none';
                return;
            }
            card.style.display = '';
            const isAcc = yField === 'acc';
            const xs = [], ys = [];
            for (let i = 0; i < ra.xs.length; i++) {
                const a = ra.ys[i], b = interpolate(cra, ra.xs[i]);
                if (a == null || b == null) continue;
                if (isAcc) { xs.push(ra.xs[i]); ys.push((b - a) * 100); }
                else if (a > 0) { xs.push(ra.xs[i]); ys.push((b / a - 1) * 100); }
            }
            const unit = isAcc ? 'acc points' : '%';
            document.getElementById('diffTitle').textContent = `${compareName} vs ${mainName}: ${getAxisLabel(yField)} (${isAcc ? 'difference in acc points' : '% difference'})`;
            Plotly.react('diffPlot', [
                { x: xs, y: ys, mode: 'lines', type: 'scatter', line: { color: '#e67e22', width: 2 }, name: 'Difference',
                  hovertemplate: `%{x:.2f}  %{y:+.2f} ${unit}<extra></extra>` },
            ], {
                xaxis: { title: getAxisLabel(xField) },
                yaxis: { title: isAcc ? 'Acc points' : '%', zeroline: true, zerolinecolor: '#888', zerolinewidth: 1.5 },
                margin: { t: 10, b: 50, l: 60, r: 10 },
                showlegend: false,
                hovermode: 'x',
            });
        }

        function renderPlot(d, xField, yField, percent) {
            const cmp = compareData && compareData.count ? compareData : null;
            document.getElementById('compareMagicRow').style.display = 'none';
            if (!d || !d.count) {
                document.getElementById('diffCard').style.display = 'none';
                Plotly.react('myPlot', [], {
                    xaxis: { title: getAxisLabel(xField) },
                    yaxis: { title: getAxisLabel(yField) },
                    margin: { t: 10, b: 50, l: 50, r: 10 },
                    annotations: [{
                        text: d ? 'No scores match these filters' : 'Click "Apply Filters" to load data',
                        xref: 'paper', yref: 'paper', x: 0.5, y: 0.5, showarrow: false,
                        font: { size: 16, color: 'gray' }
                    }]
                });
                document.getElementById('magicValue').textContent = '-';
                return;
            }

            const mainName = DB_NAMES[MAIN_DB] || MAIN_DB;
            const tracePoints = {
                x: d.dots[xField],
                y: d.dots[yField],
                mode: 'markers',
                type: 'scattergl',
                marker: { size: 4, color: 'blue', opacity: 0.2 },
                name: cmp ? `Points: ${mainName}` : 'Points'
            };

            const ra = computeRollingAverage(d.bins[xField], yField, percent);
            const traceAvg = {
                x: ra.xs,
                y: ra.ys,
                mode: 'lines',
                type: 'scattergl',
                line: { color: 'red', width: 2 },
                name: cmp ? `Rolling Avg: ${mainName} (${percent}% of scores)` : `Rolling Avg (${percent}% of scores)`
            };
            const traces = [tracePoints, traceAvg];

            // The comparison database: its dots (hidden at first, click the legend to show them) and rolling average
            let cra = null;
            if (cmp) {
                const compareName = DB_NAMES[cmp.db] || cmp.db;
                cra = computeRollingAverage(cmp.bins[xField], yField, percent);
                traces.splice(1, 0, {
                    x: cmp.dots[xField],
                    y: cmp.dots[yField],
                    mode: 'markers',
                    type: 'scattergl',
                    marker: { size: 4, color: '#e67e22', opacity: 0.2 },
                    name: `Points: ${compareName}`,
                    visible: 'legendonly'
                });
                traces.push({
                    x: cra.xs,
                    y: cra.ys,
                    mode: 'lines',
                    type: 'scattergl',
                    line: { color: '#e67e22', width: 2, dash: 'dash' },
                    name: `Rolling Avg: ${compareName}`
                });
                document.getElementById('compareMagicRow').style.display = '';
                document.getElementById('compareMagicLabel').textContent = `${compareName} (0 = perfectly linear):`;
                document.getElementById('compareMagicValue').textContent = computeMagicValue(cra.xs, cra.ys).toFixed(4);
                renderDiff(ra, cra, xField, yField, mainName, compareName);
            } else {
                renderDiff(ra, null);
            }

            const layout = {
                xaxis: { title: getAxisLabel(xField) },
                yaxis: { title: getAxisLabel(yField) },
                hovermode: 'closest',
                margin: { t: 10, b: cmp ? 90 : 50, l: 50, r: 10 },
                legend: cmp ? { orientation: 'h', y: -0.15 } : undefined,
                // Keeps the zoom and the traces shown / hidden in the legend until the axes change
                uirevision: `${xField}|${yField}`
            };
            Plotly.react('myPlot', traces, layout);

            const magic = computeMagicValue(ra.xs, ra.ys);
            document.getElementById('magicLabel').textContent = `Rolling average for ${getAxisLabel(yField)} vs ${getAxisLabel(xField)}${cmp ? ', ' + mainName : ''} (0 = perfectly linear):`;
            document.getElementById('magicValue').textContent = magic.toFixed(4);
        }

        function redraw() {
            renderPlot(data, document.getElementById('xSelect').value, document.getElementById('ySelect').value, readPercent());
        }

        redraw();
        document.getElementById('xSelect').addEventListener('change', redraw);
        document.getElementById('ySelect').addEventListener('change', redraw);
        document.getElementById('rollingPercent').addEventListener('change', function() {
            // keep it in the URL, so it survives switching databases
            const windowUrl = new URL(window.location.href);
            windowUrl.searchParams.set('rollingPercent', readPercent());
            window.history.replaceState({}, '', windowUrl);
            redraw();
        });

        function showSpinner(show) {
            document.getElementById('spinner').style.display = show ? 'inline-block' : 'none';
        }

        const statusEl = document.getElementById('status');

        function filterValues() {
            const v = {
                minYear: parseInt(document.getElementById('minYear').value) || 0,
                minMonth: parseInt(document.getElementById('minMonth').value) || 0,
                minDay: parseInt(document.getElementById('minDay').value) || 0,
                maxPlayerRank: parseInt(document.getElementById('maxPlayerRank').value) || 0,
                minRankedPlayCount: parseInt(document.getElementById('minRankedPlayCount').value) || 0,
                playerId: (document.getElementById('playerId').value || '').trim(),
                modNone: document.getElementById('modNone').checked,
                modSS: document.getElementById('modSS').checked,
                modFS: document.getElementById('modFS').checked,
                modSFS: document.getElementById('modSFS').checked,
            };
            if (WEIGHTED) v.minWeightPercent = parseFloat(document.getElementById('minWeightPercent').value) || 0;
            return v;
        }

        let retryTimer = null;

        // The data handler's JSON for a database (null: the page's own), with the filters
        async function fetchData(filters, db) {
            const url = new URL(window.location.href);
            url.pathname = url.pathname.replace(/\/$/, '');
            const dbParam = db || url.searchParams.get('db');
            url.search = '';
            url.searchParams.set('handler', 'Data');
            for (const [k, v] of Object.entries(filters)) url.searchParams.set(k, v);
            if (dbParam) url.searchParams.set('db', dbParam);
            const resp = await fetch(url.toString(), { headers: { 'Accept': 'application/json' } });
            if (!resp.ok) return { failed: resp.status };
            return await resp.json();
        }

        async function fetchFiltered() {
            if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
            const filters = filterValues();
            const compareDb = document.getElementById('compareDb').value;

            // Update the browser URL with filter parameters so they persist when switching databases
            const pageUrl = new URL(window.location.href);
            for (const [k, v] of Object.entries(filters)) pageUrl.searchParams.set(k, v);
            pageUrl.searchParams.set('rollingPercent', readPercent());
            if (compareDb) pageUrl.searchParams.set('compareDb', compareDb); else pageUrl.searchParams.delete('compareDb');
            window.history.replaceState({}, '', pageUrl);

            showSpinner(true);
            try {
                const [json, cjson] = await Promise.all([fetchData(filters, null), compareDb ? fetchData(filters, compareDb) : null]);
                if (json.failed) {
                    statusEl.textContent = `Could not load the data (${json.failed}).`;
                    return;
                }
                if (json.count === undefined) {
                    statusEl.textContent = json.error
                        ? `The scores cache failed to build: ${json.error}`
                        : 'Building the scores cache for this database (it can take a minute or two), retrying in 10 s…';
                    if (!json.error) retryTimer = setTimeout(fetchFiltered, 10000);
                    return;
                }
                data = json;
                const shown = json.dots.pp ? json.dots.pp.length : 0;
                let status = `${json.count.toLocaleString()} scores (${shown.toLocaleString()} dots shown, the average uses all of them)`
                    + (json.building ? ' · the database changed, its cache is being rebuilt' : '');

                compareData = null;
                if (cjson) {
                    const compareName = DB_NAMES[compareDb] || compareDb;
                    if (cjson.failed) status += ` · ${compareName}: could not load the data (${cjson.failed})`;
                    else if (cjson.count === undefined) {
                        if (cjson.error) status += ` · ${compareName}: its scores cache failed to build (${cjson.error})`;
                        else {
                            status += ` · ${compareName}: building its scores cache, retrying in 10 s…`;
                            retryTimer = setTimeout(fetchFiltered, 10000);
                        }
                    } else {
                        compareData = { ...cjson, db: compareDb };
                        status += ` · compared with ${compareName}: ${cjson.count.toLocaleString()} scores`;
                    }
                }
                statusEl.textContent = status;
                redraw();
            } catch (e) {
                statusEl.textContent = 'Could not load the data.';
                console.error(e);
            } finally {
                showSpinner(false);
            }
        }

        document.getElementById('applyFilters').addEventListener('click', fetchFiltered);
        // Picking a comparison database loads it straight away when the graph is already shown
        document.getElementById('compareDb').addEventListener('change', function() {
            if (data) fetchFiltered();
        });

        // Load straight away when the URL has filters
        function shouldAutoLoad() {
            const urlParams = new URLSearchParams(window.location.search);
            const filterParams = ['minWeightPercent', 'minYear', 'minMonth', 'minDay', 'maxPlayerRank', 'minRankedPlayCount', 'playerId', 'modNone', 'modSS', 'modFS', 'modSFS', 'compareDb'];
            return filterParams.some(param => urlParams.has(param) && urlParams.get(param) !== '' && urlParams.get(param) !== '0' && urlParams.get(param) !== 'true');
        }

        if (shouldAutoLoad()) {
            fetchFiltered();
        }
    </script>
}
}