@page
@model portaBLe.Pages.DatabaseComparisonModel
@{
    ViewData["Title"] = "Database Comparison";
}

<h2>@ViewData["Title"]</h2>

<div class="container-fluid">
<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Database Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Current Database (Database.db)</h6>
                        <p><strong>Players:</strong> @Model.Stats.CurrentPlayerCount</p>
                        <p><strong>Scores:</strong> @Model.Stats.CurrentScoreCount</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Comparison Database (Comparison.db)</h6>
                        <p><strong>Players:</strong> @Model.Stats.ComparisonPlayerCount</p>
                        <p><strong>Scores:</strong> @Model.Stats.ComparisonScoreCount</p>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h6>Differences</h6>
                        <p><strong>Player Count Difference:</strong> <span class="@(Model.Stats.PlayerCountDiff >= 0 ? "text-success" : "text-danger")">@(Model.Stats.PlayerCountDiff >= 0 ? "+" : "")@Model.Stats.PlayerCountDiff</span></p>
                        <p><strong>Score Count Difference:</strong> <span class="@(Model.Stats.ScoreCountDiff >= 0 ? "text-success" : "text-danger")">@(Model.Stats.ScoreCountDiff >= 0 ? "+" : "")@Model.Stats.ScoreCountDiff</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.StatsComparison != null)
{
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quality Metrics Comparison</h5>
                    <small class="text-muted">Lower values are better (indicates better balancing)</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-center">Current DB</th>
                                    <th class="text-center">Comparison DB</th>
                                    <th class="text-center">Difference</th>
                                    <th class="text-center">Better?</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Total Outliers</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentTotalOutlier</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonTotalOutlier</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.OutlierDiff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.OutlierDiff > 0 ? "+" : "")@Model.StatsComparison.OutlierDiff
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.OutlierDiff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.OutlierDiff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Avg Outlier Percentage</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentAvgOutlierPercentage.ToString("F2")%</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonAvgOutlierPercentage.ToString("F2")%</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.AvgOutlierPercentageDiff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.AvgOutlierPercentageDiff > 0 ? "+" : "")@Model.StatsComparison.AvgOutlierPercentageDiff.ToString("F2")%
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.AvgOutlierPercentageDiff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.AvgOutlierPercentageDiff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Avg Megametric (1.0x)</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentAvgMegametric.ToString("F4")</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonAvgMegametric.ToString("F4")</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.AvgMegametricDiff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.AvgMegametricDiff > 0 ? "+" : "")@Model.StatsComparison.AvgMegametricDiff.ToString("F4")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.AvgMegametricDiff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.AvgMegametricDiff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Avg Megametric 40% (0.4x)</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentAvgMegametric40.ToString("F4")</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonAvgMegametric40.ToString("F4")</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.AvgMegametric40Diff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.AvgMegametric40Diff > 0 ? "+" : "")@Model.StatsComparison.AvgMegametric40Diff.ToString("F4")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.AvgMegametric40Diff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.AvgMegametric40Diff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Avg Megametric 75% (0.75x)</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentAvgMegametric75.ToString("F4")</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonAvgMegametric75.ToString("F4")</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.AvgMegametric75Diff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.AvgMegametric75Diff > 0 ? "+" : "")@Model.StatsComparison.AvgMegametric75Diff.ToString("F4")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.AvgMegametric75Diff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.AvgMegametric75Diff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Avg Megametric 125% (1.25x)</strong></td>
                                    <td class="text-center">@Model.StatsComparison.CurrentAvgMegametric125.ToString("F4")</td>
                                    <td class="text-center">@Model.StatsComparison.ComparisonAvgMegametric125.ToString("F4")</td>
                                    <td class="text-center">
                                        <span class="@(Model.StatsComparison.AvgMegametric125Diff <= 0 ? "text-success" : "text-danger")">
                                            @(Model.StatsComparison.AvgMegametric125Diff > 0 ? "+" : "")@Model.StatsComparison.AvgMegametric125Diff.ToString("F4")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (Model.StatsComparison.AvgMegametric125Diff < 0)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else if (Model.StatsComparison.AvgMegametric125Diff > 0)
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">= Same</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-info mt-3">
                        <strong>Interpretation:</strong> These metrics measure how well the rating system is balanced. Lower values indicate better balance and fewer outliers.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="alert alert-warning">
                <strong>Stats Not Available:</strong> One or both databases are missing Stats data. Please run <code>StatsRefresh.Refresh()</code> on both databases.
            </div>
        </div>
    </div>
}

<div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Player Comparison</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="playerId">Enter Player ID to Compare:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="playerId" placeholder="Enter player ID" />
                            <div class="input-group-append">
                                <button class="btn btn-primary" onclick="loadPlayerComparison()">Compare</button>
                            </div>
                        </div>
                    </div>

                    <div id="playerInfo" style="display:none;" class="mt-3">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0">Current Database</h6>
                                    </div>
                                    <div class="card-body" id="currentPlayerInfo">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header bg-secondary text-white">
                                        <h6 class="mb-0">Comparison Database</h6>
                                    </div>
                                    <div class="card-body" id="comparisonPlayerInfo">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Top 100 Players Comparison</h5>
                    <small class="text-muted">PP changes across top 100 players</small>
                </div>
                <div class="card-body">
                    <canvas id="top100ComparisonChart" style="height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3" id="playerChartsRow" style="display:none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Player Scores Comparison</h5>
                    <small class="text-muted">Top 200 scores weighted PP comparison</small>
                </div>
                <div class="card-body">
                    <canvas id="playerScoresChart" style="height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3" id="componentsRow" style="display:none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">PP Components Comparison</h5>
                    <small class="text-muted">Acc, Tech, and Pass PP changes</small>
                </div>
                <div class="card-body">
                    <canvas id="componentsComparisonChart" style="height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @if (Model.LeaderboardComparisons != null && Model.LeaderboardComparisons.Any())
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Maps - Megametric125 Comparison</h5>
                    <small class="text-muted">Showing maps with Megametric125 &gt; 0.5 in either database</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                        <table class="table table-striped table-hover table-sm">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>
                                            <a class="sort-header @(Model.SortBy == "Name" ? "active" : "") @(Model.SortBy == "Name" && Model.SortDescending ? "desc" : "asc")"
                                               asp-page="/DatabaseComparison"
                                               asp-route-sortBy="Name"
                                               asp-route-sortDescending="@(Model.SortBy == "Name" && Model.SortDescending ? "false" : "true")"
                                               asp-route-currentPage="@Model.CurrentPage">
                                                Map Name
                                            </a>
                                        </th>
                                        <th>Difficulty</th>
                                        <th>Mode</th>
                                        <th class="text-center">
                                            <a class="sort-header @(Model.SortBy == "Current" ? "active" : "") @(Model.SortBy == "Current" && Model.SortDescending ? "desc" : "asc")"
                                               asp-page="/DatabaseComparison"
                                               asp-route-sortBy="Current"
                                               asp-route-sortDescending="@(Model.SortBy == "Current" && Model.SortDescending ? "false" : "true")"
                                               asp-route-currentPage="@Model.CurrentPage">
                                                Current DB
                                            </a>
                                        </th>
                                        <th class="text-center">
                                            <a class="sort-header @(Model.SortBy == "Comparison" ? "active" : "") @(Model.SortBy == "Comparison" && Model.SortDescending ? "desc" : "asc")"
                                               asp-page="/DatabaseComparison"
                                               asp-route-sortBy="Comparison"
                                               asp-route-sortDescending="@(Model.SortBy == "Comparison" && Model.SortDescending ? "false" : "true")"
                                               asp-route-currentPage="@Model.CurrentPage">
                                                Comparison DB
                                            </a>
                                        </th>
                                        <th class="text-center">
                                            <a class="sort-header @(Model.SortBy == "AbsoluteDiff" ? "active" : "") @(Model.SortBy == "AbsoluteDiff" && Model.SortDescending ? "desc" : "asc")"
                                               asp-page="/DatabaseComparison"
                                               asp-route-sortBy="AbsoluteDiff"
                                               asp-route-sortDescending="@(Model.SortBy == "AbsoluteDiff" && Model.SortDescending ? "false" : "true")"
                                               asp-route-currentPage="@Model.CurrentPage">
                                                Absolute Diff
                                            </a>
                                        </th>
                                        <th class="text-center">
                                            <a class="sort-header @(Model.SortBy == "RelativeDiff" ? "active" : "") @(Model.SortBy == "RelativeDiff" && Model.SortDescending ? "desc" : "asc")"
                                               asp-page="/DatabaseComparison"
                                               asp-route-sortBy="RelativeDiff"
                                               asp-route-sortDescending="@(Model.SortBy == "RelativeDiff" && Model.SortDescending ? "false" : "true")"
                                               asp-route-currentPage="@Model.CurrentPage">
                                                Mega125 Diff (%)
                                            </a>
                                        </th>
                                        <th class="text-center">Pass Δ (%)</th>
                                        <th class="text-center">Tech Δ (%)</th>
                                        <th class="text-center">Acc Δ (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comparison in Model.LeaderboardComparisons)
                                    {
                                        var rowClass = Math.Abs(comparison.RelativeDiff) > 10 ? "table-warning" : "";
                                        var scoreCountMismatch = comparison.CurrentScoreCount != comparison.ComparisonScoreCount;
                                        if (scoreCountMismatch)
                                        {
                                            rowClass += " table-danger";
                                        }
                                        <tr class="@rowClass">
                                            <td>
                                                <a asp-page="/Leaderboard" asp-route-id="@comparison.Id">
                                                    @comparison.Name
                                                </a>
                                            </td>
                                            <td>@comparison.DifficultyName</td>
                                            <td>@comparison.ModeName</td>
                                            <td class="text-center">@comparison.CurrentMegametric125.ToString("F4")</td>
                                            <td class="text-center">@comparison.ComparisonMegametric125.ToString("F4")</td>
                                            <td class="text-center">
                                                <span class="@(comparison.AbsoluteDiff <= 0 ? "text-success" : "text-danger")">
                                                    @(comparison.AbsoluteDiff > 0 ? "+" : "")@comparison.AbsoluteDiff.ToString("F4")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="@(comparison.RelativeDiff <= 0 ? "text-success" : "text-danger")">
                                                    @(comparison.RelativeDiff > 0 ? "+" : "")@comparison.RelativeDiff.ToString("F2")%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="@(comparison.PassRatingRelativeDiff <= 0 ? "text-success" : "text-danger")">
                                                    @(comparison.PassRatingRelativeDiff > 0 ? "+" : "")@comparison.PassRatingRelativeDiff.ToString("F1")%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="@(comparison.TechRatingRelativeDiff <= 0 ? "text-success" : "text-danger")">
                                                    @(comparison.TechRatingRelativeDiff > 0 ? "+" : "")@comparison.TechRatingRelativeDiff.ToString("F1")%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="@(comparison.AccRatingRelativeDiff <= 0 ? "text-success" : "text-danger")">
                                                    @(comparison.AccRatingRelativeDiff > 0 ? "+" : "")@comparison.AccRatingRelativeDiff.ToString("F1")%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Leaderboard comparison navigation" class="mt-3">
                                <ul class="pagination justify-content-center">
                                    @if (Model.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               asp-page="/DatabaseComparison" 
                                               asp-route-currentPage="@(Model.CurrentPage - 1)"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDescending="@Model.SortDescending">
                                                Previous
                                            </a>
                                        </li>
                                    }

                                    @{
                                        int firstPageToShow = Model.CurrentPage - 5;
                                        int lastPageToShow = Model.CurrentPage + 4;
                                        if (firstPageToShow < 1)
                                        {
                                            firstPageToShow = 1;
                                            lastPageToShow = 10;
                                        }
                                        if (lastPageToShow > Model.TotalPages)
                                        {
                                            lastPageToShow = Model.TotalPages;
                                            firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
                                        }

                                        for (int i = firstPageToShow; i <= lastPageToShow; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" 
                                                   asp-page="/DatabaseComparison" 
                                                   asp-route-currentPage="@i"
                                                   asp-route-sortBy="@Model.SortBy"
                                                   asp-route-sortDescending="@Model.SortDescending">
                                                    @i
                                                </a>
                                            </li>
                                        }
                                    }

                                    @if (Model.CurrentPage < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               asp-page="/DatabaseComparison" 
                                               asp-route-currentPage="@(Model.CurrentPage + 1)"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDescending="@Model.SortDescending">
                                                Next
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }

                        <div class="alert alert-info mt-3">
                            <strong>Color Legend:</strong>
                            <ul class="mb-0">
                                <li><span class="text-success">Green</span> = Current DB has lower (better) value</li>
                                <li><span class="text-danger">Red</span> = Current DB has higher (worse) value</li>
                                <li><span class="bg-warning px-2">Yellow highlight</span> = Megametric125 relative difference &gt; 10%</li>
                                <li><span class="bg-danger px-2 text-white">Red highlight</span> = Score counts differ between databases (data mismatch!)</li>
                            </ul>
                            <strong class="mt-2 d-block">Rating Differences:</strong>
                            <ul class="mb-0">
                                <li><strong>Mega125 Δ</strong>: Relative change in Megametric125</li>
                                <li><strong>Pass Δ</strong>: Relative change in Pass Rating (lower = easier to pass)</li>
                                <li><strong>Tech Δ</strong>: Relative change in Tech Rating (lower = less technical)</li>
                                <li><strong>Acc Δ</strong>: Relative change in Acc Rating (lower = easier to get high accuracy)</li>
                            </ul>
                            <div class="alert alert-warning mt-2 mb-0">
                                <strong>⚠️ Important:</strong> If scores, weights, rankings, and TopPP are truly identical between databases,
                                but Megametric125 differs, this indicates the <strong>Megametric values were not recalculated</strong> after copying the database.
                                The Comparison.db still contains OLD Megametric125 values from before the score changes.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
    let currentPlayers = @Html.Raw(Model.CurrentJsonData);
    let comparisonPlayers = @Html.Raw(Model.ComparisonJsonData);
    let charts = {};
    let playerData = null;

    // Render top 100 comparison on load
    renderTop100Comparison();

        function renderTop100Comparison() {
            const ctx = document.getElementById('top100ComparisonChart').getContext('2d');
            
            if (charts.top100) {
                charts.top100.destroy();
            }

            // Match players by ID
            const comparisonMap = new Map(comparisonPlayers.map(p => [p.id, p]));
            const labels = [];
            const ppDiffs = [];

            currentPlayers.forEach((current, index) => {
                const comparison = comparisonMap.get(current.id);
                if (comparison) {
                    const playerName = current.name || 'Unknown';
                    labels.push(`#${index + 1} ${playerName.substring(0, 15)}`);
                    ppDiffs.push(current.pp - comparison.pp);
                }
            });

            charts.top100 = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'PP Change',
                        data: ppDiffs,
                        backgroundColor: ppDiffs.map(d => d >= 0 ? 'rgba(75, 192, 192, 0.7)' : 'rgba(255, 99, 132, 0.7)'),
                        borderColor: ppDiffs.map(d => d >= 0 ? 'rgba(75, 192, 192, 1)' : 'rgba(255, 99, 132, 1)'),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            title: {
                                display: true,
                                text: 'PP Difference'
                            }
                        },
                        x: {
                            ticks: {
                                maxRotation: 90,
                                minRotation: 45,
                                font: {
                                    size: 10
                                }
                            }
                        }
                    }
                }
            });
        }

        async function loadPlayerComparison() {
            const playerId = document.getElementById('playerId').value.trim();
            if (!playerId) {
                alert('Please enter a player ID');
                return;
            }

            try {
                const response = await fetch(`/DatabaseComparison?handler=PlayerComparison&playerId=${encodeURIComponent(playerId)}`);
                if (!response.ok) {
                    throw new Error('Failed to load player comparison');
                }

                playerData = await response.json();

                if (playerData.error) {
                    alert(playerData.error);
                    return;
                }

                displayPlayerInfo(playerData);
                renderPlayerScoresComparison(playerData);
                renderComponentsComparison(playerData);

                document.getElementById('playerInfo').style.display = 'block';
                document.getElementById('playerChartsRow').style.display = 'block';
                document.getElementById('componentsRow').style.display = 'block';
            } catch (error) {
                console.error('Error:', error);
                alert('Error loading player comparison');
            }
        }

        function displayPlayerInfo(data) {
            const currentDiv = document.getElementById('currentPlayerInfo');
            const comparisonDiv = document.getElementById('comparisonPlayerInfo');

            if (data.currentPlayer) {
                currentDiv.innerHTML = `
                    <p><strong>Name:</strong> ${data.currentPlayer.name}</p>
                    <p><strong>Rank:</strong> #${data.currentPlayer.rank}</p>
                    <p><strong>Total PP:</strong> ${data.currentPlayer.pp.toFixed(2)}</p>
                    <p><strong>Acc PP:</strong> ${data.currentPlayer.accPp.toFixed(2)}</p>
                    <p><strong>Tech PP:</strong> ${data.currentPlayer.techPp.toFixed(2)}</p>
                    <p><strong>Pass PP:</strong> ${data.currentPlayer.passPp.toFixed(2)}</p>
                `;
            } else {
                currentDiv.innerHTML = '<p class="text-danger">Player not found in current database</p>';
            }

            if (data.comparisonPlayer) {
                const ppDiff = data.currentPlayer ? (data.currentPlayer.pp - data.comparisonPlayer.pp) : 0;
                comparisonDiv.innerHTML = `
                    <p><strong>Name:</strong> ${data.comparisonPlayer.name}</p>
                    <p><strong>Rank:</strong> #${data.comparisonPlayer.rank}</p>
                    <p><strong>Total PP:</strong> ${data.comparisonPlayer.pp.toFixed(2)}</p>
                    <p><strong>Acc PP:</strong> ${data.comparisonPlayer.accPp.toFixed(2)}</p>
                    <p><strong>Tech PP:</strong> ${data.comparisonPlayer.techPp.toFixed(2)}</p>
                    <p><strong>Pass PP:</strong> ${data.comparisonPlayer.passPp.toFixed(2)}</p>
                    ${data.currentPlayer ? `<hr><p><strong>PP Difference:</strong> <span class="${ppDiff >= 0 ? 'text-success' : 'text-danger'}">${ppDiff >= 0 ? '+' : ''}${ppDiff.toFixed(2)}</span></p>` : ''}
                `;
            } else {
                comparisonDiv.innerHTML = '<p class="text-danger">Player not found in comparison database</p>';
            }
        }

        function renderPlayerScoresComparison(data) {
            const ctx = document.getElementById('playerScoresChart').getContext('2d');
            
            if (charts.playerScores) {
                charts.playerScores.destroy();
            }

            const currentScores = data.currentScores.slice(0, 200).map((s, i) => s.pp * Math.pow(0.965, i));
            const comparisonScores = data.comparisonScores.slice(0, 200).map((s, i) => s.pp * Math.pow(0.965, i));
            const labels = Array.from({length: Math.max(currentScores.length, comparisonScores.length)}, (_, i) => i + 1);

            charts.playerScores = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Current DB Weighted PP',
                            data: currentScores,
                            borderColor: 'rgba(54, 162, 235, 1)',
                            backgroundColor: 'rgba(54, 162, 235, 0.1)',
                            borderWidth: 2,
                            pointRadius: 0
                        },
                        {
                            label: 'Comparison DB Weighted PP',
                            data: comparisonScores,
                            borderColor: 'rgba(255, 99, 132, 1)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            borderWidth: 2,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Weighted PP (PP × 0.965^index)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Score Index'
                            }
                        }
                    }
                }
                });
        }

        function renderComponentsComparison(data) {
            const ctx = document.getElementById('componentsComparisonChart').getContext('2d');
            
            if (charts.components) {
                charts.components.destroy();
            }

            const currentAcc = data.currentScores.slice(0, 50).map(s => s.accPP);
            const currentTech = data.currentScores.slice(0, 50).map(s => s.techPP);
            const currentPass = data.currentScores.slice(0, 50).map(s => s.passPP);
            
            const comparisonAcc = data.comparisonScores.slice(0, 50).map(s => s.accPP);
            const comparisonTech = data.comparisonScores.slice(0, 50).map(s => s.techPP);
            const comparisonPass = data.comparisonScores.slice(0, 50).map(s => s.passPP);
            
            const labels = Array.from({length: 50}, (_, i) => `#${i + 1}`);

            charts.components = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Current Acc PP',
                            data: currentAcc,
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 2,
                            pointRadius: 0,
                            borderDash: [5, 5]
                        },
                        {
                            label: 'Comparison Acc PP',
                            data: comparisonAcc,
                            borderColor: 'rgba(54, 162, 235, 0.5)',
                            borderWidth: 2,
                            pointRadius: 0
                        },
                        {
                            label: 'Current Tech PP',
                            data: currentTech,
                            borderColor: 'rgba(255, 206, 86, 1)',
                            borderWidth: 2,
                            pointRadius: 0,
                            borderDash: [5, 5]
                        },
                        {
                            label: 'Comparison Tech PP',
                            data: comparisonTech,
                            borderColor: 'rgba(255, 206, 86, 0.5)',
                            borderWidth: 2,
                            pointRadius: 0
                        },
                        {
                            label: 'Current Pass PP',
                            data: currentPass,
                            borderColor: 'rgba(75, 192, 192, 1)',
                            borderWidth: 2,
                            pointRadius: 0,
                            borderDash: [5, 5]
                        },
                        {
                            label: 'Comparison Pass PP',
                            data: comparisonPass,
                            borderColor: 'rgba(75, 192, 192, 0.5)',
                            borderWidth: 2,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'PP'
                            }
                        }
                    }
                }
            });
        }
    </script>

    <style>
