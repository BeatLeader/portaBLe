@page "/curve-explorer"
@model portaBLe.Pages.CurveExplorerModel
@{
    ViewData["Title"] = "Curve Explorer";
}

<h2>Acc curve explorer</h2>
<p class="ce-note">
    The acc curve a map gets for a given predicted acc, with the settings in use (RatingAPI <code>CurveSettings</code>, the
    same code <code>CurvesRefresh.Regenerate</code> uses). Move the slider to change the predicted acc. Changing the
    settings needs a rebuild of RatingAPI and portaBLe. The corrections are applied on the page only, to try values
    without rebuilding.
</p>

<fieldset class="ce-corr">
    <legend>Corrections on top of the curve</legend>
    <div class="ce-corr-row">
        <label class="ce-check"><input type="checkbox" id="usePerMap" checked onchange="draw()" /> <b>Per-map curve</b></label>
        <span class="ce-hint">CurveSettings.Table by predicted acc; off: the base curve</span>
    </div>
    <div class="ce-corr-row">
        <label class="ce-check"><input type="checkbox" id="useTilt" onchange="draw()" /> <b>Slider tilt</b></label>
        <label>strength <input type="number" id="tiltStrength" step="0.01" oninput="draw()" /></label>
        <label>slider share <input type="number" id="tiltShare" step="1" min="0" oninput="draw()" />%</label>
        <label>range &plusmn; <input type="number" id="tiltRange" step="0.1" min="0" oninput="draw()" />%</label>
        <span class="ce-hint">curve &times; e<sup>strength &times; share &times; (acc &minus; predicted, in %)</sup>, the distance capped at the range
            (CurveSettings.SliderTilt / SliderTiltRange; share = sliders and curved sliders per swing)</span>
    </div>
    <div class="ce-corr-row">
        <label class="ce-check"><input type="checkbox" id="usePower" onchange="draw()" /> <b>Acc curve power</b></label>
        <label>map stars <input type="number" id="powStars" step="0.5" min="0" oninput="draw()" /></label>
        <label>power <input type="number" id="powHigh" step="0.01" oninput="draw()" /></label>
        <label>low star power <input type="number" id="powLow" step="0.01" oninput="draw()" /></label>
        <label>from <input type="number" id="powStart" step="0.5" oninput="draw()" /></label>
        <label>to <input type="number" id="powEnd" step="0.5" oninput="draw()" /> stars</label>
        <span class="ce-hint">curve(96%) &times; (curve / curve(96%))<sup>power</sup>, the power by stars (PpFormula.AccCurvePower,
            LowStarCurvePower / Start / End): <b id="powValue"></b></span>
    </div>
    <div class="ce-corr-row">
        <label class="ce-check"><input type="checkbox" id="useVeryLow" onchange="draw()" /> <b>Very low star power</b></label>
        <label>power <input type="number" id="powVeryLow" step="0.01" oninput="draw()" /></label>
        <label>from <input type="number" id="powVeryStart" step="0.5" oninput="draw()" /></label>
        <label>to <input type="number" id="powVeryEnd" step="0.5" oninput="draw()" /> stars</label>
        <span class="ce-hint">the acc curve power under the low star ramp: this power up to "from", then linearly to the low star
            power at "to" (PpFormula.VeryLowStarCurvePower / Start / End), at the map stars above. Without the acc curve power
            on, it ramps to 1. <b id="veryLowValue"></b></span>
    </div>
    <div class="ce-corr-row">
        <label class="ce-check"><input type="checkbox" id="useNotes" onchange="draw()" /> <b>Low note nerf</b></label>
        <label>map notes <input type="number" id="noteCount" step="1" min="1" oninput="draw()" /></label>
        <label>from <input type="number" id="noteStart" step="1" min="0" oninput="draw()" /> notes</label>
        <label>&times; <input type="number" id="noteRefMult" step="0.01" oninput="draw()" /></label>
        <label>at <input type="number" id="noteRefNotes" step="1" min="1" oninput="draw()" /> notes</label>
        <label>at least &times; <input type="number" id="noteMinMult" step="0.01" oninput="draw()" /></label>
        <span class="ce-hint">curve &times; 1 &minus; (1 &minus; &times;) &times; ln(from / notes) / ln(from / at), under "from" color
            notes (CurveSettings.LowNoteStart / RefMultiplier / RefNotes / MinMultiplier): <b id="noteValue"></b>. It also lowers
            the map's stars, which the map stars above don't follow.</span>
    </div>
    <div class="ce-corr-row">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetCorrections()">Reset to the values in use</button>
        <span class="ce-hint">The base curve is always shown without corrections.</span>
    </div>
</fieldset>

<div class="ce-controls">
    <label for="predSlider">Predicted acc: <b><span id="predValue"></span>%</b></label>
    <input type="range" id="predSlider" min="0" max="0" step="1" value="0" />
    <div class="ce-buttons">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nudge(-1)">&minus; 0.05</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nudge(1)">+ 0.05</button>
        <label class="ce-check"><input type="checkbox" id="autoZoom" checked onchange="draw()" /> zoom around the predicted acc</label>
        <label class="ce-check"><input type="checkbox" id="showRatio" onchange="draw()" /> show the curve as a share of the base curve</label>
    </div>
    <div class="ce-buttons">
        <label class="ce-check">Accuracy from <input type="number" id="rangeFrom" class="ce-range" step="1" min="0" max="100" oninput="setRange(num0('rangeFrom'), num0('rangeTo'), true)" />
            to <input type="number" id="rangeTo" class="ce-range" step="1" min="0" max="100" oninput="setRange(num0('rangeFrom'), num0('rangeTo'), true)" />%</label>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setRange(0, 100)">0-100%</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setRange(60, 100)">60-100%</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setRange(90, 100)">90-100%</button>
        <span class="ce-hint">Mouse wheel on the chart zooms around the cursor, drag pans.</span>
    </div>
    <div id="params" class="ce-params"></div>
</div>

<div class="ce-chart">
    <canvas id="curveChart"></canvas>
</div>

<h5>Acc pp relative to the base curve at the predicted acc</h5>
<table class="table table-sm ce-table">
    <thead>
        <tr><th>Accuracy</th><th>Base curve</th><th>Without corrections</th><th>This curve</th><th>This / base</th><th>Acc pp vs base at predicted</th></tr>
    </thead>
    <tbody id="ppTable"></tbody>
</table>

<h5>Settings table (rows interpolated by predicted acc)</h5>
<table class="table table-sm ce-table">
    <thead>
        <tr><th>Predicted acc</th><th>a</th><th>c</th><th>k</th><th>w</th><th>k2</th><th>p2</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Table)
        {
            <tr>
                <td>@((r.PredictedAcc * 100).ToString("0.00"))%</td>
                <td>@(r.A >= 0.9995 ? "100% (no taper)" : (r.A * 100).ToString("0.00") + "%")</td>
                <td>@r.C.ToString("0.00")</td>
                <td>@r.K.ToString("0.00")</td>
                <td>@r.W.ToString("0.00")</td>
                <td>@r.K2.ToString("0.00")</td>
                <td>@r.P2.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<style>
    .ce-note { font-size: 0.9em; opacity: 0.8; max-width: 900px; }
    .ce-controls { max-width: 900px; margin: 1em 0; }
    .ce-controls input[type=range] { width: 100%; }
    .ce-buttons { display: flex; gap: 0.75em; align-items: center; flex-wrap: wrap; margin-top: 0.4em; }
    .ce-check { font-size: 0.85em; margin: 0; }
    .ce-params { margin-top: 0.6em; font-size: 0.9em; }
    .ce-chart { position: relative; height: 420px; max-width: 900px; cursor: grab; }
    .ce-range { width: 4.5em; }
    .ce-table { max-width: 900px; font-size: 0.85em; }
    .ce-corr { max-width: 900px; margin: 0 0 1em; padding: 0.5em 0.8em; border: 1px solid rgba(128, 128, 128, 0.4); border-radius: 4px; }
    .ce-corr legend { font-size: 0.95em; width: auto; padding: 0 0.3em; margin: 0; float: none; }
    .ce-corr-row { display: flex; gap: 0.75em; align-items: center; flex-wrap: wrap; margin: 0.35em 0; font-size: 0.85em; }
    .ce-corr-row label { margin: 0; }
    .ce-corr-row input[type=number] { width: 5em; }
    .ce-hint { opacity: 0.7; font-size: 0.95em; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const data = @Html.Raw(Model.DataJson);
        const slider = document.getElementById('predSlider');
        slider.max = data.curves.length - 1;
        // Start at 97% predicted acc (or the closest step)
        slider.value = data.curves.reduce((best, c, i) => Math.abs(c.predicted - 97) < Math.abs(data.curves[best].predicted - 97) ? i : best, 0);
        let chart = null;
        const corr = data.corrections;

        // Sampling of Curve.GetCurve (in %): the base table, 0.5% steps from 60% to 95%, 0.05% steps from 95% to 100%
        // (and 2.5% steps under 60%, where the curve is a straight line, for the chart)
        const grid = Array.from(new Set(data.basePoints.map(q => q[0])
            .concat(Array.from({ length: 24 }, (_, i) => +(i * 2.5).toFixed(4)))
            .concat(Array.from({ length: 71 }, (_, i) => +(60 + i * 0.5).toFixed(4)))
            .concat(Array.from({ length: 101 }, (_, i) => +(95 + i * 0.05).toFixed(4)))))
            .sort((a, b) => a - b);

        const fields = {
            tiltStrength: () => corr.sliderTilt, tiltShare: () => 30, tiltRange: () => corr.sliderTiltRange,
            powStars: () => 8, powHigh: () => corr.accCurvePower, powLow: () => corr.lowStarCurvePower,
            powStart: () => corr.lowStarCurveStart, powEnd: () => corr.lowStarCurveEnd,
            powVeryLow: () => corr.veryLowStarCurvePower, powVeryStart: () => corr.veryLowStarCurveStart, powVeryEnd: () => corr.veryLowStarCurveEnd,
            noteCount: () => corr.lowNoteRefNotes, noteStart: () => corr.lowNoteStart, noteRefMult: () => corr.lowNoteRefMultiplier,
            noteRefNotes: () => corr.lowNoteRefNotes, noteMinMult: () => corr.lowNoteMinMultiplier,
        };
        function resetCorrections() {
            for (const [id, def] of Object.entries(fields)) document.getElementById(id).value = +def().toFixed(4);
            draw();
        }
        function num(id) { const v = parseFloat(document.getElementById(id).value); return isNaN(v) ? fields[id]() : v; }
        function checked(id) { return document.getElementById(id).checked; }

        // PpFormula.CurvePowerAt
        function curvePowerAt(stars, high, low, start, end, veryLow, veryStart, veryEnd) {
            if (veryLow !== low && stars < veryEnd) {
                if (stars <= veryStart) return veryLow;
                return veryLow + (low - veryLow) * (stars - veryStart) / (veryEnd - veryStart);
            }
            if (low === high || !(stars < end)) return high;
            if (stars <= start) return low;
            return low + (high - low) * (stars - start) / (end - start);
        }
        // Acc curve power off: 1 (the very low star power then ramps to 1). Very low star power off: no very low part.
        function power() {
            const usePower = checked('usePower');
            const high = usePower ? num('powHigh') : 1, low = usePower ? num('powLow') : 1;
            const veryLow = checked('useVeryLow') ? num('powVeryLow') : low;
            return curvePowerAt(num('powStars'), high, low, num('powStart'), num('powEnd'), veryLow, num('powVeryStart'), num('powVeryEnd'));
        }
        function powerOn() { return checked('usePower') || checked('useVeryLow'); }

        // CurveSettings.LowNoteMultiplier
        function noteMultiplier() {
            const notes = num('noteCount'), start = num('noteStart');
            if (start <= 0 || notes <= 0 || notes >= start) return 1;
            const nerf = (1 - num('noteRefMult')) * Math.log(start / notes) / Math.log(start / num('noteRefNotes'));
            return Math.max(1 - nerf, num('noteMinMult'));
        }

        // The map's curve with the corrections turned on: slider tilt and the low note nerf as in Curve.GetCurve (on its
        // sampled points), then the acc curve power as in PpCalculator.GetPp (PpFormula.AccCurve, pivot at the star accuracy)
        function corrected(cur) {
            const source = checked('usePerMap') ? cur.points : data.basePoints;
            const p = cur.predicted;
            const xs = Array.from(new Set(grid.concat(source.map(q => q[0])))).sort((a, b) => a - b);
            let pts = xs.map(x => [x, interp(source, x)]);
            if (checked('useTilt') && p > 60 && p < 99.95) {
                const tilt = num('tiltStrength') * num('tiltShare') / 100, range = Math.max(num('tiltRange'), 0);
                if (tilt !== 0) pts = pts.map(([x, y]) => [x, y * Math.exp(tilt * Math.min(Math.max(x - p, -range), range))]);
            }
            if (checked('useNotes')) {
                const m = noteMultiplier();
                if (m !== 1) pts = pts.map(([x, y]) => [x, y * m]);
            }
            if (powerOn()) {
                const pow = power(), at96 = interp(pts, corr.starAccuracy);
                if (pow !== 1 && at96 > 0) pts = pts.map(([x, y]) => [x, y > 0 ? at96 * Math.pow(y / at96, pow) : y]);
            }
            return pts;
        }

        function correctionsText(cur) {
            const parts = [];
            if (!checked('usePerMap')) parts.push('base curve (per-map curve off)');
            if (checked('useTilt')) {
                const tilt = num('tiltStrength') * num('tiltShare') / 100, r = Math.max(num('tiltRange'), 0);
                parts.push(cur.predicted < 99.95
                    ? `slider tilt ${fmt(tilt, 4)} per 1% (&times;${fmt(Math.exp(-tilt * r), 3)} at &minus;${fmt(r, 2)}%, &times;${fmt(Math.exp(tilt * r), 3)} at +${fmt(r, 2)}%)`
                    : 'slider tilt: none at 99.95%+ predicted');
            }
            if (checked('useNotes')) parts.push(`low note nerf &times;${fmt(noteMultiplier(), 3)} (${fmt(num('noteCount'), 0)} notes)`);
            if (powerOn()) parts.push(`acc curve power ${fmt(power(), 3)}`);
            return parts.length ? '<br/>Corrections: ' + parts.join(' &middot; ') : '';
        }

        function interp(points, x) {
            if (x <= points[0][0]) return points[0][1];
            for (let i = 1; i < points.length; i++) {
                if (points[i][0] >= x) {
                    const [x0, y0] = points[i - 1], [x1, y1] = points[i];
                    return x1 === x0 ? y1 : y0 + (x - x0) / (x1 - x0) * (y1 - y0);
                }
            }
            return points[points.length - 1][1];
        }

        function fmt(v, d) { return Number(v).toFixed(d); }

        // The chart's accuracy range (%): around the predicted acc while "zoom around the predicted acc" is checked, else
        // the range set by the inputs, the buttons, the mouse wheel (zoom around the cursor) or dragging (pan)
        let range = { from: 60, to: 100 };
        function num0(id) { const v = parseFloat(document.getElementById(id).value); return isNaN(v) ? 0 : v; }
        function setRange(from, to, keepInputs) {
            from = Math.min(Math.max(from, 0), 99.9);
            to = Math.min(Math.max(to, from + 0.1), 100);
            range = { from, to };
            document.getElementById('autoZoom').checked = false;
            if (!keepInputs) syncRangeInputs();
            draw();
        }
        function syncRangeInputs() {
            document.getElementById('rangeFrom').value = +range.from.toFixed(2);
            document.getElementById('rangeTo').value = +range.to.toFixed(2);
        }
        function chartAccAt(clientX) {
            const area = chart.chartArea, rect = chart.canvas.getBoundingClientRect();
            const t = Math.min(Math.max((clientX - rect.left - area.left) / (area.right - area.left), 0), 1);
            return range.from + t * (range.to - range.from);
        }
        const canvas = document.getElementById('curveChart');
        canvas.addEventListener('wheel', ev => {
            if (!chart) return;
            ev.preventDefault();
            const at = chartAccAt(ev.clientX), factor = ev.deltaY > 0 ? 1.25 : 0.8;
            let from = at - (at - range.from) * factor, to = at + (range.to - at) * factor;
            if (to - from > 100) { from = 0; to = 100; }
            if (from < 0) { to -= from; from = 0; }
            if (to > 100) { from -= to - 100; to = 100; }
            if (to - from >= 0.1) setRange(from, to);
        }, { passive: false });
        let drag = null;
        canvas.addEventListener('mousedown', ev => { if (chart) drag = { x: ev.clientX, from: range.from, to: range.to }; });
        window.addEventListener('mouseup', () => drag = null);
        window.addEventListener('mousemove', ev => {
            if (!drag || Math.abs(ev.clientX - drag.x) < 3) return;
            const area = chart.chartArea, width = drag.to - drag.from;
            let shift = -(ev.clientX - drag.x) / (area.right - area.left) * width;
            shift = Math.min(Math.max(shift, -drag.from), 100 - drag.to);
            setRange(drag.from + shift, drag.to + shift);
        });
        function nudge(d) { slider.value = Math.min(Math.max(+slider.value + d, 0), data.curves.length - 1); draw(); }

        function param(name, value, def) {
            const v = fmt(value, 2);
            return Math.abs(value - def) < 1e-9 ? `${name} = ${v}` : `<b>${name} = ${v}</b> (default ${fmt(def, 2)})`;
        }

        function draw() {
            const cur = data.curves[+slider.value];
            const p = cur.predicted;
            document.getElementById('predValue').textContent = fmt(p, 2);
            const d = data.defaults;
            document.getElementById('params').innerHTML =
                (data.enabled ? '' : '<b>Per-map curves are disabled (CurveSettings.Enabled = false).</b> ') +
                (cur.tapered ? `a = ${fmt(cur.a, 2)}%, c = ${fmt(cur.c, 2)}` : 'a = 100% (no taper)') +
                ` &middot; middle (60-95%): ${param('k', cur.k, d.k)}, ${param('w', cur.w, d.w)}` +
                ` &middot; upper (95% to a): ${param('k2', cur.k2, d.k2)}, ${param('p2', cur.p2, d.p2)}` +
                (cur.isDefault ? ' &middot; same as the base curve' : '') +
                correctionsText(cur);
            document.getElementById('powValue').textContent = fmt(power(), 3);
            document.getElementById('veryLowValue').textContent = num('powStars') >= num('powVeryEnd')
                ? `No effect at ${fmt(num('powStars'), 1)} map stars: set them under ${fmt(num('powVeryEnd'), 1)}.` : '';
            document.getElementById('noteValue').textContent = '×' + fmt(noteMultiplier(), 3);

            const corrPoints = corrected(cur);
            const anyCorrection = !checked('usePerMap') || checked('useTilt') || powerOn() || checked('useNotes');

            const ratio = document.getElementById('showRatio').checked;
            if (document.getElementById('autoZoom').checked) { range = { from: Math.max(60, Math.floor(p) - 3), to: 100 }; syncRangeInputs(); }
            const minX = range.from, maxX = range.to;
            const xs = Array.from(new Set(corrPoints.map(q => q[0]).concat(cur.points.map(q => q[0]), [minX, maxX])))
                .filter(x => x >= minX && x <= maxX).sort((a, b) => a - b);
            const value = (pts, x) => { const b = interp(data.basePoints, x); return ratio ? (b > 0 ? interp(pts, x) / b : 1) : interp(pts, x); };
            const thisLine = xs.map(x => ({ x, y: value(corrPoints, x) }));
            const rawLine = anyCorrection ? xs.map(x => ({ x, y: value(cur.points, x) })) : [];
            const baseLine = xs.map(x => ({ x, y: ratio ? 1 : interp(data.basePoints, x) }));
            const markers = [{ x: p, y: value(corrPoints, p), label: 'Predicted acc' }];
            if (checked('usePerMap') && cur.tapered && cur.a < 100) markers.push({ x: cur.a, y: value(corrPoints, cur.a), label: 'a (taper start)' });

            const config = {
                type: 'line',
                data: {
                    datasets: [
                        { label: anyCorrection ? 'Curve with corrections' : 'Curve for this predicted acc', data: thisLine, borderColor: 'rgb(75, 192, 192)', backgroundColor: 'rgba(75, 192, 192, 0.15)', pointRadius: 0, borderWidth: 2, tension: 0 },
                        { label: 'Per-map curve without corrections', data: rawLine, hidden: !anyCorrection, borderColor: 'rgba(75, 192, 192, 0.6)', borderDash: [2, 3], pointRadius: 0, borderWidth: 1, tension: 0 },
                        { label: 'Base curve', data: baseLine, borderColor: 'rgba(160, 160, 160, 0.9)', borderDash: [6, 4], pointRadius: 0, borderWidth: 1, tension: 0 },
                        { type: 'scatter', label: 'Predicted acc / a', data: markers, borderColor: 'rgb(255, 160, 40)', backgroundColor: 'rgb(255, 160, 40)', pointRadius: 5 },
                    ]
                },
                options: {
                    animation: false,
                    maintainAspectRatio: false,
                    scales: {
                        x: { type: 'linear', min: minX, max: maxX, title: { display: true, text: 'Accuracy (%)' } },
                        y: { title: { display: true, text: ratio ? 'Curve / base curve' : 'Curve value (acc pp multiplier)' } }
                    },
                    plugins: {
                        tooltip: { callbacks: { label: ctx => (ctx.raw && ctx.raw.label ? ctx.raw.label + ': ' : ctx.dataset.label + ': ') + fmt(ctx.parsed.x, 2) + '% → ' + fmt(ctx.parsed.y, 3) } }
                    }
                }
            };
            if (chart) { chart.data = config.data; chart.options = config.options; chart.update('none'); }
            else chart = new Chart(document.getElementById('curveChart').getContext('2d'), config);

            // Acc pp table: relative to the base curve's value at the predicted acc (acc pp = curve * acc rating * 34)
            const baseAtPred = interp(data.basePoints, p);
            const rows = [['Predicted', p], ['+0.25', p + 0.25], ['+0.5', p + 0.5], ['+1', p + 1], ['+2', p + 2], ['SSS', 100]]
                .filter(([lbl, x]) => x <= 100.0001 && (lbl === 'SSS' || x < 99.99));
            document.getElementById('ppTable').innerHTML = rows.map(([lbl, x]) => {
                const b = interp(data.basePoints, x), r = interp(cur.points, x), t = interp(corrPoints, x);
                return `<tr><td>${lbl} (${fmt(x, 2)}%)</td><td>${fmt(b, 3)}</td><td>${fmt(r, 3)}</td><td>${fmt(t, 3)}</td><td>${fmt(t / b, 3)}</td><td>${fmt(b / baseAtPred, 2)}x &rarr; ${fmt(t / baseAtPred, 2)}x</td></tr>`;
            }).join('');
        }

        slider.addEventListener('input', draw);
        resetCorrections();
    </script>
}
