@page "/curve-explorer"
@model portaBLe.Pages.CurveExplorerModel
@{
    ViewData["Title"] = "Curve Explorer";
}

<h2>Acc curve explorer</h2>
<p class="ce-note">
    The acc curve a map gets for its predicted acc, with the settings in use (RatingAPI <code>CurveSettings</code>, the same
    code the database rebuilds use; changing them needs a rebuild). The corrections at the bottom are applied on this page
    only, to try values without rebuilding.
</p>

<div class="card mb-3">
    <div class="card-body ce-top">
        <div class="ce-top-row">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="usePerMap" checked onchange="draw()" />
                <label class="form-check-label" for="usePerMap">Per-map curve</label>
            </div>
            <span class="ce-hint">CurveSettings.Table by predicted acc; off: the base curve</span>
        </div>
        <div class="ce-top-row">
            <label class="mb-0" for="yMode">Show</label>
            <select id="yMode" class="form-select form-select-sm ce-select" onchange="draw()">
                <option value="value">Curve value (acc pp multiplier)</option>
                <option value="own">Acc pp vs the acc rating point (predicted + offset)</option>
                <option value="base">Curve / base curve</option>
            </select>
            <span class="ce-sep"></span>
            <label class="mb-0">Accuracy</label>
            <input type="number" id="rangeFrom" class="form-control form-control-sm ce-num" step="1" min="0" max="100" oninput="setRange(num0('rangeFrom'), num0('rangeTo'), true)" />
            <span>to</span>
            <input type="number" id="rangeTo" class="form-control form-control-sm ce-num" step="1" min="0" max="100" oninput="setRange(num0('rangeFrom'), num0('rangeTo'), true)" />
            <span>%</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" id="zoomAround" class="btn btn-outline-secondary" onclick="zoomAround()">Around predicted</button>
                <button type="button" class="btn btn-outline-secondary" onclick="setRange(90, 100)">90-100%</button>
                <button type="button" class="btn btn-outline-secondary" onclick="setRange(60, 100)">60-100%</button>
                <button type="button" class="btn btn-outline-secondary" onclick="setRange(0, 100)">0-100%</button>
            </div>
            <span class="ce-hint">mouse wheel on the chart zooms, drag pans</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="ce-pred mb-2">
            <div class="ce-top-row">
                <label class="ce-big mb-0" for="predInput">Predicted acc</label>
                <input type="number" id="predInput" class="form-control form-control-sm ce-num" step="0.05" />
                <span>%</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nudge(-1)">&minus; 0.05</button>
                <input type="range" id="predSlider" class="form-range ce-slider" min="0" max="0" step="1" value="0" />
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nudge(1)">+ 0.05</button>
            </div>
            <div class="ce-top-row">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="useCompare" onchange="draw()" />
                    <label class="form-check-label" for="useCompare">Compare with predicted acc</label>
                </div>
                <input type="number" id="compareInput" class="form-control form-control-sm ce-num" step="0.05" oninput="document.getElementById('useCompare').checked = true; draw()" />
                <span>%</span>
                <span class="ce-hint">orange dashed line, same corrections</span>
            </div>
        </div>
        <div class="ce-chart"><canvas id="curveChart"></canvas></div>
        <div id="params" class="ce-params"></div>
    </div>
    <div class="col-xl-4">
        <div class="ce-stars mb-2">
            <div class="ce-top-row">
                <label class="ce-big mb-0" for="mapStars">Map stars</label>
                <input type="number" id="mapStars" class="form-control form-control-sm ce-num" step="0.1" min="0" placeholder="set" oninput="draw()" />
                <span id="compareStarsBox" class="ce-top-row">
                    <label class="mb-0" for="compareStars">compared map</label>
                    <input type="number" id="compareStars" class="form-control form-control-sm ce-num" step="0.1" min="0" placeholder="set" oninput="draw()" />
                </span>
            </div>
            <div class="ce-hint">The acc curve power, the very low star power and the mid star top bonus depend on the map's stars:
                they only apply once the stars are set (the stars of the version played, a speed modifier's own).</div>
            <div id="starsWarning" class="ce-warn"></div>
        </div>
        <table class="table table-sm ce-table mb-1">
            <thead id="ppHead"></thead>
            <tbody id="ppTable"></tbody>
        </table>
        <p class="ce-hint">
            <b>&times; base</b>: this curve over the base curve. <b>vs rating point</b>: acc pp relative to a score at the
            point the acc rating reads, the predicted acc + <span id="offsetText"></span>% (without the pass and hit distance
            corrections), so 1x there and a bit under 1x at the predicted acc. It's what the curve's shape pays for going above
            the map's level, comparable between predicted accs.
        </p>
    </div>
</div>

<div class="d-flex align-items-center gap-2 mt-3 mb-2">
    <h5 class="mb-0">Corrections</h5>
    <span class="ce-hint">map-dependent, off by default; switch one on to try it on this curve</span>
    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" onclick="resetCorrections()">Reset values to the ones in use</button>
</div>

<details class="ce-corr" data-switch="useTilt">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="useTilt" onchange="switched(this)" /></span>
        <b>Slider tilt</b> <span class="ce-sum" id="sumTilt"></span>
    </summary>
    <div class="ce-corr-body">
        <label>strength <input type="number" id="tiltStrength" step="0.01" oninput="draw()" /></label>
        <label>slider share <input type="number" id="tiltShare" step="1" min="0" oninput="draw()" />%</label>
        <label>range &plusmn; <input type="number" id="tiltRange" step="0.1" min="0" oninput="draw()" />%</label>
        <div class="ce-hint">curve &times; e<sup>strength &times; share &times; (acc &minus; predicted, in %)</sup>, the distance capped at the
            range (CurveSettings.SliderTilt / SliderTiltRange; share = sliders and curved sliders per swing)</div>
    </div>
</details>

<details class="ce-corr" data-switch="usePower">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="usePower" onchange="switched(this)" /></span>
        <b>Acc curve power</b> <span class="ce-sum" id="sumPower"></span>
    </summary>
    <div class="ce-corr-body">
        <label>power <input type="number" id="powHigh" step="0.01" oninput="draw()" /></label>
        <label>low star power <input type="number" id="powLow" step="0.01" oninput="draw()" /></label>
        <label>from <input type="number" id="powStart" step="0.5" oninput="draw()" /></label>
        <label>to <input type="number" id="powEnd" step="0.5" oninput="draw()" /> stars</label>
        <div class="ce-hint">curve(96%) &times; (curve / curve(96%))<sup>power</sup>, the power by the map stars (PpFormula.AccCurvePower,
            LowStarCurvePower / Start / End)</div>
    </div>
</details>

<details class="ce-corr" data-switch="useVeryLow">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="useVeryLow" onchange="switched(this)" /></span>
        <b>Very low star power</b> <span class="ce-sum" id="sumVeryLow"></span>
    </summary>
    <div class="ce-corr-body">
        <label>power <input type="number" id="powVeryLow" step="0.01" oninput="draw()" /></label>
        <label>from <input type="number" id="powVeryStart" step="0.5" oninput="draw()" /></label>
        <label>to <input type="number" id="powVeryEnd" step="0.5" oninput="draw()" /> stars</label>
        <div class="ce-hint">the acc curve power under the low star ramp: this power up to "from", then linearly to the low star power
            at "to" (PpFormula.VeryLowStarCurvePower / Start / End). Without the acc curve power on, it ramps to 1.</div>
    </div>
</details>

<details class="ce-corr" data-switch="useNotes">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="useNotes" onchange="switched(this)" /></span>
        <b>Low note and length nerf</b> <span class="ce-sum" id="sumNotes"></span>
    </summary>
    <div class="ce-corr-body">
        <div class="ce-corr-line">
            <label>map notes <input type="number" id="noteCount" step="1" min="1" oninput="draw()" /></label>
            <label>from <input type="number" id="noteStart" step="1" min="0" oninput="draw()" /> notes</label>
            <label>&times; <input type="number" id="noteRefMult" step="0.01" oninput="draw()" /></label>
            <label>at <input type="number" id="noteRefNotes" step="1" min="1" oninput="draw()" /> notes</label>
            <label>at least &times; <input type="number" id="noteMinMult" step="0.01" oninput="draw()" /></label>
        </div>
        <div class="ce-corr-line">
            <label>map length <input type="number" id="noteSpan" step="1" min="0" oninput="draw()" /> s</label>
            <label>short from <input type="number" id="shortStart" step="1" min="0" oninput="draw()" /> s</label>
            <label>&times; <input type="number" id="shortRefMult" step="0.01" oninput="draw()" /></label>
            <label>at <input type="number" id="shortRefSpan" step="1" min="1" oninput="draw()" /> s</label>
            <label>at least &times; <input type="number" id="shortMinMult" step="0.01" oninput="draw()" /></label>
        </div>
        <div class="ce-hint">The whole curve &times; the notes' factor 1 &minus; (1 &minus; &times;) &times; ln(from / notes) / ln(from / at)
            &times; the length's factor (same form, in seconds of real time: song time / the speed modifier). Each is 1 at most
            (CurveSettings.LowNoteMultiplier).</div>
    </div>
</details>

<details class="ce-corr" data-switch="useMid">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="useMid" onchange="switched(this)" /></span>
        <b>Mid star top bonus</b> <span class="ce-sum" id="sumMid"></span>
    </summary>
    <div class="ce-corr-body">
        <label>bonus <input type="number" id="midBonus" step="0.5" oninput="draw()" />%</label>
        <label>stars <input type="number" id="midStart" step="0.5" oninput="draw()" /></label>
        <label>full <input type="number" id="midFull" step="0.5" oninput="draw()" /></label>
        <label>to <input type="number" id="midFullEnd" step="0.5" oninput="draw()" /></label>
        <label>end <input type="number" id="midEnd" step="0.5" oninput="draw()" /></label>
        <label>acc from <input type="number" id="midAccStart" step="0.1" oninput="draw()" />%</label>
        <label>full at <input type="number" id="midAccFull" step="0.1" oninput="draw()" />%</label>
        <div class="ce-hint">pp &times; (1 + bonus &times; stars bump &times; acc ramp), both easing in smoothly; the stars bump is full between
            "full" and "to" (PpFormula.MidStarTopBonus). It multiplies the whole pp (pass and tech too); shown here on the acc
            curve. The stars of the version played (a speed modifier's own). Stars don't move: it's 0 at 96%.</div>
    </div>
</details>

<details class="ce-corr" data-switch="useTop">
    <summary>
        <span class="form-check form-switch d-inline-block mb-0"><input class="form-check-input" type="checkbox" id="useTop" onchange="switched(this)" /></span>
        <b>Acc top compression</b> <span class="badge bg-secondary">what-if</span> <span class="ce-sum" id="sumTop"></span>
    </summary>
    <div class="ce-corr-body">
        <label>above <input type="number" id="topKnee" step="0.05" min="0" max="100" oninput="draw()" />%</label>
        <label>slope <input type="number" id="topSlope" step="0.05" min="0" oninput="draw()" /></label>
        <label class="ce-check"><input type="checkbox" id="topRelative" onchange="draw()" /> relative to the predicted acc:</label>
        <label>above predicted + <input type="number" id="topShare" step="0.05" min="0" max="1" oninput="draw()" /> &times; (100% &minus; predicted)</label>
        <div class="ce-hint">curve(knee) + (curve &minus; curve(knee)) &times; slope above the knee, before the acc curve power. Removed from
            PpFormula (the 99%+ curve rows' C does it now).</div>
    </div>
</details>

<h5 class="mt-4">Settings table <small class="text-muted">(rows interpolated by predicted acc; the two around the current one are highlighted)</small></h5>
<table class="table table-sm ce-table ce-settings">
    <thead>
        <tr><th>Predicted acc</th><th>a</th><th>c</th><th>rating c</th><th>k</th><th>w</th><th>k2</th><th>p2</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Table)
        {
            <tr data-pred="@((r.PredictedAcc * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                <td>@((r.PredictedAcc * 100).ToString("0.00"))%</td>
                <td>@(r.A >= 0.9995 ? "100% (no taper)" : (r.A * 100).ToString("0.00") + "%")</td>
                <td>@r.C.ToString("0.00")</td>
                <td>@(r.RatingC is double rc ? rc.ToString("0.00") : "same")</td>
                <td>@r.K.ToString("0.00")</td>
                <td>@r.W.ToString("0.00")</td>
                <td>@r.K2.ToString("0.00")</td>
                <td>@r.P2.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
<p class="ce-hint">a: where the top (the high-pass extension) starts; c: its taper (0 = a straight line, below 0 it keeps
    steepening). rating c: the c the acc rating reads, when it differs (CurveRow.RatingC).</p>

<style>
    .ce-note { font-size: 0.9em; opacity: 0.8; max-width: 1000px; }
    .ce-top { display: flex; flex-direction: column; gap: 0.5em; }
    .ce-top-row { display: flex; gap: 0.6em; align-items: center; flex-wrap: wrap; font-size: 0.9em; }
    .ce-big { font-weight: 600; font-size: 1.05em; }
    .ce-num { width: 6em; display: inline-block; }
    .ce-select { width: auto; display: inline-block; }
    .ce-slider { flex: 1 1 300px; min-width: 200px; }
    .ce-sep { width: 1em; }
    .ce-check { font-size: 0.85em; margin: 0; }
    .ce-params { margin-top: 0.5em; font-size: 0.85em; }
    .ce-chart { position: relative; height: 460px; cursor: grab; }
    .ce-table { font-size: 0.85em; }
    .ce-settings { max-width: 900px; }
    .ce-settings tr.ce-active td { background: rgba(255, 160, 40, 0.18); }
    .ce-corr { border: 1px solid rgba(128, 128, 128, 0.35); border-radius: 4px; margin-bottom: 0.4em; max-width: 1100px; }
    .ce-corr summary { padding: 0.35em 0.7em; cursor: pointer; font-size: 0.9em; }
    .ce-corr[open] summary { border-bottom: 1px solid rgba(128, 128, 128, 0.25); }
    .ce-corr.ce-on { border-color: rgba(75, 192, 192, 0.9); }
    .ce-corr-body { padding: 0.5em 0.8em; display: flex; flex-wrap: wrap; gap: 0.4em 0.9em; align-items: center; font-size: 0.85em; }
    .ce-corr-line { display: flex; flex-wrap: wrap; gap: 0.4em 0.9em; width: 100%; }
    .ce-corr-body label { margin: 0; }
    .ce-corr-body input[type=number] { width: 5em; }
    .ce-corr-body .ce-hint { width: 100%; }
    .ce-sum { opacity: 0.75; font-size: 0.95em; margin-left: 0.4em; }
    .ce-hint { opacity: 0.7; font-size: 0.85em; }
    .ce-pred { display: flex; flex-direction: column; gap: 0.4em; padding: 0.5em 0.7em; border: 1px solid rgba(128, 128, 128, 0.35); border-radius: 4px; }
    .ce-stars { padding: 0.5em 0.7em; border: 1px solid rgba(128, 128, 128, 0.35); border-radius: 4px; }
    .ce-warn { color: #c0392b; font-size: 0.85em; margin-top: 0.3em; }
    .ce-warn:empty { display: none; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const data = @Html.Raw(Model.DataJson);
        const slider = document.getElementById('predSlider');
        const predInput = document.getElementById('predInput');
        const compareInput = document.getElementById('compareInput');
        slider.max = data.curves.length - 1;
        let chart = null;
        const corr = data.corrections;
        document.getElementById('offsetText').textContent = (+corr.accOffset.toFixed(3)).toString();

        // The step closest to a predicted acc (%)
        function indexOf(predicted) {
            return data.curves.reduce((best, c, i) => Math.abs(c.predicted - predicted) < Math.abs(data.curves[best].predicted - predicted) ? i : best, 0);
        }

        // Sampling of Curve.GetCurve (in %): the base table, 0.5% steps from 60% to 95%, 0.05% steps from 95% to 100%
        // (and 2.5% steps under 60%, where the curve is a straight line, for the chart)
        const grid = Array.from(new Set(data.basePoints.map(q => q[0])
            .concat(Array.from({ length: 24 }, (_, i) => +(i * 2.5).toFixed(4)))
            .concat(Array.from({ length: 71 }, (_, i) => +(60 + i * 0.5).toFixed(4)))
            .concat(Array.from({ length: 101 }, (_, i) => +(95 + i * 0.05).toFixed(4)))))
            .sort((a, b) => a - b);

        const fields = {
            tiltStrength: () => corr.sliderTilt, tiltShare: () => 30, tiltRange: () => corr.sliderTiltRange,
            topKnee: () => corr.accTopKnee, topSlope: () => corr.accTopSlope, topShare: () => 0.4,
            powHigh: () => corr.accCurvePower, powLow: () => corr.lowStarCurvePower,
            powStart: () => corr.lowStarCurveStart, powEnd: () => corr.lowStarCurveEnd,
            powVeryLow: () => corr.veryLowStarCurvePower, powVeryStart: () => corr.veryLowStarCurveStart, powVeryEnd: () => corr.veryLowStarCurveEnd,
            noteCount: () => corr.lowNoteRefNotes, noteStart: () => corr.lowNoteStart, noteRefMult: () => corr.lowNoteRefMultiplier,
            noteRefNotes: () => corr.lowNoteRefNotes, noteMinMult: () => corr.lowNoteMinMultiplier,
            noteSpan: () => corr.shortRefSpan, shortStart: () => corr.shortStart, shortRefMult: () => corr.shortRefMultiplier,
            shortRefSpan: () => corr.shortRefSpan, shortMinMult: () => corr.shortMinMultiplier,
            midBonus: () => corr.midStarTopBonus, midStart: () => corr.midStarTopStart, midFull: () => corr.midStarTopFull,
            midFullEnd: () => corr.midStarTopFullEnd, midEnd: () => corr.midStarTopEnd,
            midAccStart: () => corr.midStarTopAccStart, midAccFull: () => corr.midStarTopAccFull,
        };
        function resetCorrections() {
            for (const [id, def] of Object.entries(fields)) document.getElementById(id).value = +def().toFixed(4);
            draw();
        }
        function num(id) { const v = parseFloat(document.getElementById(id).value); return isNaN(v) ? fields[id]() : v; }
        // The map stars the star-based corrections use: the main curve's field, or the compared curve's. NaN: not set
        // (those corrections then don't apply)
        let starsField = 'mapStars';
        function stars() { return parseFloat(document.getElementById(starsField).value); }
        function starsSet() { return !isNaN(stars()); }
        function checked(id) { return document.getElementById(id).checked; }

        // A correction switched on opens its panel (to see its values); its panel is outlined while it's on
        function switched(input) {
            const box = input.closest('details');
            if (input.checked) box.open = true;
            draw();
        }
        // Clicking the switch shouldn't also open / close the panel
        document.querySelectorAll('.ce-corr summary input').forEach(i => i.addEventListener('click', ev => ev.stopPropagation()));

        // PpFormula.CurvePowerAt
        function curvePowerAt(stars, high, low, start, end, veryLow, veryStart, veryEnd) {
            if (veryLow !== low && stars < veryEnd) {
                if (stars <= veryStart) return veryLow;
                return veryLow + (low - veryLow) * (stars - veryStart) / (veryEnd - veryStart);
            }
            if (low === high || !(stars < end)) return high;
            if (stars <= start) return low;
            return low + (high - low) * (stars - start) / (end - start);
        }
        // Acc curve power off: 1 (the very low star power then ramps to 1). Very low star power off: no very low part.
        function power() {
            const usePower = checked('usePower');
            const high = usePower ? num('powHigh') : 1, low = usePower ? num('powLow') : 1;
            const veryLow = checked('useVeryLow') ? num('powVeryLow') : low;
            if (!starsSet()) return 1;
            return curvePowerAt(stars(), high, low, num('powStart'), num('powEnd'), veryLow, num('powVeryStart'), num('powVeryEnd'));
        }
        function powerOn() { return (checked('usePower') || checked('useVeryLow')) && starsSet(); }

        // CurveSettings.LowNoteFactor x ShortFactor (LowNoteMultiplier)
        function noteFactor() {
            const notes = num('noteCount'), start = num('noteStart'), at = num('noteRefNotes');
            if (start <= 0 || notes <= 0 || notes >= start || at >= start) return 1;
            const nerf = (1 - num('noteRefMult')) * Math.log(start / notes) / Math.log(start / at);
            return Math.min(Math.max(1 - nerf, num('noteMinMult')), 1);
        }
        function shortFactor() {
            const span = num('noteSpan'), start = num('shortStart'), at = num('shortRefSpan');
            if (start <= 0 || span <= 0 || span >= start || at >= start) return 1;
            const nerf = (1 - num('shortRefMult')) * Math.log(start / span) / Math.log(start / at);
            return Math.min(Math.max(1 - nerf, num('shortMinMult')), 1);
        }
        function noteMultiplier() { return noteFactor() * shortFactor(); }

        // PpFormula.MidStarTopMultiplier (accuracy in %)
        function ease(t) { t = Math.min(Math.max(t, 0), 1); return t * t * (3 - 2 * t); }
        function midBump() {
            const s = stars(), start = num('midStart'), full = num('midFull'), fullEnd = num('midFullEnd'), end = num('midEnd');
            if (!(s > start && s < end)) return 0;
            return s < full ? ease((s - start) / (full - start)) : s > fullEnd ? ease((end - s) / (end - fullEnd)) : 1;
        }
        function midMultiplier(acc) {
            const from = num('midAccStart'), to = num('midAccFull');
            if (!(acc > from)) return 1;
            return 1 + num('midBonus') / 100 * midBump() * ease((acc - from) / (to - from));
        }

        // The what-if acc top compression's knee (%): fixed, or the predicted acc + share x what's left to 100%
        function topKnee(predicted) {
            return checked('topRelative') ? predicted + num('topShare') * (100 - predicted) : num('topKnee');
        }

        // The map's curve with the corrections turned on: slider tilt and the low note nerf as in Curve.GetCurve (on its
        // sampled points), then the acc curve power as in PpCalculator.GetPp (PpFormula.AccCurve, pivot at the star accuracy),
        // then the mid star top bonus (a multiplier of the score's pp)
        function corrected(cur, field = 'mapStars') {
            starsField = field;
            const source = checked('usePerMap') ? cur.points : data.basePoints;
            const p = cur.predicted;
            // (the top compression's knee too, where the curve bends)
            const knee = checked('useTop') ? [+topKnee(p).toFixed(4)] : [];
            const xs = Array.from(new Set(grid.concat(source.map(q => q[0]), knee))).sort((a, b) => a - b);
            let pts = xs.map(x => [x, interp(source, x)]);
            if (checked('useTilt') && p > 60 && p < 99.95) {
                const tilt = num('tiltStrength') * num('tiltShare') / 100, range = Math.max(num('tiltRange'), 0);
                if (tilt !== 0) pts = pts.map(([x, y]) => [x, y * Math.exp(tilt * Math.min(Math.max(x - p, -range), range))]);
            }
            if (checked('useNotes')) {
                // CurveSettings.LowNoteMultiplier: the whole curve
                const m = noteMultiplier();
                pts = pts.map(([x, y]) => [x, y * m]);
            }
            // The acc curve power's pivot is the curve at the star accuracy without the top compression (PpCalculator.GetPp)
            const at96 = interp(pts, corr.starAccuracy);
            if (checked('useTop')) {
                // Acc top compression (what-if): the curve above the knee rises slope as fast, from its value at the knee
                const at = topKnee(p), slope = num('topSlope'), atKnee = interp(pts, at);
                if (slope !== 1) pts = pts.map(([x, y]) => [x, x > at && y > atKnee ? atKnee + (y - atKnee) * slope : y]);
            }
            if (powerOn()) {
                const pow = power();
                if (pow !== 1 && at96 > 0) pts = pts.map(([x, y]) => [x, y > 0 ? at96 * Math.pow(y / at96, pow) : y]);
            }
            if (checked('useMid') && starsSet()) pts = pts.map(([x, y]) => [x, y * midMultiplier(x)]);
            starsField = 'mapStars';
            return pts;
        }

        // One-line effect of each correction, in its panel's header
        function summaries(cur) {
            const on = id => checked(id);
            const tilt = num('tiltStrength') * num('tiltShare') / 100, r = Math.max(num('tiltRange'), 0);
            const set = (id, text) => document.getElementById(id).innerHTML = text;
            set('sumTilt', cur.predicted < 99.95
                ? `${fmt(tilt, 4)} per 1% at ${fmt(num('tiltShare'), 0)}% sliders: &times;${fmt(Math.exp(-tilt * r), 3)} at &minus;${fmt(r, 2)}%, &times;${fmt(Math.exp(tilt * r), 3)} at +${fmt(r, 2)}%`
                : 'none at 99.95%+ predicted');
            const noStars = 'set the map stars (next to the chart) to apply it';
            set('sumPower', !starsSet() ? noStars : `power ${fmt(power(), 3)} at ${fmt(stars(), 1)} stars` + (on('usePower') ? '' : ' (off: 1)'));
            set('sumVeryLow', !starsSet() ? noStars : stars() >= num('powVeryEnd')
                ? `no effect at ${fmt(stars(), 1)} stars (under ${fmt(num('powVeryEnd'), 1)} only)`
                : `power ${fmt(power(), 3)} at ${fmt(stars(), 1)} stars`);
            set('sumNotes', `&times;${fmt(noteMultiplier(), 3)} (${fmt(num('noteCount'), 0)} notes &times;${fmt(noteFactor(), 3)}, ${fmt(num('noteSpan'), 0)} s &times;${fmt(shortFactor(), 3)})`);
            const bump = starsSet() ? midBump() : 0;
            set('sumMid', !starsSet() ? noStars : bump > 0
                ? `+${fmt(num('midBonus') * bump, 2)}% at ${fmt(stars(), 1)} stars from ${fmt(num('midAccFull'), 1)}% acc (eases in from ${fmt(num('midAccStart'), 1)}%)`
                : `none at ${fmt(stars(), 1)} stars (${fmt(num('midStart'), 1)} to ${fmt(num('midEnd'), 1)} only)`);
            set('sumTop', `&times;${fmt(num('topSlope'), 2)} above ${fmt(topKnee(cur.predicted), 2)}%`);
            document.querySelectorAll('.ce-corr').forEach(box => box.classList.toggle('ce-on', checked(box.dataset.switch)));
        }

        function interp(points, x) {
            if (x <= points[0][0]) return points[0][1];
            for (let i = 1; i < points.length; i++) {
                if (points[i][0] >= x) {
                    const [x0, y0] = points[i - 1], [x1, y1] = points[i];
                    return x1 === x0 ? y1 : y0 + (x - x0) / (x1 - x0) * (y1 - y0);
                }
            }
            return points[points.length - 1][1];
        }

        function fmt(v, d) { return Number(v).toFixed(d); }

        // The chart's accuracy range (%): around the predicted acc while "Around predicted" is on, else the range set by
        // the inputs, the buttons, the mouse wheel (zoom around the cursor) or dragging (pan)
        let range = { from: 60, to: 100 };
        let autoZoom = true;
        function num0(id) { const v = parseFloat(document.getElementById(id).value); return isNaN(v) ? 0 : v; }
        function setRange(from, to, keepInputs) {
            from = Math.min(Math.max(from, 0), 99.9);
            to = Math.min(Math.max(to, from + 0.1), 100);
            range = { from, to };
            autoZoom = false;
            if (!keepInputs) syncRangeInputs();
            draw();
        }
        function zoomAround() { autoZoom = true; draw(); }
        function syncRangeInputs() {
            document.getElementById('rangeFrom').value = +range.from.toFixed(2);
            document.getElementById('rangeTo').value = +range.to.toFixed(2);
        }
        function chartAccAt(clientX) {
            const area = chart.chartArea, rect = chart.canvas.getBoundingClientRect();
            const t = Math.min(Math.max((clientX - rect.left - area.left) / (area.right - area.left), 0), 1);
            return range.from + t * (range.to - range.from);
        }
        const canvas = document.getElementById('curveChart');
        canvas.addEventListener('wheel', ev => {
            if (!chart) return;
            ev.preventDefault();
            const at = chartAccAt(ev.clientX), factor = ev.deltaY > 0 ? 1.25 : 0.8;
            let from = at - (at - range.from) * factor, to = at + (range.to - at) * factor;
            if (to - from > 100) { from = 0; to = 100; }
            if (from < 0) { to -= from; from = 0; }
            if (to > 100) { from -= to - 100; to = 100; }
            if (to - from >= 0.1) setRange(from, to);
        }, { passive: false });
        let drag = null;
        canvas.addEventListener('mousedown', ev => { if (chart) drag = { x: ev.clientX, from: range.from, to: range.to }; });
        window.addEventListener('mouseup', () => drag = null);
        window.addEventListener('mousemove', ev => {
            if (!drag || Math.abs(ev.clientX - drag.x) < 3) return;
            const area = chart.chartArea, width = drag.to - drag.from;
            let shift = -(ev.clientX - drag.x) / (area.right - area.left) * width;
            shift = Math.min(Math.max(shift, -drag.from), 100 - drag.to);
            setRange(drag.from + shift, drag.to + shift);
        });

        function nudge(d) { slider.value = Math.min(Math.max(+slider.value + d, 0), data.curves.length - 1); predInput.value = fmt(data.curves[+slider.value].predicted, 2); draw(); }
        slider.addEventListener('input', () => { predInput.value = fmt(data.curves[+slider.value].predicted, 2); draw(); });
        predInput.addEventListener('change', () => {
            const v = parseFloat(predInput.value);
            if (!isNaN(v)) slider.value = indexOf(v);
            predInput.value = fmt(data.curves[+slider.value].predicted, 2);
            draw();
        });

        function param(name, value, def) {
            const v = fmt(value, 2);
            return Math.abs(value - def) < 1e-9 ? `${name} = ${v}` : `<b>${name} = ${v}</b> (default ${fmt(def, 2)})`;
        }

        // The predicted acc, the comparison and the stars in the URL (?pred=98.5&compare=98&stars=5), so a view can be shared
        function saveUrl(cur, cmp) {
            const url = new URL(window.location.href);
            url.searchParams.set('pred', fmt(cur.predicted, 2));
            if (cmp) url.searchParams.set('compare', fmt(cmp.predicted, 2)); else url.searchParams.delete('compare');
            for (const [key, id] of [['stars', 'mapStars'], ['compareStars', 'compareStars']]) {
                const v = parseFloat(document.getElementById(id).value);
                if (!isNaN(v)) url.searchParams.set(key, v); else url.searchParams.delete(key);
            }
            window.history.replaceState({}, '', url);
        }

        function draw() {
            const cur = data.curves[+slider.value];
            const p = cur.predicted;
            const cmpOn = checked('useCompare') && !isNaN(parseFloat(compareInput.value));
            const cmp = cmpOn ? data.curves[indexOf(parseFloat(compareInput.value))] : null;
            saveUrl(cur, cmp);
            const d = data.defaults;
            document.getElementById('params').innerHTML =
                (data.enabled ? '' : '<b>Per-map curves are disabled (CurveSettings.Enabled = false).</b> ') +
                `<b>${fmt(p, 2)}%:</b> ` +
                (cur.tapered ? `a = ${fmt(cur.a, 2)}%, c = ${fmt(cur.c, 2)}` + (Math.abs(cur.ratingC - cur.c) > 1e-9 ? ` (rating c = ${fmt(cur.ratingC, 2)})` : '') : 'a = 100% (no taper)') +
                ` &middot; middle (60-95%): ${param('k', cur.k, d.k)}, ${param('w', cur.w, d.w)}` +
                ` &middot; upper (95% to a): ${param('k2', cur.k2, d.k2)}, ${param('p2', cur.p2, d.p2)}` +
                (cur.isDefault ? ' &middot; same as the base curve' : '');
            summaries(cur);

            // The two settings rows around the predicted acc
            const rows = Array.from(document.querySelectorAll('.ce-settings tbody tr'));
            const preds = rows.map(r => parseFloat(r.dataset.pred));
            let hi = preds.findIndex(v => v >= p - 1e-9);
            const active = hi < 0 ? [preds.length - 1] : hi === 0 || Math.abs(preds[hi] - p) < 1e-9 ? [hi] : [hi - 1, hi];
            rows.forEach((r, i) => r.classList.toggle('ce-active', active.includes(i)));

            const curPoints = corrected(cur);
            const cmpPoints = cmp ? corrected(cmp, 'compareStars') : null;
            document.getElementById('compareStarsBox').style.display = cmp ? '' : 'none';
            // The star-based corrections switched on while a curve's stars aren't set
            const starBased = ['usePower', 'useVeryLow', 'useMid'].filter(checked);
            const missing = [];
            for (const [id, label] of cmp ? [['mapStars', 'this map'], ['compareStars', 'the compared map']] : [['mapStars', 'this map']]) {
                const empty = isNaN(parseFloat(document.getElementById(id).value));
                document.getElementById(id).classList.toggle('is-invalid', empty && starBased.length > 0);
                if (empty && starBased.length) missing.push(label);
            }
            document.getElementById('starsWarning').textContent = missing.length
                ? `Set the stars of ${missing.join(' and ')}: the acc curve power, very low star power and mid star top bonus don't apply without them.` : '';
            const anyCorrection = !checked('usePerMap') || ['useTilt', 'useTop', 'useNotes'].some(checked) || (starsSet() && starBased.length > 0);

            const mode = document.getElementById('yMode').value;
            if (autoZoom) { range = { from: Math.max(60, Math.floor(Math.min(p, cmp ? cmp.predicted : p)) - 3), to: 100 }; syncRangeInputs(); }
            document.getElementById('zoomAround').classList.toggle('active', autoZoom);
            const minX = range.from, maxX = range.to;
            const xs = Array.from(new Set(curPoints.map(q => q[0]).concat(cur.points.map(q => q[0]), cmpPoints ? cmpPoints.map(q => q[0]) : [], [minX, maxX])))
                .filter(x => x >= minX && x <= maxX).sort((a, b) => a - b);
            // own: relative to the acc rating's reading of this curve (a score at the predicted acc + ACC_OFFSET)
            const value = (pts, c, x) => {
                const y = interp(pts, x);
                if (mode === 'base') { const b = interp(data.basePoints, x); return b > 0 ? y / b : 1; }
                if (mode === 'own') return c.ratingRef > 0 ? y / c.ratingRef : y;
                return y;
            };
            const line = (pts, c) => xs.map(x => ({ x, y: value(pts, c, x) }));
            const datasets = [
                { label: `${fmt(p, 2)}% predicted` + (anyCorrection ? ' (with corrections)' : ''), data: line(curPoints, cur), borderColor: 'rgb(75, 192, 192)', backgroundColor: 'rgba(75, 192, 192, 0.15)', pointRadius: 0, borderWidth: 2, tension: 0 },
            ];
            if (anyCorrection) datasets.push({ label: `${fmt(p, 2)}% without corrections`, data: line(cur.points, cur), borderColor: 'rgba(75, 192, 192, 0.6)', borderDash: [2, 3], pointRadius: 0, borderWidth: 1, tension: 0 });
            if (cmp) datasets.push({ label: `${fmt(cmp.predicted, 2)}% predicted`, data: line(cmpPoints, cmp), borderColor: 'rgb(230, 126, 34)', borderDash: [7, 4], pointRadius: 0, borderWidth: 2, tension: 0 });
            if (mode !== 'own') datasets.push({ label: 'Base curve', data: xs.map(x => ({ x, y: mode === 'base' ? 1 : interp(data.basePoints, x) })), borderColor: 'rgba(160, 160, 160, 0.9)', borderDash: [6, 4], pointRadius: 0, borderWidth: 1, tension: 0 });
            const markers = [{ x: p, y: value(curPoints, cur, p), label: 'Predicted acc' }];
            if (checked('usePerMap') && cur.tapered && cur.a < 100) markers.push({ x: cur.a, y: value(curPoints, cur, cur.a), label: 'a (top starts)' });
            if (cmp) markers.push({ x: cmp.predicted, y: value(cmpPoints, cmp, cmp.predicted), label: 'Compared predicted acc' });
            datasets.push({ type: 'scatter', label: 'Predicted acc / a', data: markers, borderColor: 'rgb(255, 160, 40)', backgroundColor: 'rgb(255, 160, 40)', pointRadius: 5 });

            const yTitle = mode === 'base' ? 'Curve / base curve' : mode === 'own' ? 'Acc pp vs the acc rating point (1 = a score there)' : 'Curve value (acc pp multiplier)';
            const config = {
                type: 'line',
                data: { datasets },
                options: {
                    animation: false,
                    maintainAspectRatio: false,
                    scales: {
                        x: { type: 'linear', min: minX, max: maxX, title: { display: true, text: 'Accuracy (%)' } },
                        y: { title: { display: true, text: yTitle } }
                    },
                    plugins: {
                        tooltip: { callbacks: { label: ctx => (ctx.raw && ctx.raw.label ? ctx.raw.label + ': ' : ctx.dataset.label + ': ') + fmt(ctx.parsed.x, 2) + '% → ' + fmt(ctx.parsed.y, 3) } }
                    }
                }
            };
            if (chart) { chart.data = config.data; chart.options = config.options; chart.update('none'); }
            else chart = new Chart(canvas.getContext('2d'), config);

            // The table: around the predicted acc, then fixed accuracies (comparable between predicted accs)
            const accs = [p, p + 0.5, p + 1, p + 2].filter(x => x < 99.99).concat([99, 99.5, 99.75, 100].filter(x => x > p + 0.01));
            const list = Array.from(new Set(accs.map(x => +x.toFixed(2)))).sort((a, b) => a - b);
            document.getElementById('ppHead').innerHTML = `<tr><th>Accuracy</th><th>Curve</th><th>&times; base</th><th>vs rating point</th>`
                + (cmp ? `<th>vs rating point at ${fmt(cmp.predicted, 2)}%</th>` : '') + '</tr>';
            document.getElementById('ppTable').innerHTML = list.map(x => {
                const t = interp(curPoints, x), b = interp(data.basePoints, x);
                const label = Math.abs(x - p) < 1e-6 ? `${fmt(x, 2)}% (predicted)` : `${fmt(x, 2)}%`;
                const cmpCell = cmp ? `<td>${x > cmp.predicted - 1e-6 ? fmt(interp(cmpPoints, x) / cmp.ratingRef, 3) + 'x' : '&ndash;'}</td>` : '';
                return `<tr><td>${label}</td><td>${fmt(t, 3)}</td><td>${fmt(t / b, 3)}</td><td>${fmt(t / cur.ratingRef, 3)}x</td>${cmpCell}</tr>`;
            }).join('');
        }

        // Start at ?pred= (else 97%), with ?compare= and the stars when given
        const params = new URLSearchParams(window.location.search);
        for (const [key, id] of [['stars', 'mapStars'], ['compareStars', 'compareStars']])
            if (!isNaN(parseFloat(params.get(key)))) document.getElementById(id).value = parseFloat(params.get(key));
        slider.value = indexOf(parseFloat(params.get('pred')) || 97);
        predInput.value = fmt(data.curves[+slider.value].predicted, 2);
        if (params.has('compare') && !isNaN(parseFloat(params.get('compare')))) {
            compareInput.value = fmt(data.curves[indexOf(parseFloat(params.get('compare')))].predicted, 2);
            document.getElementById('useCompare').checked = true;
        } else {
            compareInput.value = fmt(data.curves[Math.max(+slider.value - 10, 0)].predicted, 2);
        }
        resetCorrections();
    </script>
}
