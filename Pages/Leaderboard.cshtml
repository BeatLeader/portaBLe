@page "/leaderboard/{id}/{compareId?}"
@model LeaderboardModel
@using System.Text.Json
@using portaBLe.DB
@functions {
    public record RatingVariant(string Key, string Label, float Acc, float Pass, float Tech, float Stars, float Pred);
}

@{
    ViewData["Title"] = "Leaderboard Details";
    var gypL = 57.74;
    var defaultMaxRating = 15;
    // the map as rated without and with each speed modifier (ModifiersRating); the modifier selector switches between them
    Func<Leaderboard, List<RatingVariant>> variantsOf = lb =>
    {
        var v = new List<RatingVariant> { new("none", "None", lb.AccRating, lb.PassRating, lb.TechRating, lb.Stars, lb.PredictedAcc) };
        var m = lb.ModifiersRating;
        if (m != null)
        {
            v.Add(new("SS", "Slower Song (SS, 0.85x)", m.SSAccRating, m.SSPassRating, m.SSTechRating, m.SSStars, m.SSPredictedAcc));
            v.Add(new("FS", "Faster Song (FS, 1.2x)", m.FSAccRating, m.FSPassRating, m.FSTechRating, m.FSStars, m.FSPredictedAcc));
            v.Add(new("SF", "Super Fast Song (SF, 1.5x)", m.SFAccRating, m.SFPassRating, m.SFTechRating, m.SFStars, m.SFPredictedAcc));
        }
        return v;
    };
    var mainVariants = variantsOf(Model.Leaderboard);
    var compareVariants = Model.CompareLeaderboard != null ? variantsOf(Model.CompareLeaderboard) : new List<RatingVariant>();
    double maxRatingValue = mainVariants.Concat(compareVariants).Max(v => Math.Max(v.Tech, Math.Max(v.Pass, v.Acc)));
    Func<List<RatingVariant>, string> variantsJson = vs => JsonSerializer.Serialize(vs.ToDictionary(v => v.Key, v => new { acc = v.Acc, pass = v.Pass, tech = v.Tech }));
    Func<List<RatingVariant>, string> predictedJson = vs => JsonSerializer.Serialize(vs.ToDictionary(v => v.Key, v => v.Pred));
    double maxRating = maxRatingValue > defaultMaxRating ? Math.Ceiling(maxRatingValue) : defaultMaxRating;

    // Slider bounds for the rating editor; generous headroom above the current values.
    double sliderMax = Math.Max(20, Math.Ceiling(maxRatingValue * 1.5));
    Func<double, string> inv = v => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Per-modifier rating overrides serialized for the PP curve component.
    Func<ModifiersRating?, string> modRatingJson = mr => mr == null ? "" :
        JsonSerializer.Serialize(new Dictionary<string, float>
        {
            ["fsAccRating"] = mr.FSAccRating, ["fsPassRating"] = mr.FSPassRating, ["fsTechRating"] = mr.FSTechRating,
            ["ssAccRating"] = mr.SSAccRating, ["ssPassRating"] = mr.SSPassRating, ["ssTechRating"] = mr.SSTechRating,
            ["sfAccRating"] = mr.SFAccRating, ["sfPassRating"] = mr.SFPassRating, ["sfTechRating"] = mr.SFTechRating,
            ["fsPredictedAcc"] = mr.FSPredictedAcc, ["ssPredictedAcc"] = mr.SSPredictedAcc, ["sfPredictedAcc"] = mr.SFPredictedAcc,
        });

    // The PP formula this instance runs with (start-up options --curve/--gamma/--epsilon/--relative-epsilon/--mode-gamma/--pass-fade/--pass-blend/--acc-cap), so the curve matches the DB.
    var ppCurveConfig = new
    {
        mode = portaBLe.Refresh.PpCurve.Mode == portaBLe.Refresh.CurveMode.PowerLaw ? "power" : "classic",
        gamma = portaBLe.Refresh.PpCurve.Gamma,
        epsilon = portaBLe.Refresh.PpCurve.Epsilon,
        relativeEpsilon = portaBLe.Refresh.PpCurve.RelativeEpsilon,
        modeGamma = portaBLe.Refresh.PpCurve.ModeGammaScale.ToDictionary(kv => kv.Key.ToLowerInvariant(), kv => kv.Value),
        passFade = portaBLe.Refresh.PassFade.Enabled
            ? (object)new { strength = portaBLe.Refresh.PassFade.Strength, floor = portaBLe.Refresh.PassFade.Floor, center = portaBLe.Refresh.PassFade.Center }
            : null,
        accCap = portaBLe.Refresh.AccCap.Enabled ? (object)new { maxAdvantage = portaBLe.Refresh.AccCap.MaxAdvantage } : null,
        passBlend = portaBLe.Refresh.PassBlend.Enabled ? (object)portaBLe.Refresh.PassBlend.P : null,
    };

    // rating triangle of one variant; gid keeps the SVG gradient ids unique, rgb = tech / pass / acc colours
    void Triangle(RatingVariant v, string gid, string techRgb, string passRgb, string accRgb, bool shown)
    {
        double ax = (gypL - (v.Tech / maxRating) * gypL) * 0.866, ay = 86.6 - (gypL - (v.Tech / maxRating) * gypL) / 2;
        double bx = 100 - (gypL - (v.Acc / maxRating) * gypL) * 0.866, by = 86.6 - (gypL - (v.Acc / maxRating) * gypL) / 2;
        double cx = 50, cy = (86.6 - gypL / 2) * (1 - v.Pass / maxRating);
        var id = gid + "-" + v.Key;
        <div class="triangle-container" data-variant="@v.Key" style="@(shown ? null : "display:none")">
            <div class="tech-and-acc">
                <span>Tech: @(Math.Round(v.Tech, 2)) ★</span>
                <span>Acc: @(Math.Round(v.Acc, 2)) ★</span>
            </div>
            <div class="stars">
                <span>@(Math.Round(v.Stars, 1)) ★</span>
            </div>
            <svg style="width: 6em; height: 6em;" xmlns="http://www.w3.org/2000/svg" version="1.200000" width="100%" height="100%"
                 viewBox="0 0 100.000000 86.600000" xmlns:xlink="http://www.w3.org/1999/xlink">
                <g transform="matrix(1 0 0 -1 0 86.600000)">
                    <defs>
                        <linearGradient id="fadeA-@id" gradientUnits="userSpaceOnUse" x1="@inv(ax)" y1="@inv(ay)" x2="@inv((bx + cx) / 2)" y2="@inv((by + cy) / 2)">
                            <stop offset="0%" stop-color="rgb(@techRgb / @inv(v.Tech / maxRating * 100)%)" />
                            <stop offset="100%" stop-color="rgb(@techRgb / @inv(v.Tech / maxRating * 25)%)" />
                        </linearGradient>
                        <linearGradient id="fadeB-@id" gradientUnits="userSpaceOnUse" x1="@inv(cx)" y1="@inv(cy)" x2="@inv((ax + bx) / 2)" y2="@inv((ay + by) / 2)">
                            <stop offset="0%" stop-color="rgb(@passRgb / @inv(v.Pass / maxRating * 100)%)" />
                            <stop offset="100%" stop-color="rgb(@passRgb / @inv(v.Pass / maxRating * 25)%)" />
                        </linearGradient>
                        <linearGradient id="fadeC-@id" gradientUnits="userSpaceOnUse" x1="@inv(bx)" y1="@inv(by)" x2="@inv((cx + ax) / 2)" y2="@inv((ay + cy) / 2)">
                            <stop offset="0%" stop-color="rgb(@accRgb / @inv(v.Acc / maxRating * 100)%)" />
                            <stop offset="100%" stop-color="rgb(@accRgb / @inv(v.Acc / maxRating * 25)%)" />
                        </linearGradient>
                    </defs>
                    <g stroke="#FFF" stroke-width="0.5">
                        <path d="M @inv(cx),@inv(cy) L @inv(ax),@inv(ay) @inv(bx),@inv(by) Z" fill="url(#fadeA-@id)" />
                        <path d="M @inv(cx),@inv(cy) L @inv(ax),@inv(ay) @inv(bx),@inv(by) Z" fill="url(#fadeB-@id)" />
                        <path d="M @inv(cx),@inv(cy) L @inv(ax),@inv(ay) @inv(bx),@inv(by) Z" fill="url(#fadeC-@id)" />
                    </g>
                    <g stroke="#FFF" fill="none" stroke-width="2" stroke-dasharray="4">
                        <path d="M 50.000000,0.00000 L 0.000000,86.600000 100.000000,86.600000 Z" />
                    </g>
                </g>
            </svg>
            <div class="pass">
                <span>Pass: @(Math.Round(v.Pass, 2)) ★</span>
            </div>
        </div>
    }
}

@Html.AntiForgeryToken()

<div class="leaderboard-comparison">
    <div class="leaderboard-container">
        <h2>@Model.Leaderboard.Name - @Model.Leaderboard.DifficultyName - @Model.Leaderboard.ModeName</h2>
        @if (mainVariants.Count > 1)
        {
            <div class="mod-select">
                <label for="leaderboard-mod">Modifier</label>
                <select id="leaderboard-mod">
                    @foreach (var v in mainVariants)
                    {
                        <option value="@(v.Key == "none" ? "" : v.Key)">@v.Label</option>
                    }
                </select>
                <span class="mod-select-note">ratings, PP curve and the accuracy / fail graphs follow it</span>
            </div>
        }

        <div class="leaderboard-info">
            <div class="leaderboard-info-left">
            @foreach (var v in mainVariants) { Triangle(v, "1", "255 0 0", "0 255 0", "128 0 128", v.Key == "none"); }

            <div class="rating-sliders"
                data-leaderboard-id="@Model.Leaderboard.Id"
                data-orig-acc="@inv(Model.Leaderboard.AccRating)"
                data-orig-pass="@inv(Model.Leaderboard.PassRating)"
                data-orig-tech="@inv(Model.Leaderboard.TechRating)"
                data-variants="@variantsJson(mainVariants)">
                <div class="rating-sliders-title">Preview ratings</div>
                <div class="rating-slider-row">
                    <label>Acc</label>
                    <input type="range" data-rating="acc" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.Leaderboard.AccRating)" />
                    <input type="number" data-rating="acc" min="0" step="0.01" value="@inv(Model.Leaderboard.AccRating)" />
                </div>
                <div class="rating-slider-row">
                    <label>Pass</label>
                    <input type="range" data-rating="pass" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.Leaderboard.PassRating)" />
                    <input type="number" data-rating="pass" min="0" step="0.01" value="@inv(Model.Leaderboard.PassRating)" />
                </div>
                <div class="rating-slider-row">
                    <label>Tech</label>
                    <input type="range" data-rating="tech" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.Leaderboard.TechRating)" />
                    <input type="number" data-rating="tech" min="0" step="0.01" value="@inv(Model.Leaderboard.TechRating)" />
                </div>
                <div class="rating-reset-row">
                    <button type="button" class="reset-ratings-btn" style="display:none;">Reset</button>
                    <span class="rating-preview-note">Preview only: the PP curve follows the sliders, nothing is saved.</span>
                </div>
            </div>
            </div>

            <div class="pp-curve-component"
                data-leaderboard-id="@Model.Leaderboard.Id"
                data-mode="@(Model.Leaderboard.ModeName?.ToLowerInvariant())"
                data-predicted-acc="@inv(Model.Leaderboard.PredictedAcc)"
                data-modifiers-rating="@modRatingJson(Model.Leaderboard.ModifiersRating)"></div>
        </div>
    </div>

    @if (Model.CompareLeaderboard != null)
    {
        <div class="leaderboard-container">
            <h2>@Model.CompareLeaderboard.Name - @Model.CompareLeaderboard.DifficultyName - @Model.CompareLeaderboard.ModeName</h2>

            @foreach (var v in compareVariants) { Triangle(v, "2", "0 0 255", "0 255 255", "128 128 255", v.Key == "none"); }

            <div class="rating-sliders"
                 data-leaderboard-id="@Model.CompareLeaderboard.Id"
                 data-orig-acc="@inv(Model.CompareLeaderboard.AccRating)"
                 data-orig-pass="@inv(Model.CompareLeaderboard.PassRating)"
                 data-orig-tech="@inv(Model.CompareLeaderboard.TechRating)"
                 data-variants="@variantsJson(compareVariants)">
                <div class="rating-sliders-title">Preview ratings</div>
                <div class="rating-slider-row">
                    <label>Acc</label>
                    <input type="range" data-rating="acc" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.CompareLeaderboard.AccRating)" />
                    <input type="number" data-rating="acc" min="0" step="0.01" value="@inv(Model.CompareLeaderboard.AccRating)" />
                </div>
                <div class="rating-slider-row">
                    <label>Pass</label>
                    <input type="range" data-rating="pass" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.CompareLeaderboard.PassRating)" />
                    <input type="number" data-rating="pass" min="0" step="0.01" value="@inv(Model.CompareLeaderboard.PassRating)" />
                </div>
                <div class="rating-slider-row">
                    <label>Tech</label>
                    <input type="range" data-rating="tech" min="0" max="@inv(sliderMax)" step="0.01" value="@inv(Model.CompareLeaderboard.TechRating)" />
                    <input type="number" data-rating="tech" min="0" step="0.01" value="@inv(Model.CompareLeaderboard.TechRating)" />
                </div>
                <div class="rating-reset-row">
                    <button type="button" class="reset-ratings-btn" style="display:none;">Reset</button>
                    <span class="rating-preview-note">Preview only: the PP curve follows the sliders, nothing is saved.</span>
                </div>
            </div>

            <div class="pp-curve-component"
                 data-leaderboard-id="@Model.CompareLeaderboard.Id"
                 data-mode="@(Model.CompareLeaderboard.ModeName?.ToLowerInvariant())"
                 data-predicted-acc="@inv(Model.CompareLeaderboard.PredictedAcc)"
                 data-modifiers-rating="@modRatingJson(Model.CompareLeaderboard.ModifiersRating)"></div>
        </div>
    }
</div>

@if (Model.AccLossJson != null)
{
    <div class="acc-loss-component" data-predicted-acc="@inv(Model.Leaderboard.PredictedAcc)" data-predicted="@predictedJson(mainVariants)" data-mode="@Model.Leaderboard.ModeName"></div>
}

<div class="chart-container">
    <div class="x-selector">
        <select id="xAxisSelect" onchange="updateAxes()">
            <option value="playerRank">Player Rank</option>
            <option value="date">Date</option>
            <option value="pp">PP</option>
            <option value="acc">Accuracy</option>
            <option value="fcAcc">FC Accuracy</option>
            <option value="pauses">Pause Count</option>
            <option value="rank">Leaderboard Rank</option>
            <option value="maxStreak">Streak Length</option>
            <option value="mistakes">Mistake Count</option>
            <option value="weight">PP Weight</option>
            <option value="weightedPp">Weighted PP</option>
        </select>
    </div>
    <div class="y-selector">
        <select id="yAxisSelect" onchange="updateAxes()">
        <option value="weight">PP Weight</option>
            <option value="playerRank">Player Rank</option>
            <option value="date">Date</option>
            <option value="pp">PP</option>
            <option value="acc">Accuracy</option>
            <option value="fcAcc">FC Accuracy</option>
            <option value="pauses">Pause Count</option>
            <option value="rank">Leaderboard Rank</option>
            <option value="maxStreak">Streak Length</option>
            <option value="mistakes">Mistake Count</option>
            <option value="weightedPp">Weighted PP</option>
        </select>
    </div>
    <canvas id="scoreChart"></canvas>
    <div id="loading" style="display: none;">Loading...</div>
</div>

<div class="tables-container">
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>PP</th>
                    <th>Accuracy</th>
                    <th>Mods</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var score in Model.Scores)
                {
                    <tr>
                        <td><a asp-page="/Player" asp-route-id="@score.Player.Id">@score.Player.Name</a></td>
                        <td>@score.Pp</td>
                        <td>@score.Accuracy</td>
                        <td>@score.Modifiers</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Score navigation">
            <ul class="pagination">
                @{
                    int firstPageToShow = Model.CurrentPage - 5;
                    int lastPageToShow = Model.CurrentPage + 4;
                    if (firstPageToShow < 1)
                    {
                        firstPageToShow = 1;
                        lastPageToShow = 10;
                    }
                    if (lastPageToShow > Model.TotalPages)
                    {
                        lastPageToShow = Model.TotalPages;
                        firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
                    }

                    for (int i = firstPageToShow; i <= lastPageToShow; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="./Leaderboard" asp-route-id="@Model.Leaderboard.Id" asp-route-compareId="@Model.CompareLeaderboard?.Id" asp-route-currentPage="@i" asp-route-db="@Model.SelectedDatabase">@i</a>
                        </li>
                    }
                }
            </ul>
        </nav>
    </div>

    @if (Model.CompareLeaderboard != null)
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>PP</th>
                        <th>Accuracy</th>
                        <th>Mods</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var score in Model.CompareScores)
                    {
                        <tr>
                            <td><a asp-page="/Player" asp-route-id="@score.Player.Id">@score.Player.Name</a></td>
                            <td>@score.Pp</td>
                            <td>@score.Accuracy</td>
                            <td>@score.Modifiers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .leaderboard-comparison {
        display: flex;
        gap: 2em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .leaderboard-container {
        flex: 1;
        min-width: 300px;
        max-width: 500px;
    }

    .leaderboard-info {
        display: flex;
        gap: 2em;
        justify-content: center;
    }

    .tables-container {
        display: flex;
        gap: 2em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .table-wrapper {
        flex: 1;
        min-width: 300px;
        max-width: 500px;
    }

    .triangle-container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 15em;
        background-color: #323232;
        padding: 1em;
        margin: 0 auto;
    }

    .tech-and-acc {
        color: white;
        display: flex;
        grid-gap: 4em;
        font-size: 0.8em;
    }

    .pass {
        color: white;
        font-size: 0.8em;
    }

    .stars {
        position: absolute;
        top: 33%;
        color: yellow;
        font-size: small;
    }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
        margin: 20px 0;
    }

    .x-selector {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
    }

    .y-selector {
        position: absolute;
        left: -20px;
        top: 60%;
        transform: translateY(-50%) rotate(-90deg);
        transform-origin: left center;
        z-index: 1;
    }

    #loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .rating-sliders {
        width: 15em;
        box-sizing: border-box;
        margin: 0.5em auto 0;
        padding: 1em;
        background-color: #323232;
        color: white;
    }

    .rating-sliders-title {
        font-size: 0.85em;
        font-weight: bold;
        margin-bottom: 0.6em;
    }

    .rating-slider-row {
        display: flex;
        align-items: center;
        gap: 0.5em;
        margin-bottom: 0.5em;
        font-size: 0.8em;
    }

    .rating-slider-row label {
        width: 2.5em;
        flex-shrink: 0;
    }

    .rating-slider-row input[type="range"] {
        flex: 1;
        min-width: 0;
    }

    .rating-slider-row input[type="number"] {
        width: 4.5em;
        flex-shrink: 0;
    }

    .rating-reset-row {
        display: flex;
        align-items: center;
        gap: 0.5em;
        margin-top: 0.6em;
        min-height: 2em;
    }

    .reset-ratings-btn {
        background-color: #f54278;
        color: white;
        border: none;
        padding: 0.4em 1.2em;
        border-radius: 3px;
        cursor: pointer;
    }

    .reset-ratings-btn:disabled {
        opacity: 0.6;
        cursor: default;
    }

    .mod-select {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
        margin: 0 0 0.6em;
        font-size: 0.9em;
    }

    .mod-select select {
        background: #323232;
        color: #fff;
        border: 1px solid #555;
        border-radius: 0.3em;
        padding: 0.15em 0.4em;
    }

    .mod-select-note {
        color: #777;
        font-size: 0.85em;
    }

    .rating-preview-note {
        font-size: 0.75em;
        color: #ddd;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom"></script>
    <script>window.PP_CURVE_CONFIG = @Html.Raw(JsonSerializer.Serialize(ppCurveConfig));</script>
    <script src="~/js/pp-curve.js" asp-append-version="true"></script>
    @if (Model.AccLossJson != null)
    {
        <script type="application/json" id="acc-loss-profiles">@Html.Raw(Model.AccLossJson.Replace("</", "<\\/"))</script>
        <script type="application/json" id="acc-loss-model">@Html.Raw(Model.AccLossModelJson!.Replace("</", "<\\/"))</script>
        <script src="~/js/acc-loss.js" asp-append-version="true"></script>
    }
    <script>
        let chart = null;
        const leaderboardId = '@Model.Leaderboard.Id';
        const compareLeaderboardId = '@Model.CompareLeaderboard?.Id';

        const totalScores = '@Model.TotalScores';
        const compareTotalScores = '@Model.CompareTotalScores';
        let currentPlayerId = null;
        const leaderboardScores = @Html.Raw(JsonSerializer.Serialize(Model.ScoreGraphEntries));
        const compareLeaderboardScores = @Html.Raw(JsonSerializer.Serialize(Model.CompareScoreGraphEntries ?? new LeaderboardModel.ScoreGraphEntry[] { }));

        function formatNumber(num, decimals) {
            return Number(num).toFixed(decimals);
        }

        function roundToPrecision(num, precision) {
            return Math.round(num / precision) * precision;
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString();
        }

        function formatDateRelative(date) {
            const diff = (new Date() - date) / 1000;
            if (diff < 60) return 'just now';
            if (diff < 3600) return Math.floor(diff / 60) + ' minutes ago';
            if (diff < 86400) return Math.floor(diff / 3600) + ' hours ago';
            return Math.floor(diff / 86400) + ' days ago';
        }

        const freshScoreAgeMillis = 0;
        const oldScoreAgeMillis = 1000 * 60 * 60 * 24 * 30 * 8; //~8 months
        const freshScoreBrightness = 255;
        const oldScoreBrightness = 128;

        function getTimeStringColor(timeSet) {
            if (!timeSet) return '#ffffff';
            const scoreAgeMillis = new Date().getTime() - timeSet.getTime();
            let ratio = (scoreAgeMillis - freshScoreAgeMillis) / (oldScoreAgeMillis - freshScoreAgeMillis);
            if (ratio < 0) ratio = 0;
            if (ratio > 1) ratio = 1;
            ratio = Math.pow(1 - ratio, 3);
            const brightnessInt = (oldScoreBrightness + (freshScoreBrightness - oldScoreBrightness) * ratio) | 0;
            const brightnessHex = brightnessInt.toString(16);
            return '#' + brightnessHex + brightnessHex + brightnessHex;
        }

        function sortByToAxisName(sortBy) {
            switch (sortBy) {
                case 'date': return 'Date';
                case 'pp': return 'Pp';
                case 'acc': return 'Accuracy';
                case 'fcAcc': return 'FC Accuracy';
                case 'pauses': return 'Pause Count';
                case 'rank': return 'Leaderboard Rank';
                case 'maxStreak': return 'Streak length';
                case 'mistakes': return 'Mistake Count';
                case 'weight': return 'PP Weight';
                case 'weightedPp': return 'Weighted PP';
                case 'playerRank': return 'Player Rank';
            }
            return null;
        }

        function valueFromSortBy(score, sortBy, isCompare) {
            if (!score) return null;
            switch (sortBy) {
                case 'date': return score.timepost ? new Date(score.timepost * 1000) : null;
                case 'pp': return score.pp;
                case 'acc': return 100 - score.accuracy;
                case 'fcAcc': return 100 - score.fcAcc;
                case 'pauses': return score.pauses;
                case 'rank': return (score.rank / (isCompare ? compareTotalScores : totalScores)) * 100;
                case 'maxStreak': return score.maxStreak;
                case 'mistakes': return score.mistakes;
                case 'weight': return score.weight * 100;
                case 'weightedPp': return score.weight * score.pp;
                case 'playerRank': return score.playerRank;
            }
            return null;
        }

        function sortByToNullable(sortBy) {
            switch (sortBy) {
                case 'date':
                case 'pp':
                case 'acc': 
                case 'rank':
                case 'weight':
                case 'weightedPp':
                    return false;
            }
            return true;
        }

        function sortByToTicks(sortBy) {
            switch (sortBy) {
                case 'date':
                    return {
                        autoSkip: true,
                        major: {
                            enabled: true,
                        },
                        callback: val => formatDate(val),
                    };
                case 'pp':
                    return {
                        callback: val => formatNumber(val, 2) + 'pp',
                    };
                case 'acc':
                case 'fcAcc':
                    return {
                        max: 100,
                        callback: val => formatNumber(100 - val, 2) + '%',
                    };
                case 'rank':
                    return {
                        callback: val => formatNumber(val, 0),
                    };
                case 'pauses':
                case 'maxStreak':
                case 'mistakes':
                    return {
                        callback: val => formatNumber(val, 0),
                    };
                case 'weight':
                    return {
                        max: 100,
                        callback: val => formatNumber(val, 0) + '%',
                    };
                case 'weightedPp':
                    return {
                        max: 100,
                        callback: val => formatNumber(val, 2) + 'pp',
                    };
                case 'playerRank':
                    return {
                        min: 0,
                        stepSize: 1000,
                        callback: val => '#' + formatNumber(val, 0),
                    };
            }
            return null;
        }

        function setupChart(scores, compareScores, xAxis = 'playerRank', yAxis = 'weight') {
            if (!scores?.length) return;

            const ctx = document.getElementById('scoreChart').getContext('2d');
            const isXNullable = sortByToNullable(xAxis);
            const isYNullable = sortByToNullable(yAxis);

            function processScores(scores, isCompare = false) {
                return scores
                    .filter(s => !!s?.playerRank)
                    .map(s => {
                        const xValue = valueFromSortBy(s, xAxis, isCompare);
                        if (!xValue && !isXNullable) return null;

                        const yValue = valueFromSortBy(s, yAxis, isCompare);
                        if (!yValue && !isYNullable) return null;

                        return {
                            x: xValue,
                            y: yValue,
                            mods: s?.modifiers?.length ? s.modifiers.split(',') : null,
                            isCompare,
                            ...s,
                        };
                    })
                    .filter(s => s !== null);
            }

            const chartData = processScores(scores);
            const compareChartData = compareScores?.length ? processScores(compareScores, true) : [];

            const options = {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: {
                        right: 0,
                    },
                },
                interaction: {
                    mode: 'nearest',
                    intersect: true,
                },
                plugins: {
                    legend: {
                        display: true,
                    },
                    tooltip: {
                        displayColors: false,
                        position: 'nearest',
                        callbacks: {
                            label: function(context) {
                                if (!context || !context?.raw) return '';
                                const score = context.raw;
                                return [
                                    formatDate(score.timepost * 1000),
                                    `${score.playerName} - #${formatNumber(score.playerRank, 0)}`
                                ];
                            },
                            title: function(context) {
                                if (!context?.[0]?.raw) return '';
                                const score = context[0].raw;
                                const mods = score?.mods ?? null;
                                const acc = formatNumber(score?.accuracy ?? 0, 2);
                                const xValue = score?.x ?? 0;
                                const yValue = score?.y ?? 0;
                                return `${sortByToAxisName(xAxis)}: ${(sortByToTicks(xAxis).callback)(xValue)} | ${sortByToAxisName(yAxis)}: ${(sortByToTicks(yAxis).callback)(yValue)} | Acc: ${acc}% ${mods?.length ? ' (' + mods.join(', ') + ')' : ''}`;
                            }
                        }
                    },
                    zoom: {
                        pan: {
                            enabled: true,
                            mode: 'xy'
                        },
                        zoom: {
                            wheel: { enabled: true },
                            pinch: { enabled: true },
                            mode: 'xy'
                        }
                    }
                },
                scales: {
                    x: {
                        type: xAxis === 'date' ? 'time' : (xAxis === 'acc' || xAxis === 'rank' || xAxis === 'fcAcc') ? 'linear' : 'logarithmic',
                        title: {
                            display: true,
                            text: sortByToAxisName(xAxis)
                        },
                        ticks: sortByToTicks(xAxis)
                    },
                    y: {
                        type: yAxis === 'date' ? 'time' : (yAxis === 'acc' || yAxis === 'fcAcc') ? 'logarithmic' : 'linear',
                        reverse: yAxis === 'acc' || yAxis === 'fcAcc',
                        ticks: sortByToTicks(yAxis),
                        grid: {
                            color: 'rgba(0,0,0,0.1)',
                            display: true,
                            drawBorder: true,
                            drawOnChartArea: true
                        }
                    }
                },
                onHover: function(event, elements) {
                    const element = elements?.[0]?.element?.$context?.raw;
                    if (!element?.playerId) {
                        event.native.target.style.cursor = 'default';
                    } else {
                        event.native.target.style.cursor = 'pointer';
                    }
                },
                onClick: function(event, elements) {
                    const element = elements?.[0]?.element?.$context?.raw;
                    if (!element?.playerId) return;
                    window.open(`/player/${element.playerId}`, '_blank');
                }
            };

            if (chart) {
                chart.destroy();
            }

            const datasets = [{
                label: 'Leaderboard 1',
                data: chartData,
                borderColor: function (context) {
                    const item = context.raw;
                    return item.fc
                        ? 'yellow'
                        : getTimeStringColor(new Date(item.timepost * 1000));
                },
                backgroundColor: '#f54278',
                pointRadius: 4,
                borderWidth: function (context) {
                    const item = context.raw;
                    return item.fc
                        ? 2
                        : 1;
                },
                pointHoverRadius: 5
            }];

            if (compareChartData.length > 0) {
                datasets.push({
                    label: 'Leaderboard 2',
                    data: compareChartData,
                    borderColor: function(context) {
                        const item = context.raw;
                        return item.fc
                        ? 'yellow'
                        : getTimeStringColor(new Date(item.timepost * 1000));
                    },
                    backgroundColor: '#0000ff',
                    pointRadius: 4,
                    borderWidth: function (context) {
                        const item = context.raw;
                        return item.fc
                            ? 2
                            : 1;
                    },
                    pointHoverRadius: 5
                });
            }
            chart = new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets
                },
                options: options
            });
        }

        function updateAxes() {
            const xValue = document.getElementById('xAxisSelect').value;
            const yValue = document.getElementById('yAxisSelect').value;
            setupChart(leaderboardScores, compareLeaderboardScores, xValue, yValue);
        }

        // Initial load
        setupChart(leaderboardScores, compareLeaderboardScores);

        // --- Rating sliders ---
        const selectedDatabase = @Html.Raw(JsonSerializer.Serialize(Model.SelectedDatabase));
        const RATING_KEYS = ['acc', 'pass', 'tech'];

        function setupRatingSliders(container) {
            const leaderboardId = container.dataset.leaderboardId;
            let variants = {};
            try { variants = JSON.parse(container.dataset.variants || '{}'); } catch (e) { variants = {}; }
            let original = {
                acc: parseFloat(container.dataset.origAcc),
                pass: parseFloat(container.dataset.origPass),
                tech: parseFloat(container.dataset.origTech)
            };

            const ranges = {};
            const numbers = {};
            RATING_KEYS.forEach(key => {
                ranges[key] = container.querySelector(`input[type="range"][data-rating="${key}"]`);
                numbers[key] = container.querySelector(`input[type="number"][data-rating="${key}"]`);
            });

            const resetBtn = container.querySelector('.reset-ratings-btn');

            function currentValues() {
                return {
                    acc: parseFloat(numbers.acc.value),
                    pass: parseFloat(numbers.pass.value),
                    tech: parseFloat(numbers.tech.value)
                };
            }

            function isChanged() {
                const values = currentValues();
                return RATING_KEYS.some(key =>
                    isNaN(values[key]) || Math.abs(values[key] - original[key]) > 1e-6);
            }

            function refreshResetButton() {
                resetBtn.style.display = isChanged() ? 'inline-block' : 'none';
            }

            function handleSliderChange() {
                refreshResetButton();
                container.dispatchEvent(new CustomEvent('ratingschange'));
            }

            RATING_KEYS.forEach(key => {
                ranges[key].addEventListener('input', () => {
                    numbers[key].value = ranges[key].value;
                    handleSliderChange();
                });
                numbers[key].addEventListener('input', () => {
                    const value = parseFloat(numbers[key].value);
                    if (!isNaN(value)) {
                        ranges[key].value = value;
                    }
                    handleSliderChange();
                });
            });

            // back to the map's real ratings
            resetBtn.addEventListener('click', () => {
                RATING_KEYS.forEach(key => {
                    ranges[key].value = original[key];
                    numbers[key].value = original[key];
                });
                handleSliderChange();
            });

            // the modifier selector puts that variant's ratings into the sliders (Reset then goes back to them)
            container.setVariant = key => {
                const v = variants[key];
                if (!v) return;
                original = {acc: v.acc, pass: v.pass, tech: v.tech};
                RATING_KEYS.forEach(k => { ranges[k].value = v[k]; numbers[k].value = v[k]; });
                handleSliderChange();
            };

            refreshResetButton();
        }

        document.querySelectorAll('.rating-sliders').forEach(setupRatingSliders);

        // --- Modifier selector: ratings (triangle + sliders), the PP curves and the accuracy / fail card follow it (?mod=SF in the URL) ---
        const modSelect = document.getElementById('leaderboard-mod');
        function applyModifier(mod, updateUrl) {
            const key = mod || 'none';
            document.querySelectorAll('.triangle-container[data-variant]').forEach(t => { t.style.display = t.dataset.variant === key ? '' : 'none'; });
            document.querySelectorAll('.rating-sliders').forEach(c => c.setVariant && c.setVariant(key));
            document.dispatchEvent(new CustomEvent('leaderboardmodifier', {detail: {mod: mod || null}}));
            if (updateUrl) {
                const u = new URL(location.href);
                if (mod) u.searchParams.set('mod', mod); else u.searchParams.delete('mod');
                history.replaceState(null, '', u);
            }
        }
        if (modSelect) {
            modSelect.addEventListener('change', () => applyModifier(modSelect.value, true));
            const initialMod = new URLSearchParams(location.search).get('mod');
            if (initialMod && [...modSelect.options].some(o => o.value === initialMod)) {
                modSelect.value = initialMod;
                // the PP curves initialize on DOMContentLoaded (pp-curve.js registered its handler first)
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => applyModifier(initialMod, false));
                else applyModifier(initialMod, false);
            }
        }
    </script>
}
