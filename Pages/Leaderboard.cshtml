@page "/leaderboard/{id}/{compareId?}"
@model LeaderboardModel
@using System.Text.Json

@{
    ViewData["Title"] = "Leaderboard Details";
    var gypL = 57.74;
    var defaultMaxRating = 15;
    double maxRatingValue = Math.Max(
        Model.Leaderboard.TechRating,
        Math.Max(Model.Leaderboard.PassRating, Model.Leaderboard.AccRating)
    );
    if (Model.CompareLeaderboard != null)
    {
        maxRatingValue = Math.Max(maxRatingValue,
            Math.Max(Model.CompareLeaderboard.TechRating,
            Math.Max(Model.CompareLeaderboard.PassRating, Model.CompareLeaderboard.AccRating))
        );
    }
    double maxRating = maxRatingValue > defaultMaxRating ? Math.Ceiling(maxRatingValue) : defaultMaxRating;
    string? dbQuery = string.IsNullOrEmpty(Request.Query["db"]) ? null : Request.Query["db"].ToString();
    string worthLabel = Model.Modifier == "none" ? "Worth" : $"Worth ({Model.Modifier})";
    const string worthTitle = "How much the map pays its players compared with maps of the same stars: for the same players, how much more or less they get here than on their other maps at their level (+4% = 4% more). With a speed modifier: that modifier's scores, against nomod maps of its stars.";
    string topShareTitle = FormattableString.Invariant($"Of the map's players with {portaBLe.Refresh.AccReweighter.TopPlayShareMinScores}+ ranked plays, those whose best play it is by {portaBLe.Refresh.AccReweighter.TopPlayMarginPp:0.#}pp or more over their second best (any modifier), and that share over the median of the maps within {portaBLe.Refresh.AccReweighter.TopPlayShareBandwidth:0.#} star. The acc reweighter cuts maps past x{portaBLe.Refresh.AccReweighter.TopPlayShareRatio:0.#}.");

    // Rating triangle corners (tech, acc, pass) of the leaderboard
    var corner1 = new
    {
        x = (gypL - (Model.Leaderboard.TechRating / maxRating) * gypL) * 0.866,
        y = 86.6 - (gypL - (Model.Leaderboard.TechRating / maxRating) * gypL) / 2
    };
    var corner2 = new
    {
        x = 100 - (gypL - (Model.Leaderboard.AccRating / maxRating) * gypL) * 0.866,
        y = 86.6 - (gypL - (Model.Leaderboard.AccRating / maxRating) * gypL) / 2
    };
    var corner3 = new
    {
        x = 50,
        y = (86.6 - gypL / 2) * (1 - Model.Leaderboard.PassRating / maxRating)
    };

    // and of the comparison leaderboard
    var corner1Compare = new { x = 0.0, y = 0.0 };
    var corner2Compare = new { x = 0.0, y = 0.0 };
    var corner3Compare = new { x = 0.0, y = 0.0 };

    if (Model.CompareLeaderboard != null)
    {
        corner1Compare = new
        {
            x = (gypL - (Model.CompareLeaderboard.TechRating / maxRating) * gypL) * 0.866,
            y = 86.6 - (gypL - (Model.CompareLeaderboard.TechRating / maxRating) * gypL) / 2
        };
        corner2Compare = new
        {
            x = 100 - (gypL - (Model.CompareLeaderboard.AccRating / maxRating) * gypL) * 0.866,
            y = 86.6 - (gypL - (Model.CompareLeaderboard.AccRating / maxRating) * gypL) / 2
        };
        corner3Compare = new
        {
            x = 50.0,
            y = (86.6 - gypL / 2) * (1 - Model.CompareLeaderboard.PassRating / maxRating)
        };
    }
}

<form method="get" class="modifier-selector">
    @if (!string.IsNullOrEmpty(Request.Query["db"]))
    {
        <input type="hidden" name="db" value="@Request.Query["db"]" />
    }
    <label for="modifierSelect">Speed modifier:</label>
    <select id="modifierSelect" name="modifier" onchange="this.form.submit()">
        @foreach (var m in LeaderboardModel.Modifiers)
        {
            <option value="@m" selected="@(m == Model.Modifier)">@(m == "none" ? "None" : m)</option>
        }
    </select>
    <span class="modifier-note">Ratings, stars, predicted acc, curve and worth of the selected modifier; with one, only the scores with it are shown</span>
</form>

<div class="leaderboard-comparison">
    <div class="leaderboard-container">
        <div class="lb-header">
            @if (!string.IsNullOrEmpty(Model.Leaderboard.Cover))
            {
                <img class="lb-cover" src="@Model.Leaderboard.Cover" alt="Cover" />
            }
            <h2>@Model.Leaderboard.Name - @Model.Leaderboard.DifficultyName - @Model.Leaderboard.ModeName</h2>
        </div>
        @if (Model.Difficulties.Count > 1)
        {
            <div class="difficulty-selector">
                @foreach (var d in Model.Difficulties)
                {
                    var label = d.ModeName == Model.Leaderboard.ModeName ? d.DifficultyName : $"{d.DifficultyName} ({d.ModeName})";
                    <a class="difficulty-pill @(d.Id == Model.Leaderboard.Id ? "active" : "")" asp-page="./Leaderboard" asp-route-id="@d.Id"
                       asp-route-compareId="@Model.CompareLeaderboard?.Id" asp-route-modifier="@(Model.Modifier == "none" ? null : Model.Modifier)"
                       asp-route-db="@dbQuery" title="@d.Id · @d.Stars.ToString("0.00") ★">@label</a>
                }
            </div>
        }

        <div class="triangle-container">
            <div class="tech-and-acc">
                <span>Tech: @(Math.Round(Model.Leaderboard.TechRating, 2)) ★</span>
                <span>Acc: @(Math.Round(Model.Leaderboard.AccRating, 2)) ★</span>
            </div>
            <div class="stars">
                <span>@(Math.Round(Model.Leaderboard.Stars, 1)) ★</span>
            </div>

            <svg style="width: 6em; height: 6em;"
                 xmlns="http://www.w3.org/2000/svg"
                 version="1.200000"
                 width="100%"
                 height="100%"
                 viewBox="0 0 100.000000 86.600000"
                 xmlns:xlink="http://www.w3.org/1999/xlink">
                <g transform="matrix(1 0 0 -1 0 86.600000)">
                    <defs>
                        <linearGradient id="fadeA-1"
                                        gradientUnits="userSpaceOnUse"
                                        x1=@corner1.x
                                        y1=@corner1.y
                                        x2=@((corner2.x + corner3.x) / 2)
                                        y2=@((corner2.y + corner3.y) / 2)>
                            <stop offset="0%" stop-color="rgb(255 0 0 / @((Model.Leaderboard.TechRating / maxRating) * 100)%)" />
                            <stop offset="100%" stop-color="rgb(255 0 0 / @((Model.Leaderboard.TechRating / maxRating) * 25)%)" />
                        </linearGradient>
                        <linearGradient id="fadeB-1"
                                        gradientUnits="userSpaceOnUse"
                                        x1=@(corner3.x)
                                        y1=@(corner3.y)
                                        x2=@((corner1.x + corner2.x) / 2)
                                        y2=@((corner1.y + corner2.y) / 2)>
                            <stop offset="0%" stop-color="rgb(0 255 0 / @((Model.Leaderboard.PassRating / maxRating) * 100)%)" />
                            <stop offset="100%" stop-color="rgb(0 255 0 / @((Model.Leaderboard.PassRating / maxRating) * 25)%)" />
                        </linearGradient>
                        <linearGradient id="fadeC-1"
                                        gradientUnits="userSpaceOnUse"
                                        x1=@(corner2.x)
                                        y1=@(corner2.y)
                                        x2=@((corner3.x + corner1.x) / 2)
                                        y2=@((corner1.y + corner3.y) / 2)>
                            <stop offset="0%" stop-color="rgb(128 0 128 / @((Model.Leaderboard.AccRating / maxRating) * 100)%)" />
                            <stop offset="100%" stop-color="rgb(128 0 128 / @((Model.Leaderboard.AccRating / maxRating) * 25)%)" />
                        </linearGradient>
                    </defs>
                    <g stroke="#FFF" stroke-width="0.5">
                        <path d="M @corner3.x,@corner3.y L @corner1.x,@corner1.y @corner2.x,@corner2.y Z" fill="url(#fadeA-1)" />
                        <path d="M @corner3.x,@corner3.y L @corner1.x,@corner1.y @corner2.x,@corner2.y Z" fill="url(#fadeB-1)" />
                        <path d="M @corner3.x,@corner3.y L @corner1.x,@corner1.y @corner2.x,@corner2.y Z" fill="url(#fadeC-1)" />
                    </g>
                    <g stroke="#FFF" fill="none" stroke-width="2" stroke-dasharray="4">
                        <path d="M 50.000000,0.00000 L 0.000000,86.600000 100.000000,86.600000 Z" />
                    </g>
                </g>
            </svg>
            <div class="pass">
                <span>Pass: @(Math.Round(Model.Leaderboard.PassRating, 2)) ★</span>
            </div>
        </div>
        <div class="predicted-acc">Predicted acc: @((Model.Leaderboard.PredictedAcc * 100).ToString("0.00"))%</div>
        <div class="worth-line" title="@worthTitle">@worthLabel: <span class="worth-value @WorthClass(Model.Leaderboard.Worth)">@WorthText(Model.Leaderboard.Worth)</span></div>
        <div class="worth-line" title="@topShareTitle">Top play share: <span class="worth-value @TopShareClass(Model.Leaderboard.TopPlayShareRelative)">@TopShareText(Model.Leaderboard.TopPlayShare, Model.Leaderboard.TopPlayShareRelative)</span></div>
        @if (Model.NjsText(Model.Njs) is string njsText)
        {
            <div class="predicted-acc">@njsText</div>
        }
        @if (Model.Leaderboard.NoteCount > 0)
        {
            <div class="predicted-acc">Notes: @Model.Leaderboard.NoteCount</div>
        }
        <div class="predicted-acc" title="Inlines: a note at most 1/4 beat behind another (either color) in the same column and row, hidden by it (Analyzer). Bomb resets: the Analyzer's bomb avoidances.">Inlines: @Model.Leaderboard.Inlines, bomb resets: @Model.Leaderboard.BombAvoidances.ToString("0")</div>
        @if (MapTags.Of(Model.Leaderboard).Any())
        {
            <div class="map-tags">@MapTags.Badges(Model.Leaderboard)</div>
        }
    </div>

    @if (Model.CompareLeaderboard != null)
    {
        <div class="leaderboard-container">
            <div class="lb-header">
                @if (!string.IsNullOrEmpty(Model.CompareLeaderboard.Cover))
                {
                    <img class="lb-cover" src="@Model.CompareLeaderboard.Cover" alt="Cover" />
                }
                <h2>@Model.CompareLeaderboard.Name - @Model.CompareLeaderboard.DifficultyName - @Model.CompareLeaderboard.ModeName</h2>
            </div>

            <div class="triangle-container">
                <div class="tech-and-acc">
                    <span>Tech: @(Math.Round(Model.CompareLeaderboard.TechRating, 2)) ★</span>
                    <span>Acc: @(Math.Round(Model.CompareLeaderboard.AccRating, 2)) ★</span>
                </div>
                <div class="stars">
                    <span>@(Math.Round(Model.CompareLeaderboard.Stars, 1)) ★</span>
                </div>

                <svg style="width: 6em; height: 6em;"
                     xmlns="http://www.w3.org/2000/svg"
                     version="1.200000"
                     width="100%"
                     height="100%"
                     viewBox="0 0 100.000000 86.600000"
                     xmlns:xlink="http://www.w3.org/1999/xlink">
                    <g transform="matrix(1 0 0 -1 0 86.600000)">
                        <defs>
                            <linearGradient id="fadeA-2"
                                            gradientUnits="userSpaceOnUse"
                                            x1=@corner1Compare.x
                                            y1=@corner1Compare.y
                                            x2=@((corner2Compare.x + corner3Compare.x) / 2)
                                            y2=@((corner2Compare.y + corner3Compare.y) / 2)>
                                <stop offset="0%" stop-color="rgb(0 0 255 / @((Model.CompareLeaderboard.TechRating / maxRating) * 100)%)" />
                                <stop offset="100%" stop-color="rgb(0 0 255 / @((Model.CompareLeaderboard.TechRating / maxRating) * 25)%)" />
                            </linearGradient>
                            <linearGradient id="fadeB-2"
                                            gradientUnits="userSpaceOnUse"
                                            x1=@(corner3Compare.x)
                                            y1=@(corner3Compare.y)
                                            x2=@((corner1Compare.x + corner2Compare.x) / 2)
                                            y2=@((corner1Compare.y + corner2Compare.y) / 2)>
                                <stop offset="0%" stop-color="rgb(0 255 255 / @((Model.CompareLeaderboard.PassRating / maxRating) * 100)%)" />
                                <stop offset="100%" stop-color="rgb(0 255 255 / @((Model.CompareLeaderboard.PassRating / maxRating) * 25)%)" />
                            </linearGradient>
                            <linearGradient id="fadeC-2"
                                            gradientUnits="userSpaceOnUse"
                                            x1=@(corner2Compare.x)
                                            y1=@(corner2Compare.y)
                                            x2=@((corner3Compare.x + corner1Compare.x) / 2)
                                            y2=@((corner1Compare.y + corner3Compare.y) / 2)>
                                <stop offset="0%" stop-color="rgb(128 128 255 / @((Model.CompareLeaderboard.AccRating / maxRating) * 100)%)" />
                                <stop offset="100%" stop-color="rgb(128 128 255 / @((Model.CompareLeaderboard.AccRating / maxRating) * 25)%)" />
                            </linearGradient>
                        </defs>
                        <g stroke="#FFF" stroke-width="0.5">
                            <path d="M @corner3Compare.x,@corner3Compare.y L @corner1Compare.x,@corner1Compare.y @corner2Compare.x,@corner2Compare.y Z" fill="url(#fadeA-2)" />
                            <path d="M @corner3Compare.x,@corner3Compare.y L @corner1Compare.x,@corner1Compare.y @corner2Compare.x,@corner2Compare.y Z" fill="url(#fadeB-2)" />
                            <path d="M @corner3Compare.x,@corner3Compare.y L @corner1Compare.x,@corner1Compare.y @corner2Compare.x,@corner2Compare.y Z" fill="url(#fadeC-2)" />
                        </g>
                        <g stroke="#FFF" fill="none" stroke-width="2" stroke-dasharray="4">
                            <path d="M 50.000000,0.00000 L 0.000000,86.600000 100.000000,86.600000 Z" />
                        </g>
                    </g>
                </svg>
                <div class="pass">
                    <span>Pass: @(Math.Round(Model.CompareLeaderboard.PassRating, 2)) ★</span>
                </div>
            </div>
            <div class="predicted-acc">Predicted acc: @((Model.CompareLeaderboard.PredictedAcc * 100).ToString("0.00"))%</div>
            <div class="worth-line" title="@worthTitle">@worthLabel: <span class="worth-value @WorthClass(Model.CompareLeaderboard.Worth)">@WorthText(Model.CompareLeaderboard.Worth)</span></div>
            <div class="worth-line" title="@topShareTitle">Top play share: <span class="worth-value @TopShareClass(Model.CompareLeaderboard.TopPlayShareRelative)">@TopShareText(Model.CompareLeaderboard.TopPlayShare, Model.CompareLeaderboard.TopPlayShareRelative)</span></div>
            @if (Model.NjsText(Model.CompareNjs) is string compareNjsText)
            {
                <div class="predicted-acc">@compareNjsText</div>
            }
            @if (Model.CompareLeaderboard.NoteCount > 0)
            {
                <div class="predicted-acc">Notes: @Model.CompareLeaderboard.NoteCount</div>
            }
            <div class="predicted-acc" title="Inlines: a note at most 1/4 beat behind another (either color) in the same column and row, hidden by it (Analyzer). Bomb resets: the Analyzer's bomb avoidances.">Inlines: @Model.CompareLeaderboard.Inlines, bomb resets: @Model.CompareLeaderboard.BombAvoidances.ToString("0")</div>
            @if (MapTags.Of(Model.CompareLeaderboard).Any())
            {
                <div class="map-tags">@MapTags.Badges(Model.CompareLeaderboard)</div>
            }
        </div>
    }
</div>

<div class="curve-section">
    <h4>Acc curve (@(Model.Modifier == "none" ? "no modifier" : Model.Modifier))</h4>
    @if (Model.CurveParams != null)
    {
        var cp = Model.CurveParams;
        var dp = LeaderboardModel.DefaultCurveParams;
        string Param(string name, double value, double def, string format) =>
            Math.Abs(value - def) < 1e-9 ? $"{name} = {value.ToString(format)}" : $"<b>{name} = {value.ToString(format)}</b> (default {def.ToString(format)})";
        <div class="modifier-note curve-params">
            Curve for a predicted acc of @((Model.Leaderboard.PredictedAcc * 100).ToString("0.00"))%:
            @if (cp.A < 0.9995)
            {
                @Html.Raw($"a = {(Math.Max(cp.A, 0.951) * 100).ToString("0.00")}%, c = {cp.C.ToString("0.00")}")
            }
            else
            {
                <span>a = 100% (no taper)</span>
            }
            &middot; middle (60-95%): @Html.Raw(Param("k", cp.K, dp.K, "0.00")), @Html.Raw(Param("w", cp.W, dp.W, "0.00"))
            &middot; upper (95% to a): @Html.Raw(Param("k2", cp.K2, dp.K2, "0.00")), @Html.Raw(Param("p2", cp.P2, dp.P2, "0.00"))
            @if (cp.IsDefault)
            {
                <span>&middot; same as the base curve</span>
            }
        </div>
    }
    @if (!Model.HasOwnCurve)
    {
        <div class="modifier-note">No curve stored for this leaderboard: the base curve is used (run CurvesRefresh.Regenerate).</div>
    }
    <div class="curve-chart-container">
        <canvas id="curveChart"></canvas>
    </div>
</div>

<div class="curve-section">
    <h4>PP curve (@(Model.Modifier == "none" ? "no modifier" : Model.Modifier))</h4>
    <div class="modifier-note">pp at every accuracy with these ratings and this acc curve, its pass / acc / tech parts and the base curve's pp. Scroll to zoom, drag to pan, double click to reset.</div>
    <div class="curve-chart-container pp-chart-container">
        <canvas id="ppChart"></canvas>
    </div>
</div>

<div class="weight-count">
    <span id="weightCount"></span> get pp from it above
    <input id="weightThreshold" type="number" min="0" max="100" step="0.01" value="0" oninput="updateWeightCount()" /> % weight,
    with <input id="minRankedPlays" type="number" min="0" step="1" value="75" oninput="updateWeightCount()" /> ranked plays minimum
    <span class="modifier-note">(the weight their profile shows, rounded to 0.01%: 0 = it still shows above 0.00%, about their top 280 plays)</span>
    @if (Model.CompareLeaderboard != null)
    {
        <div><span id="compareWeightCount"></span> on the second leaderboard</div>
    }
</div>

<div class="weight-count chart-filter">
    Scores of players with
    <input id="chartMinPlays" type="number" min="0" step="1" value="0" oninput="updateAxes()" /> to
    <input id="chartMaxPlays" type="number" min="0" step="1" placeholder="any" oninput="updateAxes()" /> ranked plays
    <span id="chartCount" class="modifier-note"></span>
</div>
<div class="chart-container">
    <div class="x-selector">
        <select id="xAxisSelect" onchange="updateAxes()">
            <option value="playerRank">Player Rank</option>
            <option value="date">Date</option>
            <option value="pp">PP</option>
            <option value="acc">Accuracy</option>
            <option value="fcAcc">FC Accuracy</option>
            <option value="pauses">Pause Count</option>
            <option value="rank">Leaderboard Rank</option>
            <option value="maxStreak">Streak Length</option>
            <option value="mistakes">Mistake Count</option>
            <option value="weight">PP Weight</option>
            <option value="weightedPp">Weighted PP</option>
        </select>
    </div>
    <div class="y-selector">
        <select id="yAxisSelect" onchange="updateAxes()">
            <option value="weight">PP Weight</option>
            <option value="playerRank">Player Rank</option>
            <option value="date">Date</option>
            <option value="pp">PP</option>
            <option value="acc">Accuracy</option>
            <option value="fcAcc">FC Accuracy</option>
            <option value="pauses">Pause Count</option>
            <option value="rank">Leaderboard Rank</option>
            <option value="maxStreak">Streak Length</option>
            <option value="mistakes">Mistake Count</option>
            <option value="weightedPp">Weighted PP</option>
        </select>
    </div>
    <canvas id="scoreChart"></canvas>
    <div id="loading" style="display: none;">Loading...</div>
</div>

<div class="tables-container">
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>PP</th>
                    <th>Accuracy</th>
                    <th>Mods</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var score in Model.Scores)
                {
                    <tr>
                        <td><a asp-page="/Player" asp-route-id="@score.Player.Id">@score.Player.Name</a></td>
                        <td>@score.Pp</td>
                        <td>@score.Accuracy</td>
                        <td>@score.Modifiers</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Score navigation">
            <ul class="pagination">
                @{
                    int firstPageToShow = Model.CurrentPage - 5;
                    int lastPageToShow = Model.CurrentPage + 4;
                    if (firstPageToShow < 1)
                    {
                        firstPageToShow = 1;
                        lastPageToShow = 10;
                    }
                    if (lastPageToShow > Model.TotalPages)
                    {
                        lastPageToShow = Model.TotalPages;
                        firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
                    }

                    for (int i = firstPageToShow; i <= lastPageToShow; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="./Leaderboard" asp-route-id="@Model.Leaderboard.Id" asp-route-compareId="@Model.CompareLeaderboard?.Id" asp-route-currentPage="@i" asp-route-modifier="@Model.Modifier" asp-route-db="@dbQuery">@i</a>
                        </li>
                    }
                }
            </ul>
        </nav>
    </div>

    @if (Model.CompareLeaderboard != null)
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>PP</th>
                        <th>Accuracy</th>
                        <th>Mods</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var score in Model.CompareScores)
                    {
                        <tr>
                            <td><a asp-page="/Player" asp-route-id="@score.Player.Id">@score.Player.Name</a></td>
                            <td>@score.Pp</td>
                            <td>@score.Accuracy</td>
                            <td>@score.Modifiers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    static string WorthText(float? worth) => worth is float w ? w.ToString("+0.0%;-0.0%;0.0%", System.Globalization.CultureInfo.InvariantCulture) : "—";
    static string WorthClass(float? worth) => worth is float w ? (w > 0.005f ? "worth-up" : w < -0.005f ? "worth-down" : "") : "";
    static string TopShareText(float? share, float? relative) => share is float s && relative is float r ? FormattableString.Invariant($"{s * 100:0.0}% (x{r:0.0})") : "—";
    static string TopShareClass(float? relative) => relative > portaBLe.Refresh.AccReweighter.TopPlayShareRatio ? "worth-up" : "";
}

<style>
    .modifier-selector {
        display: flex;
        gap: 0.5em;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1em;
    }

    .modifier-note {
        font-size: 0.8em;
        opacity: 0.7;
    }

    .predicted-acc {
        text-align: center;
        font-size: 0.85em;
        margin-top: 0.3em;
    }

    .curve-section {
        max-width: 900px;
        margin: 1.5em auto;
    }

    .curve-chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }

    .pp-chart-container {
        height: 360px;
    }

    .lb-header {
        display: flex;
        align-items: center;
        gap: 0.75em;
        justify-content: center;
    }

    .lb-header h2 {
        margin: 0;
    }

    .lb-cover {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
    }

    .difficulty-selector {
        display: flex;
        gap: 0.4em;
        justify-content: center;
        flex-wrap: wrap;
        margin: 0.6em 0;
    }

    .difficulty-pill {
        padding: 0.15em 0.7em;
        border-radius: 1em;
        border: 1px solid rgba(128, 128, 128, 0.6);
        font-size: 0.85em;
        text-decoration: none;
    }

    .difficulty-pill.active {
        background-color: rgb(75, 192, 192);
        border-color: rgb(75, 192, 192);
        color: #000;
        font-weight: 600;
    }

    .worth-line {
        text-align: center;
        font-size: 1em;
        font-weight: 600;
        margin-top: 0.4em;
    }

    .worth-up {
        color: rgb(46, 160, 67);
    }

    .worth-down {
        color: rgb(218, 54, 51);
    }

    .weight-count {
        text-align: center;
        margin-top: 1.5em;
    }

    .weight-count input {
        width: 4.5em;
    }

    .chart-filter {
        margin-top: 1em;
    }

    .leaderboard-comparison {
        display: flex;
        gap: 2em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .leaderboard-container {
        flex: 1;
        min-width: 300px;
        max-width: 500px;
    }

    .tables-container {
        display: flex;
        gap: 2em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .table-wrapper {
        flex: 1;
        min-width: 300px;
        max-width: 500px;
    }

    .triangle-container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 15em;
        background-color: #323232;
        padding: 1em;
        margin: 0 auto;
    }

    .tech-and-acc {
        color: white;
        display: flex;
        grid-gap: 4em;
        font-size: 0.8em;
    }

    .pass {
        color: white;
        font-size: 0.8em;
