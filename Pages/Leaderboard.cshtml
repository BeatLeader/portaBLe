    }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
        margin: 20px 0;
    }

    .x-selector {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
    }

    .y-selector {
        position: absolute;
        left: -20px;
        top: 60%;
        transform: translateY(-50%) rotate(-90deg);
        transform-origin: left center;
        z-index: 1;
    }

    #loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom"></script>
    <script>
        let chart = null;
        const leaderboardId = '@Model.Leaderboard.Id';
        const compareLeaderboardId = '@Model.CompareLeaderboard?.Id';

        const totalScores = '@Model.TotalScores';
        const compareTotalScores = '@Model.CompareTotalScores';
        let currentPlayerId = null;
        const leaderboardScores = @Html.Raw(JsonSerializer.Serialize(Model.ScoreGraphEntries));
        const compareLeaderboardScores = @Html.Raw(JsonSerializer.Serialize(Model.CompareScoreGraphEntries ?? new LeaderboardModel.ScoreGraphEntry[] { }));

        const curvePoints = @Html.Raw(JsonSerializer.Serialize(Model.CurvePoints));
        const baseCurvePoints = @Html.Raw(JsonSerializer.Serialize(Model.BaseCurvePoints));
        const curvePredicted = @Html.Raw(JsonSerializer.Serialize(Model.Leaderboard.PredictedAcc > 0 ? Model.Leaderboard.PredictedAcc * 100 : (double?)null));
        const curveStart = @Html.Raw(JsonSerializer.Serialize(Model.CurveStart));
        const ppCurve = @Html.Raw(JsonSerializer.Serialize(Model.PpCurve));
        const basePpCurve = @Html.Raw(JsonSerializer.Serialize(Model.BasePpCurve));
        const comparePpCurve = @Html.Raw(JsonSerializer.Serialize(Model.ComparePpCurve));

        // Lowest and highest value of the visible datasets between the x axis' ends, the lines' values at the ends included
        // (interpolated), so a line doesn't leave the chart between its last point in view and the edge. Null when none.
        function visibleRange(chart) {
            const { min, max } = chart.scales.x;
            let lo = Infinity, hi = -Infinity;
            const add = y => { if (y < lo) lo = y; if (y > hi) hi = y; };
            chart.data.datasets.forEach((d, i) => {
                if (!chart.isDatasetVisible(i)) return;
                const line = d.type !== 'scatter';
                d.data.forEach((p, j) => {
                    if (p.x >= min && p.x <= max) add(p.y);
                    const q = line ? d.data[j + 1] : null;
                    if (q) for (const edge of [min, max]) {
                        if (p.x < edge && q.x > edge) add(p.y + (edge - p.x) / (q.x - p.x) * (q.y - p.y));
                    }
                });
            });
            return hi >= lo ? { lo, hi } : null;
        }

        // pp over the whole accuracy range (with zoom), its parts and the base curve's pp
        function drawPpChart() {
            const canvas = document.getElementById('ppChart');
            if (!canvas || !ppCurve.length) return;
            const line = (i) => ppCurve.map(p => ({ x: p[0], y: p[i] }));
            // From the 2nd percentile of the scores' accuracy (a few very low scores would squeeze the rest), the rest by panning
            const accs = leaderboardScores.map(s => s.accuracy).sort((a, b) => a - b);
            const lowest = accs.length ? accs[Math.floor(accs.length * 0.02)] : (curvePredicted ?? 90) - 5;
            const minX = Math.max(0, Math.floor(Math.min(lowest, curvePredicted ?? 100) - 1));
            // y up to the highest line in view
            const fitY = chart => {
                const range = visibleRange(chart);
                chart.options.scales.y.max = range && range.hi > 0 ? Math.ceil(range.hi * 1.05) : undefined;
                chart.update('none');
            };
            const datasets = [
                { label: 'PP', data: line(1), borderColor: 'rgb(75, 192, 192)', backgroundColor: 'rgba(75, 192, 192, 0.15)', pointRadius: 0, borderWidth: 2.5, tension: 0 },
                { label: 'Pass pp', data: line(2), borderColor: 'rgb(54, 162, 235)', pointRadius: 0, borderWidth: 1, borderDash: [4, 3], tension: 0 },
                { label: 'Acc pp', data: line(3), borderColor: 'rgb(153, 102, 255)', pointRadius: 0, borderWidth: 1, borderDash: [4, 3], tension: 0 },
                { label: 'Tech pp', data: line(4), borderColor: 'rgb(255, 99, 132)', pointRadius: 0, borderWidth: 1, borderDash: [4, 3], tension: 0 },
                { label: 'PP (base curve)', data: basePpCurve.map(p => ({ x: p[0], y: p[1] })), borderColor: 'rgba(200, 200, 200, 0.8)', pointRadius: 0, borderWidth: 1, borderDash: [6, 4], tension: 0, hidden: true },
            ];
            if (comparePpCurve) {
                datasets.push({ label: 'PP (second leaderboard)', data: comparePpCurve.map(p => ({ x: p[0], y: p[1] })), borderColor: 'rgb(255, 159, 64)', pointRadius: 0, borderWidth: 2, tension: 0 });
            }

            const ppChart = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: { datasets },
                options: {
                    maintainAspectRatio: false,
                    interaction: { mode: 'nearest', axis: 'x', intersect: false },
                    scales: {
                        x: { type: 'linear', min: minX, max: 100, title: { display: true, text: 'Accuracy (%)' } },
                        y: { min: 0, title: { display: true, text: 'PP' } }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                title: items => items.length ? formatNumber(items[0].parsed.x, 2) + '%' : '',
                                label: ctx => `${ctx.dataset.label}: ${formatNumber(ctx.parsed.y, 2)}pp`
                            }
                        },
                        zoom: {
                            zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x', onZoomComplete: ({ chart }) => fitY(chart) },
                            pan: { enabled: true, mode: 'x', onPanComplete: ({ chart }) => fitY(chart) },
                            limits: { x: { min: 0, max: 100, minRange: 0.1 } }
                        }
                    }
                }
            });
            canvas.ondblclick = () => { ppChart.resetZoom(); fitY(ppChart); };
            fitY(ppChart);
        }

        // How many players get pp from it above the weight threshold, the weight read as profiles show it (%, 2 decimals):
        // 0 = anything shown above 0.00%. Only players with at least the minimum ranked plays count, in both counts.
        function updateWeightCount() {
            const threshold = Math.max(0, Number(document.getElementById('weightThreshold').value) || 0);
            const minPlays = Math.max(0, Number(document.getElementById('minRankedPlays').value) || 0);
            const count = (scores, id) => {
                const el = document.getElementById(id);
                if (!el) return;
                const players = scores.filter(s => s.playerRankedPlays >= minPlays);
                const above = players.filter(s => Math.round(s.weight * 10000) / 100 > threshold).length;
                el.textContent = `${above.toLocaleString()} players out of ${players.length.toLocaleString()}`;
            };
            count(leaderboardScores, 'weightCount');
            count(compareLeaderboardScores, 'compareWeightCount');
        }

        function drawCurveChart() {
            const canvas = document.getElementById('curveChart');
            if (!canvas) return;
            const toXY = pts => pts.map(p => ({ x: p[0], y: p[1] }));
            const curveAt = x => {
                for (let i = 1; i < curvePoints.length; i++) {
                    if (curvePoints[i][0] >= x) {
                        const [x0, y0] = curvePoints[i - 1], [x1, y1] = curvePoints[i];
                        return y0 + (x - x0) / (x1 - x0) * (y1 - y0);
                    }
                }
                return curvePoints.length ? curvePoints[curvePoints.length - 1][1] : 0;
            };
            const markers = [];
            if (curvePredicted !== null) markers.push({ x: curvePredicted, y: curveAt(curvePredicted), label: 'Predicted acc' });
            if (curveStart !== null && curveStart < 100) markers.push({ x: curveStart, y: curveAt(curveStart), label: 'Taper start (A)' });
            const minX = curvePredicted !== null ? Math.max(60, Math.floor(curvePredicted) - 4) : 90;

            // y over the lines and markers in view
            const fitY = chart => {
                const range = visibleRange(chart);
                const pad = range ? (range.hi - range.lo) * 0.05 || 0.01 : 0;
                chart.options.scales.y.min = range ? range.lo - pad : undefined;
                chart.options.scales.y.max = range ? range.hi + pad : undefined;
                chart.update('none');
            };

            const curveChart = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    datasets: [
                        {
                            label: 'This curve',
                            data: toXY(curvePoints),
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            pointRadius: 0,
                            borderWidth: 2,
                            tension: 0,
                        },
                        {
                            label: 'Base curve',
                            data: toXY(baseCurvePoints),
                            borderColor: 'rgba(200, 200, 200, 0.8)',
                            borderDash: [6, 4],
                            pointRadius: 0,
                            borderWidth: 1,
                            tension: 0,
                        },
                        {
                            type: 'scatter',
                            label: 'Predicted acc / taper start',
                            data: markers,
                            borderColor: 'rgb(255, 205, 86)',
                            backgroundColor: 'rgb(255, 205, 86)',
                            pointRadius: 5,
                        },
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    parsing: true,
                    scales: {
                        x: { type: 'linear', min: minX, max: 100, title: { display: true, text: 'Accuracy (%)' } },
                        y: { title: { display: true, text: 'Curve value (acc pp multiplier)' } }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: ctx => (ctx.raw && ctx.raw.label ? ctx.raw.label + ': ' : ctx.dataset.label + ': ') +
                                    formatNumber(ctx.parsed.x, 2) + '% → ' + formatNumber(ctx.parsed.y, 3)
                            }
                        },
                        zoom: {
                            zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x', onZoomComplete: ({ chart }) => fitY(chart) },
                            pan: { enabled: true, mode: 'x', onPanComplete: ({ chart }) => fitY(chart) },
                            limits: { x: { min: 0, max: 100, minRange: 0.1 } }
                        }
                    }
                }
            });
            canvas.ondblclick = () => { curveChart.resetZoom(); fitY(curveChart); };
            fitY(curveChart);
        }

        function formatNumber(num, decimals) {
            return Number(num).toFixed(decimals);
        }

        function roundToPrecision(num, precision) {
            return Math.round(num / precision) * precision;
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString();
        }

        function formatDateRelative(date) {
            const diff = (new Date() - date) / 1000;
            if (diff < 60) return 'just now';
            if (diff < 3600) return Math.floor(diff / 60) + ' minutes ago';
            if (diff < 86400) return Math.floor(diff / 3600) + ' hours ago';
            return Math.floor(diff / 86400) + ' days ago';
        }

        const freshScoreAgeMillis = 0;
        const oldScoreAgeMillis = 1000 * 60 * 60 * 24 * 30 * 8; //~8 months
        const freshScoreBrightness = 255;
        const oldScoreBrightness = 128;

        function getTimeStringColor(timeSet) {
            if (!timeSet) return '#ffffff';
            const scoreAgeMillis = new Date().getTime() - timeSet.getTime();
            let ratio = (scoreAgeMillis - freshScoreAgeMillis) / (oldScoreAgeMillis - freshScoreAgeMillis);
            if (ratio < 0) ratio = 0;
            if (ratio > 1) ratio = 1;
            ratio = Math.pow(1 - ratio, 3);
            const brightnessInt = (oldScoreBrightness + (freshScoreBrightness - oldScoreBrightness) * ratio) | 0;
            const brightnessHex = brightnessInt.toString(16);
            return '#' + brightnessHex + brightnessHex + brightnessHex;
        }

        function sortByToAxisName(sortBy) {
            switch (sortBy) {
                case 'date': return 'Date';
                case 'pp': return 'Pp';
                case 'acc': return 'Accuracy';
                case 'fcAcc': return 'FC Accuracy';
                case 'pauses': return 'Pause Count';
                case 'rank': return 'Leaderboard Rank';
                case 'maxStreak': return 'Streak length';
                case 'mistakes': return 'Mistake Count';
                case 'weight': return 'PP Weight';
                case 'weightedPp': return 'Weighted PP';
                case 'playerRank': return 'Player Rank';
            }
            return null;
        }

        function valueFromSortBy(score, sortBy, isCompare) {
            if (!score) return null;
            switch (sortBy) {
                case 'date': return score.timepost ? new Date(score.timepost * 1000) : null;
                case 'pp': return score.pp;
                case 'acc': return 100 - score.accuracy;
                case 'fcAcc': return 100 - score.fcAcc;
                case 'pauses': return score.pauses;
                case 'rank': return (score.rank / (isCompare ? compareTotalScores : totalScores)) * 100;
                case 'maxStreak': return score.maxStreak;
                case 'mistakes': return score.mistakes;
                case 'weight': return score.weight * 100;
                case 'weightedPp': return score.weight * score.pp;
                case 'playerRank': return score.playerRank;
            }
            return null;
        }

        function sortByToNullable(sortBy) {
            switch (sortBy) {
                case 'date':
                case 'pp':
                case 'acc':
                case 'rank':
                case 'weight':
                case 'weightedPp':
                    return false;
            }
            return true;
        }

        function sortByToTicks(sortBy) {
            switch (sortBy) {
                case 'date':
                    return {
                        autoSkip: true,
                        major: {
                            enabled: true,
                        },
                        callback: val => formatDate(val),
                    };
                case 'pp':
                    return {
                        callback: val => formatNumber(val, 2) + 'pp',
                    };
                case 'acc':
                case 'fcAcc':
                    return {
                        max: 100,
                        callback: val => formatNumber(100 - val, 2) + '%',
                    };
                case 'rank':
                    return {
                        callback: val => formatNumber(val, 0),
                    };
                case 'pauses':
                case 'maxStreak':
                case 'mistakes':
                    return {
                        callback: val => formatNumber(val, 0),
                    };
                case 'weight':
                    return {
                        max: 100,
                        callback: val => formatNumber(val, 0) + '%',
                    };
                case 'weightedPp':
                    return {
                        max: 100,
                        callback: val => formatNumber(val, 2) + 'pp',
                    };
                case 'playerRank':
                    return {
                        min: 0,
                        stepSize: 1000,
                        callback: val => '#' + formatNumber(val, 0),
                    };
            }
            return null;
        }

        // The chart's ranked plays filter (min, max; max null = no limit), kept in the URL so it survives a reload
        function chartPlaysFilter() {
            const min = Math.max(0, Number(document.getElementById('chartMinPlays').value) || 0);
            const maxText = document.getElementById('chartMaxPlays').value;
            const max = maxText === '' ? null : Math.max(0, Number(maxText) || 0);
            const url = new URL(window.location.href);
            if (min > 0) url.searchParams.set('chartMinPlays', min); else url.searchParams.delete('chartMinPlays');
            if (max !== null) url.searchParams.set('chartMaxPlays', max); else url.searchParams.delete('chartMaxPlays');
            window.history.replaceState({}, '', url);
            return { min, max };
        }
        function playsOk(s, filter) {
            const plays = s?.playerRankedPlays ?? 0;
            return plays >= filter.min && (filter.max === null || plays <= filter.max);
        }

        function setupChart(scores, compareScores, xAxis = 'playerRank', yAxis = 'weight') {
            if (!scores?.length) return;
            const playsFilter = chartPlaysFilter();

            const ctx = document.getElementById('scoreChart').getContext('2d');
            const isXNullable = sortByToNullable(xAxis);
            const isYNullable = sortByToNullable(yAxis);

            function processScores(scores, isCompare = false) {
                return scores
                    .filter(s => !!s?.playerRank && playsOk(s, playsFilter))
                    .map(s => {
                        const xValue = valueFromSortBy(s, xAxis, isCompare);
                        if (!xValue && !isXNullable) return null;

                        const yValue = valueFromSortBy(s, yAxis, isCompare);
                        if (!yValue && !isYNullable) return null;

                        return {
                            x: xValue,
                            y: yValue,
                            mods: s?.modifiers?.length ? s.modifiers.split(',') : null,
                            isCompare,
                            ...s,
                        };
                    })
                    .filter(s => s !== null);
            }

            const chartData = processScores(scores);
            const compareChartData = compareScores?.length ? processScores(compareScores, true) : [];
            const shown = (all, kept) => `${kept.length.toLocaleString()} of ${all.filter(s => !!s?.playerRank).length.toLocaleString()}`;
            document.getElementById('chartCount').textContent = `(${shown(scores, chartData)} scores shown`
                + (compareScores?.length ? `, ${shown(compareScores, compareChartData)} on the second leaderboard` : '') + ')';

            const options = {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: {
                        right: 0,
                    },
                },
                interaction: {
                    mode: 'nearest',
                    intersect: true,
                },
                plugins: {
                    legend: {
                        display: true,
                    },
                    tooltip: {
                        displayColors: false,
                        position: 'nearest',
                        callbacks: {
                            label: function(context) {
                                if (!context || !context?.raw) return '';
                                const score = context.raw;
                                return [
                                    formatDate(score.timepost * 1000),
                                    `${score.playerName} - #${formatNumber(score.playerRank, 0)}`
                                ];
                            },
                            title: function(context) {
                                if (!context?.[0]?.raw) return '';
                                const score = context[0].raw;
                                const mods = score?.mods ?? null;
                                const acc = formatNumber(score?.accuracy ?? 0, 2);
                                const xValue = score?.x ?? 0;
                                const yValue = score?.y ?? 0;
                                return `${sortByToAxisName(xAxis)}: ${(sortByToTicks(xAxis).callback)(xValue)} | ${sortByToAxisName(yAxis)}: ${(sortByToTicks(yAxis).callback)(yValue)} | Acc: ${acc}% ${mods?.length ? ' (' + mods.join(', ') + ')' : ''}`;
                            }
                        }
                    },
                    zoom: {
                        pan: {
                            enabled: true,
                            mode: 'xy'
                        },
                        zoom: {
                            wheel: { enabled: true },
                            pinch: { enabled: true },
                            mode: 'xy'
                        }
                    }
                },
                scales: {
                    x: {
                        type: xAxis === 'date' ? 'time' : (xAxis === 'acc' || xAxis === 'rank' || xAxis === 'fcAcc') ? 'linear' : 'logarithmic',
                        title: {
                            display: true,
                            text: sortByToAxisName(xAxis)
                        },
                        ticks: sortByToTicks(xAxis)
                    },
                    y: {
                        type: yAxis === 'date' ? 'time' : (yAxis === 'acc' || yAxis === 'fcAcc') ? 'logarithmic' : 'linear',
                        reverse: yAxis === 'acc' || yAxis === 'fcAcc',
                        ticks: sortByToTicks(yAxis),
                        grid: {
                            color: 'rgba(0,0,0,0.1)',
                            display: true,
                            drawBorder: true,
                            drawOnChartArea: true
                        }
                    }
                },
                onHover: function(event, elements) {
                    const element = elements?.[0]?.element?.$context?.raw;
                    if (!element?.playerId) {
                        event.native.target.style.cursor = 'default';
                    } else {
                        event.native.target.style.cursor = 'pointer';
                    }
                },
                onClick: function(event, elements) {
                    const element = elements?.[0]?.element?.$context?.raw;
                    if (!element?.playerId) return;
                    window.open(`/player/${element.playerId}`, '_blank');
                }
            };

            if (chart) {
                chart.destroy();
            }

            const datasets = [{
                label: 'Leaderboard 1',
                data: chartData,
                borderColor: function(context) {
                    const item = context.raw;
                    return item.fc
                        ? 'yellow'
                        : getTimeStringColor(new Date(item.timepost * 1000));
                },
                backgroundColor: '#f54278',
                pointRadius: 4,
                borderWidth: function(context) {
                    const item = context.raw;
                    return item.fc
                        ? 2
                        : 1;
                },
                pointHoverRadius: 5
            }];

            if (compareChartData.length > 0) {
                datasets.push({
                    label: 'Leaderboard 2',
                    data: compareChartData,
                    borderColor: function(context) {
                        const item = context.raw;
                        return item.fc
                            ? 'yellow'
                            : getTimeStringColor(new Date(item.timepost * 1000));
                    },
                    backgroundColor: '#0000ff',
                    pointRadius: 4,
                    borderWidth: function(context) {
                        const item = context.raw;
                        return item.fc
                            ? 2
                            : 1;
                    },
                    pointHoverRadius: 5
                });
            }
            chart = new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets
                },
                options: options
            });
        }

        function updateAxes() {
            const xValue = document.getElementById('xAxisSelect').value;
            const yValue = document.getElementById('yAxisSelect').value;
            setupChart(leaderboardScores, compareLeaderboardScores, xValue, yValue);
        }

        // The chart's ranked plays filter from the URL (?chartMinPlays=&chartMaxPlays=)
        {
            const params = new URLSearchParams(window.location.search);
            if (params.has('chartMinPlays')) document.getElementById('chartMinPlays').value = params.get('chartMinPlays');
            if (params.has('chartMaxPlays')) document.getElementById('chartMaxPlays').value = params.get('chartMaxPlays');
        }
        setupChart(leaderboardScores, compareLeaderboardScores);
        drawCurveChart();
        drawPpChart();
        updateWeightCount();
    </script>
}
