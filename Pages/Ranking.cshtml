@page
@model RankingModel

<h2>Player Rankings</h2>

<div class="mb-3">
    <form method="get" class="form-inline">
        @if (!string.IsNullOrEmpty(Model.SelectedDatabase))
        {
            <input type="hidden" name="db" value="@Model.SelectedDatabase" />
        }
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="sortBy" class="form-label">Sort By:</label>
                <select name="sortBy" id="sortBy" class="form-select" onchange="this.form.submit()">
                    <option value="rank" selected="@(Model.SortBy == "rank" || string.IsNullOrEmpty(Model.SortBy))">Player Rank</option>
                    <option value="topPP" selected="@(Model.SortBy == "topPP")">Top PP</option>
                    <option value="accPP" selected="@(Model.SortBy == "accPP")">Total Acc PP</option>
                    <option value="passPP" selected="@(Model.SortBy == "passPP")">Total Pass PP</option>
                    <option value="techPP" selected="@(Model.SortBy == "techPP")">Total Tech PP</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label d-block" title="Click a style to include it, again to exclude it, again to clear it. Players with any included style (Acc to High Tech), Modifiers when included, and no excluded one">Style:</label>
                <input type="hidden" name="style" id="style" value="@Model.Style" />
                @{ var (includedStyles, excludedStyles) = portaBLe.Services.PlayerStyles.ParseKeys(Model.Style); }
                @foreach (var style in portaBLe.Services.PlayerStyles.All)
                {
                    var state = includedStyles.Contains(style.Key) ? "in" : excludedStyles.Contains(style.Key) ? "out" : "";
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 style-toggle" data-style="@style.Key" data-state="@state" data-label="@style.Label" title="@style.Tooltip">@style.Label</button>
                }
            </div>
            <div class="col-auto" style="flex-grow: 1; max-width: 500px;">
                <label for="searchString" class="form-label">Search:</label>
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           id="searchString"
                           value="@Model.SearchString"
                           class="form-control"
                           placeholder="Search players by name..."
                           aria-label="Search players" />
                    @if (!string.IsNullOrEmpty(Model.SearchString))
                    {
                        <a asp-page="./Ranking" asp-route-sortBy="@Model.SortBy" asp-route-style="@Model.Style" asp-route-db="@Model.SelectedDatabase" class="btn btn-secondary">Clear</a>
                    }
                </div>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.SearchString))
    {
        <small class="text-muted mt-2 d-block">
            Found @Model.Players.Count result(s) for "@Model.SearchString"
        </small>
    }
</div>

<table class="table">
    <thead>
        <tr>
            <th>Rank</th>
            <th>Name</th>
            <th title="From the maps of the top @(portaBLe.Services.PlayerStyles.TopShare.ToString("P0")) of ranked plays, by weighted pp">Style</th>
            <th>Country</th>
            <th>Total PP</th>
            <th>Top PP</th>
            <th title="Top scores above the first drop of over @(RankingModel.OutlierThreshold)% to the next score (top 10 scores, players with 100+ scores)">Outliers</th>
            @if (Model.ShowsPartColumn)
            {
                <th>@Model.GetSortColumnHeader()</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model.Players)
        {

            <tr>
                <td>@player.Rank</td>
                <td><a asp-page="/Player" asp-route-id="@player.Id">@player.Name</a></td>
                <td>@portaBLe.Services.PlayerStyles.Badges(Model.GetStyle(player))</td>
                <td>@player.Country</td>
                <td>@player.Pp.ToString("F2")</td>
                <td>@player.TopPp.ToString("F2")</td>
                <td>@Model.GetOutlierCount(player)</td>
                @if (Model.ShowsPartColumn)
                {
                    <td>@Model.GetSortColumnValue(player).ToString("F2")</td>
                }
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Player ranking navigation">
    <ul class="pagination">
        @{
            int firstPageToShow = Model.CurrentPage - 5;
            int lastPageToShow = Model.CurrentPage + 4;
            if (firstPageToShow < 1)
            {
                firstPageToShow = 1;
                lastPageToShow = 10;
            }
            if (lastPageToShow > Model.TotalPages)
            {
                lastPageToShow = Model.TotalPages;
                firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
            }

            for (int i = firstPageToShow; i <= lastPageToShow; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Ranking"
                       asp-route-currentPage="@i"
                       asp-route-searchString="@Model.SearchString"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-style="@Model.Style"
                       asp-route-db="@Model.SelectedDatabase">@i</a>
                </li>
            }
        }
    </ul>
</nav>

@section Scripts {
    <script>
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Search as you type, once typing pauses
        const searchInput = document.getElementById('searchString');
        if (searchInput) {
            const debouncedSubmit = debounce(() => {
                searchInput.form.submit();
            }, 500);

            searchInput.addEventListener('input', debouncedSubmit);
        }

        // Style toggles: off -> included -> excluded -> off, applied once clicking pauses (back to page 1)
        const styleInput = document.getElementById('style');
        function showStyleState(button) {
            const state = button.dataset.state;
            button.className = 'btn btn-sm me-1 style-toggle ' + (state === 'in' ? 'btn-success' : state === 'out' ? 'btn-danger' : 'btn-outline-secondary');
            button.textContent = (state === 'in' ? '+ ' : state === 'out' ? '- ' : '') + button.dataset.label;
        }
        const debouncedStyleSubmit = debounce(() => {
            styleInput.value = [...document.querySelectorAll('.style-toggle')].filter(b => b.dataset.state)
                .map(b => (b.dataset.state === 'out' ? '-' : '') + b.dataset.style).join(',');
            styleInput.form.submit();
        }, 700);
        document.querySelectorAll('.style-toggle').forEach(button => {
            showStyleState(button);
            button.addEventListener('click', () => {
                button.dataset.state = button.dataset.state === 'in' ? 'out' : button.dataset.state === 'out' ? '' : 'in';
                showStyleState(button);
                debouncedStyleSubmit();
            });
        });
    </script>
}
