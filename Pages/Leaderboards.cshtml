@page
@model LeaderboardsModel

<h2>Leaderboards</h2>

<form method="get">
    <div class="search-filter-container">
        <input type="text" name="SearchString" value="@Model.SearchString" placeholder="Search leaderboards" />
        <select name="TagFilter" id="tagFilter" onchange="this.form.submit()">
            @{
                var isAllSelected = string.IsNullOrEmpty(Model.TagFilter) || Model.TagFilter == "all";
                var isLinearSelected = Model.TagFilter == "linear";
                var isFitbeatSelected = Model.TagFilter == "fitbeat";
            }
            <option value="all" selected="@isAllSelected">All Tags</option>
            <option value="linear" selected="@isLinearSelected">Linear</option>
            <option value="fitbeat" selected="@isFitbeatSelected">Fitbeat</option>
        </select>
        <input type="submit" value="Search" />
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>---</th>
            <th>
                <a asp-page="./Leaderboards" asp-route-sortDescending="@(Model.SortDescending ? "false" : "true")">Stars</a>
            </th>
            <th>Name</th>
            <th>Diff</th>
            <th>Mapper</th>
            <th>Tags</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var leaderboard in Model.Leaderboards)
        {
            <tr>
                <td><img class="lb-cover" src="@leaderboard.Cover" /></td>
                <td>@leaderboard.Stars</td>
                <td><a asp-page="/Leaderboard" asp-route-id="@leaderboard.Id">@leaderboard.Name</a></td>
                <td>@leaderboard.DifficultyName</td>
                <td>@leaderboard.Mapper</td>
                <td>
                    @if (leaderboard.IsLinear)
                    {
                        <span class="tag linear-tag">Linear</span>
                    }
                    @if (leaderboard.IsFitbeat)
                    {
                        <span class="tag fitbeat-tag">Fitbeat</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @{
            int firstPageToShow = Model.CurrentPage - 5;
            int lastPageToShow = Model.CurrentPage + 4;
            if (firstPageToShow < 1)
            {
                firstPageToShow = 1;
                lastPageToShow = 10;
            }
            if (lastPageToShow > Model.TotalPages)
            {
                lastPageToShow = Model.TotalPages;
                firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
            }

            for (int i = firstPageToShow; i <= lastPageToShow; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-page="./Leaderboards" asp-route-currentPage="@i" asp-route-sortDescending="@Model.SortDescending" asp-route-searchString="@Model.SearchString" asp-route-tagFilter="@Model.TagFilter">@i</a>
                </li>
            }
        }
    </ul>
</nav>

<style>
    .lb-cover {
        width: 3em;
        height: 3em;
    }

    .search-filter-container {
        display: flex;
        gap: 0.5em;
        margin-bottom: 1em;
    }

    .search-filter-container input[type="text"],
    .search-filter-container select,
    .search-filter-container input[type="submit"] {
        padding: 0.5em;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .tag {
        display: inline-block;
        padding: 0.25em 0.75em;
        border-radius: 12px;
        font-size: 0.85em;
        font-weight: 500;
        margin-right: 0.5em;
    }

    .linear-tag {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .fitbeat-tag {
        background-color: #fce4ec;
        color: #c2185b;
    }
</style>

