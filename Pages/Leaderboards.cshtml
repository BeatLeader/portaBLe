@page
@model LeaderboardsModel

<div class="lb-header">
    <h2>Leaderboards</h2>
    <span class="text-muted small">@Model.TotalRecords maps</span>
</div>

<form method="get" class="lb-filters" id="leaderboardsForm">
    @if (!string.IsNullOrEmpty(Model.SelectedDatabase))
    {
        <input type="hidden" name="db" value="@Model.SelectedDatabase" />
    }
    <input type="hidden" name="SortBy" value="@Model.SortBy" />
    <input type="hidden" name="SortDescending" value="@(Model.SortDescending ? "true" : "false")" />
    <input type="search" name="SearchString" id="searchString" class="form-control form-control-sm lb-search" value="@Model.SearchString" placeholder="Song or mapper..." />
    <select name="ModeName" id="modeName" class="form-select form-select-sm lb-mode" onchange="this.form.submit()">
        <option value="">All characteristics</option>
        @foreach (var mode in Model.ModeNames)
        {
            <option value="@mode" selected="@(Model.ModeName == mode)">@mode</option>
        }
    </select>
    <select name="Modifier" id="modifier" class="form-select form-select-sm lb-mode" title="Speed modifier: stars, ratings and worth with it" onchange="this.form.submit()">
        <option value="" selected="@(Model.Modifier == null)">No speed modifier</option>
        @foreach (var m in LeaderboardsModel.Modifiers)
        {
            <option value="@m" selected="@(Model.Modifier == m)">@m</option>
        }
    </select>
    <select name="Tag" id="tag" class="form-select form-select-sm lb-mode" title="Map tag" onchange="this.form.submit()">
        <option value="" selected="@(Model.Tag == null)">All tags</option>
        @foreach (var t in MapTags.All)
        {
            <option value="@t.Key" selected="@(Model.Tag == t.Key)">@t.Label</option>
        }
    </select>
    <div class="lb-range">
        <select name="RangeBy" id="rangeBy" class="form-select form-select-sm lb-mode" onchange="if (this.form.RangeMin.value || this.form.RangeMax.value) this.form.submit()">
            <option value="Stars" selected="@(Model.RangeBy is not ("PassRating" or "AccRating" or "TechRating"))">Stars</option>
            <option value="PassRating" selected="@(Model.RangeBy == "PassRating")">Pass</option>
            <option value="AccRating" selected="@(Model.RangeBy == "AccRating")">Acc</option>
            <option value="TechRating" selected="@(Model.RangeBy == "TechRating")">Tech</option>
        </select>
        <span class="text-muted small">from</span>
        <input type="number" name="RangeMin" class="form-control form-control-sm lb-range-input" step="0.01" min="0" value="@RangeValue(Model.RangeMin)" placeholder="min" onchange="this.form.submit()" />
        <span class="text-muted small">to</span>
        <input type="number" name="RangeMax" class="form-control form-control-sm lb-range-input" step="0.01" min="0" value="@RangeValue(Model.RangeMax)" placeholder="max" onchange="this.form.submit()" />
    </div>
    @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.ModeName) || Model.HasRange || Model.Tag != null)
    {
        <a asp-page="./Leaderboards" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" asp-route-modifier="@Model.Modifier" asp-route-db="@Model.SelectedDatabase" class="btn btn-sm btn-outline-secondary">Clear</a>
    }
</form>

<table class="table table-sm table-hover align-middle lb-table">
    <thead>
        <tr>
            <th class="lb-cover-col"></th>
            <th>Map</th>
            <th>Difficulty</th>
            <th>Tags</th>
            @SortHeader("Stars", "Stars", "Star rating")
            @SortHeader("PassRating", "Pass", "Pass rating")
            @SortHeader("AccRating", "Acc", "Acc rating")
            @SortHeader("TechRating", "Tech", "Tech rating")
            @SortHeader("NoteCount", "Notes", "Color notes in the difficulty")
            @SortHeader("Worth", Model.Modifier == null ? "Worth" : $"Worth ({Model.Modifier})", "How much the map pays its players compared with maps of the same stars: for the same players, how much more or less they get here than on their other maps at their level (+4% = 4% more). The balance tuner and the acc reweighter use this measure. Blank with too few scores. With a speed modifier, that of the scores with it.")
            @SortHeader("WorthMean", "Mean", WorthQuantileTitle("the mean of"))
            @SortHeader("WorthMedian", "Median", WorthQuantileTitle("the median of"))
            @SortHeader("WorthP75", "P75", WorthQuantileTitle("the 75th percentile of"))
            @SortHeader("WorthP90", "P90", WorthQuantileTitle("the 90th percentile of"))
            @SortHeader("WorthSpread", "Spread", "How much Mean, Median, P75 and P90 disagree: the highest minus the lowest, in points (5.0 = 5 points apart). Highlighted from 5 points (about the top 5% of maps). Blank when any of them is.")
            @SortHeader("TopPlayShare", "Top play share", FormattableString.Invariant($"Of the map's players with {portaBLe.Refresh.AccReweighter.TopPlayShareMinScores}+ ranked plays, those whose best play it is by {portaBLe.Refresh.AccReweighter.TopPlayMarginPp:0.#}pp or more over their second best (any modifier), and that share over the median of the maps within {portaBLe.Refresh.AccReweighter.TopPlayShareBandwidth:0.#} star (sorted by it). The acc reweighter cuts maps past x{portaBLe.Refresh.AccReweighter.TopPlayShareRatio:0.#}. Blank with fewer than {portaBLe.Refresh.AccReweighter.TopPlayShareMinPlayers} such players."))
        </tr>
    </thead>
    <tbody>
        @foreach (var leaderboard in Model.Leaderboards)
        {
            <tr>
                <td class="lb-cover-col"><img class="lb-cover" src="@leaderboard.Cover" alt="" loading="lazy" /></td>
                <td>
                    <a class="lb-name" asp-page="/Leaderboard" asp-route-id="@leaderboard.Id" asp-route-modifier="@Model.LeaderboardPageModifier" asp-route-db="@Model.SelectedDatabase">@leaderboard.Name</a>
                    <div class="lb-mapper">@leaderboard.Mapper</div>
                </td>
                <td>
                    <span class="lb-diff lb-diff-@(leaderboard.DifficultyName?.ToLowerInvariant())">@DifficultyLabel(leaderboard.DifficultyName)</span>
                    @if (leaderboard.ModeName != "Standard")
                    {
                        <span class="lb-mode-badge">@leaderboard.ModeName</span>
                    }
                </td>
                <td class="lb-tags">@MapTags.Badges(leaderboard)</td>
                <td class="lb-num lb-stars">@leaderboard.Stars.ToString("0.00") ★</td>
                <td class="lb-num">@leaderboard.PassRating.ToString("0.00")</td>
                <td class="lb-num">@leaderboard.AccRating.ToString("0.00")</td>
                <td class="lb-num">@leaderboard.TechRating.ToString("0.00")</td>
                <td class="lb-num">@(leaderboard.NoteCount > 0 ? leaderboard.NoteCount.ToString() : "—")</td>
                <td class="lb-num"><span class="lb-worth @WorthClass(leaderboard.Worth)">@WorthText(leaderboard.Worth)</span></td>
                <td class="lb-num"><span class="lb-worth @WorthClass(leaderboard.WorthMean)">@WorthText(leaderboard.WorthMean)</span></td>
                <td class="lb-num"><span class="lb-worth @WorthClass(leaderboard.WorthMedian)">@WorthText(leaderboard.WorthMedian)</span></td>
                <td class="lb-num"><span class="lb-worth @WorthClass(leaderboard.WorthP75)">@WorthText(leaderboard.WorthP75)</span></td>
                <td class="lb-num"><span class="lb-worth @WorthClass(leaderboard.WorthP90)">@WorthText(leaderboard.WorthP90)</span></td>
                <td class="lb-num"><span class="lb-worth @SpreadClass(leaderboard.WorthSpread)">@SpreadText(leaderboard.WorthSpread)</span></td>
                <td class="lb-num"><span class="lb-worth @TopShareClass(leaderboard.TopPlayShareRelative)">@TopShareText(leaderboard.TopPlayShare, leaderboard.TopPlayShareRelative)</span></td>
            </tr>
        }
        @if (Model.Leaderboards.Count == 0)
        {
            <tr><td colspan="16" class="text-center text-muted py-4">No maps found</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    int firstPageToShow = Math.Max(1, Model.CurrentPage - 4);
    int lastPageToShow = Math.Min(Model.TotalPages, firstPageToShow + 8);
    firstPageToShow = Math.Max(1, lastPageToShow - 8);
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">@PageLink(1, "«")</li>
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">@PageLink(Math.Max(1, Model.CurrentPage - 1), "‹")</li>
            @for (int i = firstPageToShow; i <= lastPageToShow; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">@PageLink(i, i.ToString())</li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">@PageLink(Math.Min(Model.TotalPages, Model.CurrentPage + 1), "›")</li>
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">@PageLink(Model.TotalPages, "»")</li>
        </ul>
    </nav>
}

@functions {
    static string WorthText(float? worth) => worth is float w ? w.ToString("+0.0%;-0.0%;0.0%", System.Globalization.CultureInfo.InvariantCulture) : "—";

    // 8% or more above / below what maps of its stars average: about the outer 7-8% of maps each side
    static string WorthClass(float? worth) => worth is float w ? (w >= 0.08f ? "worth-high" : w <= -0.08f ? "worth-low" : "worth-even") : "worth-none";

    // Tooltip of the worth by quantile columns (Leaderboard.WorthMean ...)
    static string WorthQuantileTitle(string center) => $"Worth (as the Worth column) with each player's level, map's pay and distance term fitted to {center} the scores' residuals instead of the setting the balance tuner uses. Higher percentiles follow each player's best efforts on the map, so low effort scores count less. Nomod only: blank with a speed modifier. Blank with too few scores.";

    // Disagreement of the worth by quantile columns, in points; highlighted from 5 (about the top 5% of maps)
    static string SpreadText(float? spread) => spread is float s ? (s * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "—";
    static string SpreadClass(float? spread) => spread is float s ? (s >= 0.05f ? "worth-high" : "worth-even") : "worth-none";

    // The top play share and that over the maps of its stars'; highlighted past the acc reweighter's cut (TopPlayShareRatio)
    static string TopShareText(float? share, float? relative) => share is float s && relative is float r ? FormattableString.Invariant($"{s * 100:0.0}% (x{r:0.0})") : "—";
    static string TopShareClass(float? relative) => relative is float r ? (r > portaBLe.Refresh.AccReweighter.TopPlayShareRatio ? "worth-high" : "worth-even") : "worth-none";

    // Invariant so the number input and the query string read it back the same in any culture; null when empty
    static string? RangeValue(float? value) => value?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // The range type in links only when a range is set (keeps the default URLs short)
    private string? RangeByRoute() => Model.HasRange ? Model.RangeBy : null;

    static string DifficultyLabel(string? difficulty) => difficulty == "ExpertPlus" ? "Expert+" : difficulty ?? "";

    // Clicking the current sort column flips the order; another column starts descending
    private Microsoft.AspNetCore.Html.IHtmlContent SortHeader(string sortBy, string label, string title)
    {
        bool active = (Model.SortBy ?? "Stars") == sortBy;
        bool descending = active ? !Model.SortDescending : true;
        string arrow = active ? (Model.SortDescending ? " ▼" : " ▲") : "";
        string url = Url.Page("./Leaderboards", new { sortBy, sortDescending = descending, searchString = Model.SearchString, modeName = Model.ModeName, rangeBy = RangeByRoute(), rangeMin = RangeValue(Model.RangeMin), rangeMax = RangeValue(Model.RangeMax), modifier = Model.Modifier, tag = Model.Tag, db = Model.SelectedDatabase })!;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<th class=\"lb-num\" title=\"{System.Net.WebUtility.HtmlEncode(title)}\"><a class=\"lb-sort{(active ? " active" : "")}\" href=\"{url}\">{label}{arrow}</a></th>");
    }

    private Microsoft.AspNetCore.Html.IHtmlContent PageLink(int page, string label)
    {
        string url = Url.Page("./Leaderboards", new { currentPage = page, sortBy = Model.SortBy, sortDescending = Model.SortDescending, searchString = Model.SearchString, modeName = Model.ModeName, rangeBy = RangeByRoute(), rangeMin = RangeValue(Model.RangeMin), rangeMax = RangeValue(Model.RangeMax), modifier = Model.Modifier, tag = Model.Tag, db = Model.SelectedDatabase })!;
        return new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"page-link\" href=\"{url}\">{label}</a>");
    }
}

<style>
    .lb-header {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }

    .lb-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        margin: 0.5rem 0 1rem;
    }

    .lb-search {
        width: 18rem;
    }

    .lb-mode {
        width: auto;
    }

    .lb-range {
        display: flex;
        gap: 0.4rem;
        align-items: center;
    }

    .lb-range-input {
        width: 5.5rem;
    }

    .lb-table th {
        font-weight: 600;
        font-size: 0.85rem;
        color: #555;
        border-bottom-width: 2px;
        white-space: nowrap;
    }

    .lb-cover-col {
        width: 3.5rem;
    }

    .lb-cover {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.3rem;
        object-fit: cover;
    }

    .lb-name {
        font-weight: 600;
        text-decoration: none;
    }

    .lb-name:hover {
        text-decoration: underline;
    }

    .lb-mapper {
        font-size: 0.8rem;
        color: #777;
    }

    .lb-num {
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .lb-stars {
        font-weight: 600;
    }

    .lb-sort {
        color: inherit;
        text-decoration: none;
    }

    .lb-sort:hover, .lb-sort.active {
        color: #0d6efd;
    }

    .lb-diff {
        display: inline-block;
        padding: 0.1rem 0.45rem;
        border-radius: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #fff;
        background: #6c757d;
    }

    .lb-diff-easy { background: #3cb371; }
    .lb-diff-normal { background: #59b0f4; }
    .lb-diff-hard { background: #ff6347; }
    .lb-diff-expert { background: #bf2a42; }
    .lb-diff-expertplus { background: #8f48db; }

    .lb-tags {
        white-space: nowrap;
    }

    .lb-mode-badge {
        display: inline-block;
        margin-left: 0.25rem;
        padding: 0.1rem 0.4rem;
        border-radius: 0.3rem;
        font-size: 0.7rem;
        border: 1px solid #ccc;
        color: #555;
    }

    .lb-worth {
        display: inline-block;
        min-width: 3.4rem;
        padding: 0.1rem 0.4rem;
        border-radius: 0.3rem;
        text-align: center;
        font-weight: 600;
    }

    .worth-high { background: #fde2e1; color: #b02a37; }
    .worth-low { background: #dde9f8; color: #1f5fa8; }
    .worth-even { color: #555; }
    .worth-none { color: #aaa; }
</style>

@section Scripts {
    <script>
        // Search as you type (after a short pause), back to page 1
        const searchInput = document.getElementById('searchString');
        if (searchInput) {
            let timeout;
            searchInput.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => searchInput.form.submit(), 500);
            });
        }
    </script>
}
