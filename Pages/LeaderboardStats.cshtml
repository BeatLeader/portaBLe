@page
@model LeaderboardStatsModel

<h2>Leaderboard Statistics</h2>

<form method="get" id="leaderboardStatsForm">
    @if (!string.IsNullOrEmpty(Model.SelectedDatabase))
    {
        <input type="hidden" name="db" value="@Model.SelectedDatabase" />
    }
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="searchString" class="form-label">Search:</label>
            <input type="text" name="SearchString" id="searchString" value="@Model.SearchString" placeholder="Search leaderboards" class="form-control" />
        </div>
        <div class="col-md-4">
            <label for="modeName" class="form-label">Characteristic:</label>
            <select name="ModeName" id="modeName" class="form-control" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var mode in Model.ModeNames)
                {
                    <option value="@mode" selected="@(Model.ModeName == mode)">@mode</option>
                }
            </select>
        </div>
        @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.ModeName))
        {
            <div class="col-md-2 d-flex align-items-end">
                <a asp-page="./LeaderboardStats" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" asp-route-view="@Model.View" asp-route-db="@Model.SelectedDatabase" class="btn btn-secondary">Clear Filters</a>
            </div>
        }
    </div>
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDescending" value="@Model.SortDescending" />
    <input type="hidden" name="view" value="@Model.View" />
</form>

@* Columns are grouped in views; the sorted column always shows *@
<ul class="nav nav-tabs mb-2">
    @foreach (var (key, label) in LeaderboardStatsModel.Views)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.View == key ? "active" : "")" href="@Url.Page("./LeaderboardStats", new { view = key, sortBy = Model.SortBy, sortDescending = Model.SortDescending, searchString = Model.SearchString, modeName = Model.ModeName, db = Model.SelectedDatabase })">@label</a>
        </li>
    }
</ul>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle stats-table">
        <thead>
            <tr>
                <th class="lb-name">@SortHeader("Name", "Name", "Map name")</th>
                @foreach (var column in Model.ShownColumns)
                {
                    <th class="text-end">@SortHeader(column.Key, column.Label, column.Tooltip)</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var stat in Model.LeaderboardStats)
            {
                <tr>
                    <td class="lb-name">
                        <a asp-page="/Leaderboard" asp-route-id="@stat.Id" asp-route-db="@Model.SelectedDatabase">@stat.Name</a>
                        <span class="text-muted small">@(stat.DifficultyName == "ExpertPlus" ? "Expert+" : stat.DifficultyName)@(stat.ModeName != "Standard" ? $" · {stat.ModeName}" : "")</span>
                    </td>
                    @foreach (var column in Model.ShownColumns)
                    {
                        <td class="text-end stats-num"><span class="@HighlightClass(column, stat)">@column.Format(stat)</span></td>
                    }
                </tr>
            }
            @if (Model.LeaderboardStats.Count == 0)
            {
                <tr><td colspan="@(Model.ShownColumns.Count + 1)" class="text-center text-muted py-4">No maps found</td></tr>
            }
        </tbody>
    </table>
</div>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @{
            int firstPageToShow = Model.CurrentPage - 5;
            int lastPageToShow = Model.CurrentPage + 4;
            if (firstPageToShow < 1)
            {
                firstPageToShow = 1;
                lastPageToShow = 10;
            }
            if (lastPageToShow > Model.TotalPages)
            {
                lastPageToShow = Model.TotalPages;
                firstPageToShow = Model.TotalPages - 9 > 1 ? Model.TotalPages - 9 : 1;
            }

            for (int i = firstPageToShow; i <= lastPageToShow; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Page("./LeaderboardStats", new { currentPage = i, sortBy = Model.SortBy, sortDescending = Model.SortDescending, view = Model.View, searchString = Model.SearchString, modeName = Model.ModeName, db = Model.SelectedDatabase })">@i</a>
                </li>
            }
        }
    </ul>
</nav>

@functions {
    // Clicking the current sort column flips the order; another column starts descending
    private Microsoft.AspNetCore.Html.IHtmlContent SortHeader(string sortBy, string label, string tooltip)
    {
        bool active = Model.SortBy == sortBy;
        bool descending = active ? !Model.SortDescending : true;
        string url = Url.Page("./LeaderboardStats", new { sortBy, sortDescending = descending, view = Model.View, searchString = Model.SearchString, modeName = Model.ModeName, db = Model.SelectedDatabase })!;
        string classes = "sort-header" + (active ? " active " + (Model.SortDescending ? "desc" : "asc") : "");
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a class=\"{classes}\" href=\"{url}\" title=\"{System.Net.WebUtility.HtmlEncode(tooltip)}\">{System.Net.WebUtility.HtmlEncode(label)}</a>");
    }

    // Worth columns: 8% or more above / below what maps of their stars average
    private static string HighlightClass(LeaderboardStatsModel.StatColumn column, portaBLe.DB.Leaderboard stat) =>
        column.Highlight?.Invoke(stat) is float w ? (w >= 0.08f ? "worth worth-high" : w <= -0.08f ? "worth worth-low" : "worth") : "";
}

<style>
    .stats-table th {
        font-weight: 600;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .stats-num {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .sort-header {
        position: relative;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

        .sort-header:hover, .sort-header.active {
            color: #0d6efd;
            text-decoration: none;
        }

        .sort-header.active::after {
            content: '';
            display: inline-block;
            width: 0;
            height: 0;
            margin-left: 6px;
            vertical-align: middle;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
        }

        .sort-header.active.desc::after {
            border-top: 8px solid #0d6efd;
            border-bottom: 0;
        }

        .sort-header.active.asc::after {
            border-bottom: 8px solid #0d6efd;
            border-top: 0;
        }

    .lb-name {
        min-width: 16em;
    }

    .worth {
        display: inline-block;
        min-width: 3.8rem;
        padding: 0.1rem 0.4rem;
        border-radius: 0.3rem;
        text-align: center;
    }

    .worth-high { background: #fde2e1; color: #b02a37; }
    .worth-low { background: #dde9f8; color: #1f5fa8; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchString');
        const form = document.getElementById('leaderboardStatsForm');
        let debounceTimer;

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() {
                form.submit();
            }, 500);
        });
    });
</script>
