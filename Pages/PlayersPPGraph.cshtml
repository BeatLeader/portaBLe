@page
@model portaBLe.Pages.PlayersPPGraphModel
@{
    ViewData["Title"] = "Players Triangle Graph";
}

<h2>@ViewData["Title"]</h2>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="maxPlayerRank">Max Player Rank</label>
                                <input id="maxPlayerRank" type="number" class="form-control" value="@Model.MaxPlayerRank" placeholder="0 = unfiltered" />
                                <small class="form-text text-muted">0 = unfiltered</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="minRankedPlayCount">Min Ranked Play Count</label>
                                <input id="minRankedPlayCount" type="number" class="form-control" value="@Model.MinRankedPlayCount" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="playerId">Player ID (optional)</label>
                                <input id="playerId" type="text" class="form-control" value="@Model.PlayerId" placeholder="Enter player ID" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="colorSelect">Color by:</label>
                                <select id="colorSelect" class="form-control">
                                    <option value="AccPP">AccPP</option>
                                    <option value="TechPP">TechPP</option>
                                    <option value="PassPP">PassPP</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button id="applyFilters" class="btn btn-primary">Apply Filters</button>
                            <div id="spinner" class="spinner-border spinner-border-sm ml-2" role="status" style="display:none;"></div>
                            <small id="status" class="text-muted ms-2"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">3D Player Distribution</h5>
                    <small class="text-muted">Interactive 3D scatter plot of AccPP, TechPP, and PassPP</small>
                </div>
                <div class="card-body">
                    <div id="noDataMessage" style="display:none; text-align:center; padding:50px; color:gray; font-size:16px;">
                        Click "Apply Filters" to load data
                    </div>
                    <div id="myPlot" style="width:100%;height:600px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.plot.ly/plotly-2.29.1.min.js"></script>
    <script type="text/javascript">
        // Columns from ?handler=Data: { count, id: [], name: [], accPP: [], techPP: [], passPP: [] }
        let players = null;
        const statusEl = document.getElementById('status');
        const COLORS = {
            AccPP: { field: 'accPP', scale: 'Viridis' },
            TechPP: { field: 'techPP', scale: 'Cividis' },
            PassPP: { field: 'passPP', scale: 'Plasma' },
        };

        function renderPlot(d, colorVariable) {
            const noDataMsg = document.getElementById('noDataMessage');
            const plotDiv = document.getElementById('myPlot');
            if (!d || !d.count) {
                noDataMsg.textContent = d ? 'No players match these filters' : 'Loading…';
                noDataMsg.style.display = 'block';
                plotDiv.style.display = 'none';
                return;
            }
            noDataMsg.style.display = 'none';
            plotDiv.style.display = 'block';

            const color = COLORS[colorVariable] || COLORS.AccPP;
            const colorValues = d[color.field];
            // A loop, not Math.max(...values): spreading 100k+ values overflows the call stack
            let maxColor = 0;
            for (const v of colorValues) if (v > maxColor) maxColor = v;

            const text = new Array(d.count);
            for (let i = 0; i < d.count; i++) text[i] = `${d.name[i]} (${d.id[i]})`;

            const trace = {
                type: 'scatter3d',
                mode: 'markers',
                x: d.accPP,
                y: d.techPP,
                z: d.passPP,
                text,
                hovertemplate: 'Player: %{text}<br>AccPP: %{x:.1f}<br>TechPP: %{y:.1f}<br>PassPP: %{z:.1f}<extra></extra>',
                marker: {
                    size: d.count > 20000 ? 2 : d.count > 2000 ? 3 : 5,
                    color: colorValues,
                    colorscale: color.scale,
                    cmin: 0,
                    cmax: maxColor || 1,
                    colorbar: { title: colorVariable },
                    opacity: 0.8,
                },
            };
            const layout = {
                scene: {
                    xaxis: { title: 'AccPP' },
                    yaxis: { title: 'TechPP' },
                    zaxis: { title: 'PassPP' },
                },
                margin: { t: 10, b: 10, l: 10, r: 10 },
            };
            Plotly.react('myPlot', [trace], layout, { displayModeBar: true, responsive: true });
        }

        // Color selection from the URL, else the last one used
        function loadColorSelection() {
            let saved = null;
            try { saved = localStorage.getItem('playersPPGraph_colorBy'); } catch { }
            const colorToUse = new URLSearchParams(window.location.search).get('colorBy') || saved || 'AccPP';
            document.getElementById('colorSelect').value = COLORS[colorToUse] ? colorToUse : 'AccPP';
            return document.getElementById('colorSelect').value;
        }

        function saveColorSelection(colorBy) {
            try { localStorage.setItem('playersPPGraph_colorBy', colorBy); } catch { }
            const pageUrl = new URL(window.location.href);
            pageUrl.searchParams.set('colorBy', colorBy);
            window.history.replaceState({}, '', pageUrl);
        }

        document.getElementById('colorSelect').addEventListener('change', function () {
            saveColorSelection(this.value);
            renderPlot(players, this.value);
        });

        function showSpinner(show) {
            document.getElementById('spinner').style.display = show ? 'inline-block' : 'none';
        }

        async function fetchFiltered() {
            const maxPlayerRank = parseInt(document.getElementById('maxPlayerRank').value) || 0;
            const minRankedPlayCount = parseInt(document.getElementById('minRankedPlayCount').value) || 0;
            const playerId = (document.getElementById('playerId').value || '').trim();
            const colorBy = document.getElementById('colorSelect').value || 'AccPP';

            // Keep the filters in the URL so they persist when switching databases
            const pageUrl = new URL(window.location.href);
            pageUrl.searchParams.set('maxPlayerRank', maxPlayerRank);
            pageUrl.searchParams.set('minRankedPlayCount', minRankedPlayCount);
            pageUrl.searchParams.set('playerId', playerId);
            pageUrl.searchParams.set('colorBy', colorBy);
            window.history.replaceState({}, '', pageUrl);

            const url = new URL(window.location.href);
            url.pathname = url.pathname.replace(/\/$/, '');
            const dbParam = url.searchParams.get('db');
            url.search = '';
            url.searchParams.set('handler', 'Data');
            url.searchParams.set('maxPlayerRank', maxPlayerRank);
            url.searchParams.set('minRankedPlayCount', minRankedPlayCount);
            url.searchParams.set('playerId', playerId);
            if (dbParam) url.searchParams.set('db', dbParam);

            showSpinner(true);
            statusEl.textContent = '';
            try {
                const resp = await fetch(url.toString(), { headers: { 'Accept': 'application/json' } });
                if (!resp.ok) {
                    statusEl.textContent = `Could not load the players (${resp.status}).`;
                    return;
                }
                players = await resp.json();
                statusEl.textContent = `${players.count.toLocaleString()} players`;
                renderPlot(players, colorBy);
            } catch (error) {
                statusEl.textContent = 'Could not load the players.';
                console.error('Error fetching filtered data:', error);
            } finally {
                showSpinner(false);
            }
        }

        document.getElementById('applyFilters').addEventListener('click', fetchFiltered);

        // Load straight away with the filters shown (from the URL, else the defaults)
        loadColorSelection();
        renderPlot(null);
        fetchFiltered();
    </script>
}