{
  "RepoUrl": "https://github.com/BeatLeader/portaBLe.git",
  "RepoWebUrl": "https://github.com/BeatLeader/portaBLe",
  "ProjectFile": "portaBLe.csproj",
  "DbKeyFile": "wwwroot/current_db_name.txt",

  "Zone": "beatleader.pro",
  "HubHost": "portable.beatleader.pro",
  "HostPattern": "portable-{name}.beatleader.pro",
  "PublicIp": "203.0.113.10",
  "CloudflareTokenFile": "/etc/portable-hub/cloudflare.token",
  "GitHubWebhookSecret": "random hex, generated by setup.sh",

  "DataDir": "/srv/portable",
  "NginxDir": "/etc/portable-hub/maps",
  "FirstPort": 5101,
  "PollSeconds": 60,
  "KeepReleases": 2,
  "HealthTimeoutSeconds": 180,
  "MemoryMax": "1500M",

  "S3": {
    "Bucket": "portabledbs",
    "Region": "us-east-1",
    "AccessKey": "same keys portaBLe uses (Program.GetS3Client)",
    "SecretKey": "..."
  }
}
