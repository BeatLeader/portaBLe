<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Analyzer\**" />
    <Compile Remove="beatleader-analyzer\**" />
    <Compile Remove="beatleader-parser\**" />
    <Compile Remove="maps\**" />
    <Compile Remove="Parser\**" />
    <Compile Remove="ppCurve\**" />
    <Compile Remove="RatingAPI\**" />
    <Content Remove="Analyzer\**" />
    <Content Remove="beatleader-analyzer\**" />
    <Content Remove="beatleader-parser\**" />
    <Content Remove="maps\**" />
    <Content Remove="Parser\**" />
    <Content Remove="ppCurve\**" />
    <Content Remove="RatingAPI\**" />
    <EmbeddedResource Remove="Analyzer\**" />
    <EmbeddedResource Remove="beatleader-analyzer\**" />
    <EmbeddedResource Remove="beatleader-parser\**" />
    <EmbeddedResource Remove="maps\**" />
    <EmbeddedResource Remove="Parser\**" />
    <EmbeddedResource Remove="ppCurve\**" />
    <EmbeddedResource Remove="RatingAPI\**" />
    <None Remove="Analyzer\**" />
    <None Remove="beatleader-analyzer\**" />
    <None Remove="beatleader-parser\**" />
    <None Remove="maps\**" />
    <None Remove="Parser\**" />
    <None Remove="ppCurve\**" />
    <None Remove="RatingAPI\**" />
  </ItemGroup>

  <!-- Databases and their Top Scores caches stay out of the project and of publish: they're downloaded from S3 at startup
       (databases.json). The site reads them from wwwroot on disk, which doesn't depend on these items. -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*.db" />
    <None Remove="wwwroot\**\*.db" />
    <Content Remove="wwwroot\cache\**" />
    <None Remove="wwwroot\cache\**" />
    <Content Remove="wwwroot\dump.zip" />
    <Content Remove="wwwroot\export.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncEnumerator" Version="4.0.2" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.310.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="7.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="7.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Design" Version="1.1.6" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="Z.EntityFramework.Extensions.EFCore" Version="7.105.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RatingAPI\RatingAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="SongRec\Assets\playlist-cover.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
