<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ReplayStudy = SwingCorpus + (random map order, stratified skill sampling, per-note observation table,
    physical tip-motion metrics, extra analyzer swing columns). Built by Analysis/scripts/build_tools.sh.
    Props: AnalyzerDir, ParserDir, ReplayDecoderDir (folder with ReplayDecoder.csproj)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ReplayStudy</RootNamespace>
    <NoWarn>$(NoWarn);CS8632;CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219;CS8619;CS8620</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AnalyzerDir)\Analyzer.csproj" />
    <ProjectReference Include="$(ParserDir)\Parser.csproj" />
    <ProjectReference Include="$(ReplayDecoderDir)\ReplayDecoder.csproj" />
  </ItemGroup>

</Project>
